@model InventoryManagementSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5">
    <div class="card-d card-p-lg text-center" style="max-width:560px;width:100%">
        <div class="sc-icon ic-red mx-auto mb-3" style="width:64px;height:64px;font-size:32px">
            <i class="bi bi-exclamation-octagon-fill"></i>
        </div>

        <h2 style="font-weight:800;color:var(--danger);margin-bottom:8px">Oops! Something went wrong</h2>
        <p style="font-size:14px;color:var(--text-secondary);margin-bottom:20px;line-height:1.6">
            An unexpected error occurred while processing your request. Please try again or return to the dashboard.
        </p>

        @if (Model != null && !string.IsNullOrEmpty(Model.ExceptionMessage))
        {
            <div class="alert-d alert-danger text-start mb-4" style="word-break:break-word">
                <i class="bi bi-bug-fill me-2"></i>
                <div>
                    <strong>Error Detail:</strong>
                    <div style="font-size:12px;margin-top:4px">@Model.ExceptionMessage</div>
                </div>
            </div>
        }

        @if (Model != null && Model.ShowRequestId)
        {
            <div style="font-size:11px;color:var(--text-muted);margin-bottom:20px">
                Request ID: <span class="code-pill">@Model.RequestId</span>
            </div>
        }

        <div class="d-flex align-items-center justify-content-center gap-3">
            <a href="@Url.Action("Index","Home")" class="btn-d btn-primary">
                <i class="bi bi-house-door"></i> Go to Dashboard
            </a>
            <button type="button" class="btn-d btn-outline" onclick="window.history.back()">
                <i class="bi bi-arrow-left"></i> Go Back
            </button>
        </div>
    </div>
</div>
