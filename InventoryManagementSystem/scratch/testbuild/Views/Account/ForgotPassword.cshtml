@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password – SIMS</title>
  <link rel="icon" type="image/png" href="~/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <style>
    .auth-card {
      max-width: 440px;
      width: 100%;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 36px 32px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.4);
    }
    .auth-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }
    .auth-logo-name {
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 0.5px;
    }
    .auth-title {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 8px;
    }
    .auth-subtitle {
      font-size: 14px;
      color: #94a3b8;
      margin-bottom: 24px;
      line-height: 1.5;
    }
    .fg-label {
      font-size: 13px;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 6px;
      display: block;
    }
    .fg-icon-wrap {
      position: relative;
    }
    .fg-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 16px;
    }
    .fg-control {
      width: 100%;
      height: 46px;
      padding: 10px 14px 10px 42px;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .fg-control:focus {
      outline: none;
      border-color: #38bdf8;
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }
    .btn-submit {
      width: 100%;
      height: 46px;
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
      border: none;
      border-radius: 8px;
      color: #ffffff;
      font-weight: 600;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }
    .btn-submit:hover {
      opacity: 0.95;
      transform: translateY(-1px);
    }
    .info-pill {
      background: rgba(14, 165, 233, 0.1);
      border: 1px solid rgba(14, 165, 233, 0.3);
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 12.5px;
      color: #7dd3fc;
      margin-bottom: 20px;
      line-height: 1.45;
    }
  </style>
</head>
<body class="auth-page-body" style="background:#0F172A;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">

<div class="auth-card">
  <div class="auth-logo">
    <img src="~/images/logo.png" alt="SIMS Logo" class="auth-logo-img" style="width:42px;height:42px;border-radius:10px;object-fit:cover;flex-shrink:0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
    <div class="auth-logo-icon" style="display:none;width:42px;height:42px;background:#0284c7;border-radius:10px;align-items:center;justify-content:center;color:#fff;font-size:20px"><i class="bi bi-shield-lock-fill"></i></div>
    <span class="auth-logo-name">SIMS</span>
  </div>

  <h1 class="auth-title">Forgot Password</h1>
  <p class="auth-subtitle">Enter your registered email address. We will send a secure 6-digit OTP to verify and reset your account password.</p>

  @if (TempData["ToastMessage"] != null)
  {
    var toastType = TempData["ToastType"]?.ToString() == "success" ? "success" : "danger";
    <div class="alert alert-@toastType mb-4 py-2 px-3 small rounded-3" role="alert">
      <i class="bi bi-info-circle me-1"></i> @TempData["ToastMessage"]
    </div>
  }

  <div class="info-pill">
    <i class="bi bi-shield-check me-1"></i> Works for all registered <strong>Admin</strong>, <strong>Employee</strong>, and <strong>Distributor</strong> accounts.
  </div>

  <form asp-action="ForgotPassword" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-4">
      <label class="fg-label" asp-for="Email">Registered Email Address</label>
      <div class="fg-icon-wrap">
        <i class="bi bi-envelope fg-icon"></i>
        <input asp-for="Email" type="email" class="fg-control" placeholder="admin@example.com" required autocomplete="email" autofocus />
      </div>
      <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
    </div>

    <button type="submit" class="btn-submit mb-3">
      <i class="bi bi-send-fill me-2"></i> Send Verification OTP
    </button>

    <div class="text-center mt-3">
      <a href="@Url.Action("Login","Account")" style="font-size:13.5px;color:#94a3b8;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#94a3b8'">
        <i class="bi bi-arrow-left me-1"></i> Back to Sign In
      </a>
    </div>
  </form>
</div>

</body>
</html>
