@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Verify OTP & Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password – SIMS</title>
  <link rel="icon" type="image/png" href="~/favicon.png" />
  <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <style>
    .auth-card {
      max-width: 480px;
      width: 100%;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 16px;
      padding: 36px 32px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.4);
    }
    .auth-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
    }
    .auth-logo-name {
      font-size: 22px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: 0.5px;
    }
    .auth-title {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 6px;
    }
    .auth-subtitle {
      font-size: 13.5px;
      color: #94a3b8;
      margin-bottom: 22px;
      line-height: 1.5;
    }
    .fg-label {
      font-size: 13px;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 6px;
      display: block;
    }
    .fg-icon-wrap {
      position: relative;
    }
    .fg-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 16px;
    }
    .fg-toggle-pwd {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: #64748b;
      font-size: 16px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
    }
    .fg-toggle-pwd:hover {
      color: #38bdf8;
    }
    .fg-control {
      width: 100%;
      height: 46px;
      padding: 10px 14px 10px 42px;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .fg-control:focus {
      outline: none;
      border-color: #38bdf8;
      box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }
    .otp-input {
      font-family: 'JetBrains Mono', monospace;
      font-size: 24px !important;
      letter-spacing: 12px;
      text-align: center;
      font-weight: 700;
      padding-left: 18px !important;
      padding-right: 18px !important;
      color: #38bdf8 !important;
      background: #090d16 !important;
      border: 2px solid #0284c7 !important;
    }
    .otp-input:focus {
      border-color: #38bdf8 !important;
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.25) !important;
    }
    .btn-submit {
      width: 100%;
      height: 46px;
      background: linear-gradient(135deg, #0284c7 0%, #2563eb 100%);
      border: none;
      border-radius: 8px;
      color: #ffffff;
      font-weight: 600;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }
    .btn-submit:hover {
      opacity: 0.95;
      transform: translateY(-1px);
    }
    .badge-pwd-rule {
      font-size: 11.5px;
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.1);
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 600;
      border: 1px solid rgba(56, 189, 248, 0.25);
    }
    .resend-box {
      background: rgba(15, 23, 42, 0.6);
      border: 1px dashed #334155;
      border-radius: 8px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 18px;
      font-size: 13px;
      color: #94a3b8;
    }
    .btn-resend {
      background: none;
      border: none;
      color: #38bdf8;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      padding: 0;
      text-decoration: underline;
    }
    .btn-resend:hover {
      color: #7dd3fc;
    }
  </style>
</head>
<body class="auth-page-body" style="background:#0F172A;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">

<div class="auth-card">
  <div class="auth-logo">
    <img src="~/images/logo.png" alt="SIMS Logo" class="auth-logo-img" style="width:42px;height:42px;border-radius:10px;object-fit:cover;flex-shrink:0" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
    <div class="auth-logo-icon" style="display:none;width:42px;height:42px;background:#0284c7;border-radius:10px;align-items:center;justify-content:center;color:#fff;font-size:20px"><i class="bi bi-key-fill"></i></div>
    <span class="auth-logo-name">SIMS</span>
  </div>

  <h1 class="auth-title">Verify OTP & Reset</h1>
  <p class="auth-subtitle">Enter the 6-digit OTP sent to your registered email and choose a new password (min 8 characters).</p>

  @if (TempData["ToastMessage"] != null)
  {
    var toastType = TempData["ToastType"]?.ToString() == "success" ? "success" : (TempData["ToastType"]?.ToString() == "info" ? "info" : "danger");
    <div class="alert alert-@toastType mb-3 py-2 px-3 small rounded-3" role="alert">
      <i class="bi bi-info-circle me-1"></i> @TempData["ToastMessage"]
    </div>
  }

  <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2 px-3 small rounded-3" role="alert"></div>

  <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
    @Html.AntiForgeryToken()

    <!-- Registered Email Address -->
    <div class="mb-3">
      <label class="fg-label" asp-for="Email">Registered Email</label>
      <div class="fg-icon-wrap">
        <i class="bi bi-envelope fg-icon"></i>
        <input asp-for="Email" type="email" class="fg-control" placeholder="your-email@example.com" required autocomplete="email" />
      </div>
      <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
    </div>

    <!-- 6-digit OTP -->
    <div class="mb-3">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <label class="fg-label mb-0" asp-for="Otp">6-Digit Verification OTP</label>
        <span class="badge-pwd-rule"><i class="bi bi-clock-history me-1"></i>Valid 15 mins</span>
      </div>
      <input asp-for="Otp" type="text" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" class="fg-control otp-input" placeholder="······" required autofocus autocomplete="one-time-code" />
      <span asp-validation-for="Otp" class="text-danger small mt-1 d-block"></span>
    </div>

    <!-- New Password -->
    <div class="mb-3">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <label class="fg-label mb-0" asp-for="Password">New Password</label>
        <span class="badge-pwd-rule"><i class="bi bi-shield-lock me-1"></i>Min 8 characters</span>
      </div>
      <div class="fg-icon-wrap">
        <i class="bi bi-lock fg-icon"></i>
        <input asp-for="Password" type="password" id="newPasswordInput" class="fg-control" style="padding-right: 42px;" placeholder="At least 8 characters" minlength="8" required />
        <button type="button" class="fg-toggle-pwd" onclick="togglePasswordVisibility('newPasswordInput', 'pwdToggleIcon1')">
          <i class="bi bi-eye" id="pwdToggleIcon1"></i>
        </button>
      </div>
      <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
    </div>

    <!-- Confirm New Password -->
    <div class="mb-4">
      <label class="fg-label" asp-for="ConfirmPassword">Confirm New Password</label>
      <div class="fg-icon-wrap">
        <i class="bi bi-lock-fill fg-icon"></i>
        <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="fg-control" style="padding-right: 42px;" placeholder="Re-type new password" minlength="8" required />
        <button type="button" class="fg-toggle-pwd" onclick="togglePasswordVisibility('confirmPasswordInput', 'pwdToggleIcon2')">
          <i class="bi bi-eye" id="pwdToggleIcon2"></i>
        </button>
      </div>
      <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
    </div>

    <button type="submit" class="btn-submit mb-2">
      <i class="bi bi-check-circle-fill me-2"></i> Update Password
    </button>
  </form>

  <!-- Resend OTP Form -->
  <div class="resend-box">
    <span>Didn't receive or expired OTP?</span>
    <form asp-action="ResendOtp" method="post" style="display:inline;">
      @Html.AntiForgeryToken()
      <input type="hidden" name="email" value="@Model?.Email" id="resendEmailHidden" />
      <button type="submit" class="btn-resend" onclick="syncEmailForResend()">Resend OTP</button>
    </form>
  </div>

  <div class="text-center mt-4">
    <a href="@Url.Action("Login","Account")" style="font-size:13.5px;color:#94a3b8;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#94a3b8'">
      <i class="bi bi-arrow-left me-1"></i> Back to Sign In
    </a>
  </div>
</div>

<script>
  function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (!input || !icon) return;
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.remove('bi-eye');
      icon.classList.add('bi-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.remove('bi-eye-slash');
      icon.classList.add('bi-eye');
    }
  }

  function syncEmailForResend() {
    const emailInput = document.getElementById('Email');
    const resendEmail = document.getElementById('resendEmailHidden');
    if (emailInput && resendEmail) {
      resendEmail.value = emailInput.value.trim();
    }
  }

  // Filter OTP input to only allow numbers
  const otpInput = document.getElementById('Otp');
  if (otpInput) {
    otpInput.addEventListener('input', function() {
      this.value = this.value.replace(/[^0-9]/g, '');
    });
  }
</script>

</body>
</html>
