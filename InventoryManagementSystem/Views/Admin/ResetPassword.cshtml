@model User
@{
    ViewData["Title"] = "Reset Administrator Password";
}

<div class="ph">
    <div>
        <h1 class="ph-title">Reset Administrator Password</h1>
        <p class="ph-sub">Reset credentials for administrator <strong>@Model.FullName</strong> (<code>@@@Model.Username</code>).</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","Admin")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Administrator List
        </a>
    </div>
</div>

<form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card-d card-p-lg">
                <div class="s-title"><i class="bi bi-key me-2" style="color:var(--warning)"></i>New Security Password</div>

                <div class="fg">
                    <label class="fg-label">New Password <span class="req">*</span></label>
                    <input type="password" name="newPassword" class="fg-control" placeholder="Minimum 6 characters" required />
                </div>

                <div class="fg mb-4">
                    <label class="fg-label">Confirm New Password <span class="req">*</span></label>
                    <input type="password" name="confirmPassword" class="fg-control" placeholder="Re-enter password" required />
                </div>

                <hr class="s-divider" />
                <div class="d-flex align-items-center justify-content-end gap-2">
                    <a href="@Url.Action("Index","Admin")" class="btn-d btn-outline">Cancel</a>
                    <button type="submit" class="btn-d btn-primary" style="background:var(--warning);border-color:var(--warning);color:#000">
                        <i class="bi bi-shield-lock"></i> Update Password
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
