@model IEnumerable<User>
@{
    ViewData["Title"] = "Administrator Management";
}

<form id="anti-forgery-form" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-shield-lock text-primary me-2"></i>Administrator Management</h1>
        <p class="ph-sub">Manage system Super Administrators with full unrestricted access privileges.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Create","Admin")" class="btn-d btn-primary">
            <i class="bi bi-person-plus"></i> Add New Administrator
        </a>
    </div>
</div>

<!-- Collapsible Detailed Filter Panel -->
<div class="card-d mb-4">
    <!-- Filter Toggle Header -->
    <div class="card-p d-flex align-items-center justify-content-between flex-wrap gap-2"
         onclick="toggleFilterPanel()" style="cursor:pointer;user-select:none">
        <div class="d-flex align-items-center gap-2">
            <span class="badge-d badge-blue" style="font-size:14px;padding:6px 10px"><i class="bi bi-funnel-fill"></i></span>
            <div>
                <div style="font-size:14px;font-weight:700;color:var(--text-primary);display:flex;align-items:center;gap:6px">
                    Filter & Search Administrator Directory
                    <span id="active-filter-badge" class="badge-d badge-blue" style="display:none">Active Filters</span>
                </div>
                <div style="font-size:12px;color:var(--text-muted)">
                    Click to expand search keyword, account status, registration dates & sorting filters
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation()">
            <button type="button" id="btn-clear-filters" class="btn-d btn-ghost btn-sm-d" style="display:none" onclick="resetFilters()">
                <i class="bi bi-x-circle me-1"></i> Clear Filters
            </button>
            <button type="button" class="btn-d btn-outline btn-sm-d" onclick="toggleFilterPanel()">
                <i class="bi bi-sliders me-1"></i> <span id="filter-toggle-text">Show Filters</span>
                <i class="bi bi-chevron-down ms-1" id="filter-toggle-chevron"></i>
            </button>
        </div>
    </div>

    <!-- Collapsible Filter Form Body (Closed by default) -->
    <div id="filter-panel-body" class="card-p-lg border-top" style="display:none;border-color:var(--border)!important">
        <div class="row g-3">
            <!-- Keyword Search -->
            <div class="col-lg-4 col-md-6">
                <div class="fg mb-0">
                    <label class="fg-label" style="font-size:12px">Search Keyword</label>
                    <div class="fg-icon-wrap">
                        <i class="bi bi-search fg-icon"></i>
                        <input type="search" id="filterKeyword" class="fg-control" style="height:38px"
                               placeholder="Search name, ID, username, email, phone…" oninput="applyFilters()">
                    </div>
                </div>
            </div>

            <!-- Account Status Filter -->
            <div class="col-lg-3 col-md-6">
                <div class="fg mb-0">
                    <label class="fg-label" style="font-size:12px">Account Status</label>
                    <select id="filterStatus" class="fg-control" style="height:38px" onchange="applyFilters()">
                        <option value="">All Statuses</option>
                        <option value="Active">Active Accounts</option>
                        <option value="Locked">Locked / Deactivated</option>
                    </select>
                </div>
            </div>

            <!-- Registered From Date -->
            <div class="col-lg-2 col-md-6">
                <div class="fg mb-0">
                    <label class="fg-label" style="font-size:12px">Joined From Date</label>
                    <input type="date" id="filterStartDate" class="fg-control" style="height:38px" onchange="applyFilters()">
                </div>
            </div>

            <!-- Registered To Date -->
            <div class="col-lg-2 col-md-6">
                <div class="fg mb-0">
                    <label class="fg-label" style="font-size:12px">Joined To Date</label>
                    <input type="date" id="filterEndDate" class="fg-control" style="height:38px" onchange="applyFilters()">
                </div>
            </div>

            <!-- Sort Order -->
            <div class="col-lg-3 col-md-6">
                <div class="fg mb-0">
                    <label class="fg-label" style="font-size:12px">Sort Order</label>
                    <select id="filterSort" class="fg-control" style="height:38px" onchange="applyFilters()">
                        <option value="newest">Newest Joined First</option>
                        <option value="oldest">Oldest Joined First</option>
                        <option value="name_asc">Name (A to Z)</option>
                        <option value="name_desc">Name (Z to A)</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-end gap-2 mt-4 pt-3 border-top" style="border-color:var(--border)!important">
            <button type="button" class="btn-d btn-outline btn-sm-d" onclick="resetFilters()">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
            </button>
            <button type="button" class="btn-d btn-primary btn-sm-d" onclick="applyFilters()">
                <i class="bi bi-funnel me-1"></i> Apply Filters
            </button>
        </div>
    </div>
</div>

<!-- Bulk Actions Bar -->
<div id="bulk-action-bar" style="display:none;align-items:center;justify-content:space-between;background:var(--card-bg);border:1px solid var(--danger-dim);border-radius:var(--radius-md);padding:10px 16px;margin-bottom:16px">
    <div style="font-size:13px;font-weight:600;color:var(--text-primary)">
        <i class="bi bi-check2-square text-danger me-2"></i>
        <span id="selected-count">0</span> administrator accounts selected
    </div>
    <button type="button" class="btn-d btn-danger btn-sm-d" onclick="executeBulkDelete()">
        <i class="bi bi-trash me-1"></i> Delete Selected Administrators
    </button>
</div>

<!-- Table Card -->
<div class="card-d">
    <div class="card-p d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div style="font-size:14px;font-weight:700;color:var(--text-primary)">
            Administrator Directory (<span id="display-count" style="color:var(--primary-text)">@(Model?.Count() ?? 0)</span>)
        </div>
    </div>

    <div class="tbl-scroll">
        <table class="tbl" id="admin-table">
            <thead>
                <tr>
                    <th style="width:36px;text-align:center">
                        <input type="checkbox" id="select-all" onclick="toggleSelectAll(this)">
                    </th>
                    <th style="width:50px">Avatar</th>
                    <th>Admin ID</th>
                    <th>Administrator Name</th>
                    <th>Username</th>
                    <th>Privileges</th>
                    <th>Account Status</th>
                    <th>Registered Date</th>
                    <th class="col-actions" style="text-align:right">Actions</th>
                </tr>
            </thead>
            <tbody id="admin-tbody">
                @if (Model != null && Model.Any())
                {
                    @foreach (var u in Model)
                    {
                        var adminId = !string.IsNullOrEmpty(u.EmployeeId) ? u.EmployeeId : $"ADM-{u.Id[..Math.Min(6, u.Id.Length)]}";
                        var statusText = u.IsLocked ? "Locked" : "Active";
                        var createdIso = u.CreatedDate.ToString("yyyy-MM-dd");
                        var isSelf = u.Username.Equals(User.Identity?.Name, StringComparison.OrdinalIgnoreCase);

                        <tr class="admin-row"
                            data-id="@u.Id"
                            data-name="@u.FullName"
                            data-status="@statusText"
                            data-date="@createdIso"
                            data-search="@u.FullName @adminId @u.Username @u.Email @u.PhoneNumber">
                            <td style="text-align:center">
                                @if (!isSelf)
                                {
                                    <input type="checkbox" class="admin-row-check" value="@u.Id" onchange="updateBulkState()">
                                }
                            </td>
                            <td>
                                <img src="@(string.IsNullOrEmpty(u.ProfilePictureUrl) ? "/images/default-avatar.png" : u.ProfilePictureUrl)"
                                     alt="Admin Avatar" class="prod-thumb" style="border-radius:50%">
                            </td>
                            <td>
                                <span class="code-pill" style="font-weight:700;color:var(--info)">@adminId</span>
                            </td>
                            <td>
                                <div class="td-strong">@u.FullName</div>
                                <div style="font-size:11px;color:var(--text-muted)">@u.Email @(!string.IsNullOrEmpty(u.PhoneNumber) ? $"• {u.PhoneNumber}" : "")</div>
                            </td>
                            <td>
                                <span class="code-pill">@@@u.Username</span>
                            </td>
                            <td>
                                <span class="badge-d badge-purple"><i class="bi bi-shield-check"></i> Super Admin</span>
                            </td>
                            <td>
                                @if (u.IsLocked)
                                {
                                    <span class="badge-d badge-red"><i class="bi bi-lock-fill"></i> Locked</span>
                                }
                                else
                                {
                                    <span class="badge-d badge-green"><i class="bi bi-check-circle-fill"></i> Active</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);font-size:12px;white-space:nowrap">
                                @u.CreatedDate.ToString("MMM d, yyyy")
                            </td>
                            <td class="col-actions">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <a href="@Url.Action("Edit","Admin",new{id=u.Id})"
                                       class="btn-d btn-ghost btn-sm-d" title="Edit Administrator Profile">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Activity","Admin",new{id=u.Id})"
                                       class="btn-d btn-outline btn-sm-d" title="View Audit Logs">
                                        <i class="bi bi-clock-history"></i> Logs
                                    </a>
                                    <a href="@Url.Action("ResetPassword","Admin",new{id=u.Id})"
                                       class="btn-d btn-ghost btn-icon-d" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    @if (!isSelf)
                                    {
                                        <form method="post" asp-action="ToggleLock" asp-route-id="@u.Id" style="margin:0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-d btn-ghost btn-icon-d"
                                                    style="color:@(u.IsLocked ? "var(--success)" : "var(--warning)")"
                                                    title="@(u.IsLocked ? "Unlock Account" : "Lock Account")">
                                                <i class="bi @(u.IsLocked ? "bi-check-circle" : "bi-slash-circle")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@u.Id" style="margin:0" onsubmit="return confirm('Are you sure you want to delete administrator @u.FullName (@adminId)?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-d btn-ghost btn-icon-d" style="color:var(--danger)"
                                                    title="Delete Administrator">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="empty-row">
                        <td colspan="9">
                            <div class="empty-s">
                                <i class="bi bi-shield-slash empty-s-icon"></i>
                                <div class="empty-s-title">No administrators registered</div>
                                <div class="empty-s-desc">Create Super Administrator accounts to delegate full management.</div>
                                <a href="@Url.Action("Create","Admin")" class="btn-d btn-primary btn-sm-d mt-3">
                                    <i class="bi bi-person-plus"></i> Add New Administrator
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function toggleFilterPanel() {
    const panel = document.getElementById('filter-panel-body');
    const text = document.getElementById('filter-toggle-text');
    const chevron = document.getElementById('filter-toggle-chevron');
    if (!panel) return;

    if (panel.style.display === 'none' || getComputedStyle(panel).display === 'none') {
        panel.style.display = 'block';
        if (text) text.textContent = 'Hide Filters';
        if (chevron) { chevron.className = 'bi bi-chevron-up ms-1'; }
    } else {
        panel.style.display = 'none';
        if (text) text.textContent = 'Show Filters';
        if (chevron) { chevron.className = 'bi bi-chevron-down ms-1'; }
    }
}

function applyFilters() {
    const keyword = (document.getElementById('filterKeyword').value || '').toLowerCase().trim();
    const status = document.getElementById('filterStatus').value;
    const startDate = document.getElementById('filterStartDate').value;
    const endDate = document.getElementById('filterEndDate').value;
    const sort = document.getElementById('filterSort').value;

    const tbody = document.getElementById('admin-tbody');
    const rows = Array.from(document.querySelectorAll('.admin-row'));

    let hasActive = !!(keyword || status || startDate || endDate);
    document.getElementById('active-filter-badge').style.display = hasActive ? 'inline-flex' : 'none';
    document.getElementById('btn-clear-filters').style.display = hasActive ? 'inline-flex' : 'none';

    let visibleRows = [];

    rows.forEach(row => {
        const searchData = (row.dataset.search || '').toLowerCase();
        const rowStatus = row.dataset.status;
        const rowDate = row.dataset.date;

        let matchesKeyword = !keyword || searchData.includes(keyword);
        let matchesStatus = !status || rowStatus === status;
        let matchesStart = !startDate || (rowDate >= startDate);
        let matchesEnd = !endDate || (rowDate <= endDate);

        if (matchesKeyword && matchesStatus && matchesStart && matchesEnd) {
            row.style.display = '';
            visibleRows.push(row);
        } else {
            row.style.display = 'none';
        }
    });

    // Sorting
    visibleRows.sort((a, b) => {
        if (sort === 'oldest') return a.dataset.date.localeCompare(b.dataset.date);
        if (sort === 'name_asc') return a.dataset.name.localeCompare(b.dataset.name);
        if (sort === 'name_desc') return b.dataset.name.localeCompare(a.dataset.name);
        return b.dataset.date.localeCompare(a.dataset.date); // newest
    });

    visibleRows.forEach(row => tbody.appendChild(row));
    document.getElementById('display-count').textContent = visibleRows.length;
}

function resetFilters() {
    document.getElementById('filterKeyword').value = '';
    document.getElementById('filterStatus').value = '';
    document.getElementById('filterStartDate').value = '';
    document.getElementById('filterEndDate').value = '';
    document.getElementById('filterSort').value = 'newest';
    applyFilters();
}

function toggleSelectAll(master) {
    const checkboxes = document.querySelectorAll('.admin-row-check');
    checkboxes.forEach(c => {
        if (c.closest('tr').style.display !== 'none') {
            c.checked = master.checked;
        }
    });
    updateBulkState();
}

function updateBulkState() {
    const checkboxes = Array.from(document.querySelectorAll('.admin-row-check'));
    const selected = checkboxes.filter(c => c.checked && c.closest('tr').style.display !== 'none');
    const bar = document.getElementById('bulk-action-bar');
    const countEl = document.getElementById('selected-count');
    const selectAll = document.getElementById('select-all');

    if (countEl) countEl.textContent = selected.length;
    if (bar) bar.style.display = selected.length > 0 ? 'flex' : 'none';
    if (selectAll) selectAll.checked = checkboxes.length > 0 && selected.length === checkboxes.length;
}

async function executeBulkDelete() {
    const selected = Array.from(document.querySelectorAll('.admin-row-check:checked')).map(c => c.value);
    if (selected.length === 0) return;

    if (!confirm(`Are you sure you want to delete ${selected.length} selected administrator account(s)? This action cannot be undone.`)) {
        return;
    }

    try {
        const tokenInput = document.querySelector('#anti-forgery-form input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch('/Admin/BulkDelete', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(selected)
        });

        const data = await response.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert(data.message || 'Failed to delete administrator accounts.');
        }
    } catch (err) {
        alert('An error occurred while deleting administrator accounts.');
    }
}
</script>
}
