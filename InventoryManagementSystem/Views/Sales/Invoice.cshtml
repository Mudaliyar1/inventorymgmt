@model Sale
@{
    ViewData["Title"] = "Tax Invoice - " + Model.InvoiceNumber;
    var settings = ViewBag.Settings as Settings ?? new Settings();
    var gstin = !string.IsNullOrEmpty(Model.CompanyGstin) ? Model.CompanyGstin : settings.GstinNumber;
    var companyName = !string.IsNullOrEmpty(settings.CompanyName) ? settings.CompanyName : "SMART INVENTORY SYSTEM";
}

<div class="ph d-print-none">
    <div>
        <h1 class="ph-title">Tax Invoice</h1>
        <p class="ph-sub">Invoice #@Model.InvoiceNumber for @Model.CustomerName</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","Sales")" class="btn-d btn-outline btn-sm-d">
            <i class="bi bi-arrow-left"></i> Invoices List
        </a>
        <a href="@Url.Action("Edit","Sales",new{id=Model.Id})" class="btn-d btn-outline btn-sm-d">
            <i class="bi bi-pencil-square"></i> Edit Bill
        </a>
        <button type="button" class="btn-d btn-outline btn-sm-d text-info" data-bs-toggle="modal" data-bs-target="#emailInvoiceModal">
            <i class="bi bi-envelope"></i> Email Invoice
        </button>
        <button onclick="window.print()" class="btn-d btn-outline btn-sm-d">
            <i class="bi bi-printer"></i> Print Invoice
        </button>
        <a href="@Url.Action("DownloadInvoice","Sales",new{id=Model.Id})" class="btn-d btn-primary btn-sm-d">
            <i class="bi bi-file-pdf"></i> Download PDF
        </a>
    </div>
</div>

<!-- Invoice Sheet -->
<div class="card-d card-p-lg text-light" id="print-area" style="background:#1E293B;max-width:850px;margin:0 auto">
    <!-- Header -->
    <div class="d-flex justify-content-between pb-4 mb-4 border-bottom" style="border-color:var(--border)!important">
        <div>
            <h3 style="font-weight:800;color:var(--primary);margin-bottom:4px">@companyName.ToUpper()</h3>
            <div style="font-size:12px;color:var(--text-muted)">@settings.Address</div>
            <div style="font-size:12px;color:var(--text-muted)">Phone: @settings.CompanyPhone · Email: @settings.CompanyEmail</div>
            <div style="font-size:12px;font-weight:700;color:var(--primary-text);margin-top:2px">Tax GSTIN: @gstin</div>
        </div>
        <div class="text-end">
            <h2 style="font-weight:800;color:var(--text-primary);margin-bottom:0">TAX INVOICE</h2>
            <div class="code-pill my-1">Invoice #: @Model.InvoiceNumber</div>
            <div style="font-size:12px;color:var(--text-muted)">Date: @Model.Date.ToIstString("MMM d, yyyy HH:mm IST")</div>
        </div>
    </div>

    <!-- Billed Details -->
    <div class="row mb-4">
        <div class="col-6">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;margin-bottom:4px">BILLED TO:</div>
            <h5 style="font-weight:700;color:var(--text-primary);margin-bottom:4px">@Model.CustomerName</h5>
            @if (!string.IsNullOrEmpty(Model.CustomerPhone))
            {
                <div style="font-size:12px;color:var(--text-secondary)">Phone: @Model.CustomerPhone</div>
            }
            @if (!string.IsNullOrEmpty(Model.CustomerEmail))
            {
                <div style="font-size:12px;color:var(--text-secondary)">Email: @Model.CustomerEmail</div>
            }
        </div>
        <div class="col-6 text-end">
            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;margin-bottom:4px">PAYMENT STATUS & CASHIER:</div>
            <div>
                @if (Model.PaymentStatus == "Paid")
                {
                    <span class="badge-d badge-green mb-1"><i class="bi bi-check-circle-fill me-1"></i> PAID</span>
                }
                else if (Model.PaymentStatus == "Partial")
                {
                    <span class="badge-d badge-amber mb-1"><i class="bi bi-exclamation-circle-fill me-1"></i> PARTIAL / DUE</span>
                }
                else if (Model.PaymentStatus == "Draft")
                {
                    <span class="badge-d badge-gray mb-1"><i class="bi bi-file-earmark me-1"></i> DRAFT</span>
                }
                else
                {
                    <span class="badge-d badge-red mb-1"><i class="bi bi-x-circle-fill me-1"></i> UNPAID</span>
                }
            </div>
            <div style="font-size:12px;color:var(--text-secondary);margin-top:4px">Billed By: @Model.CreatedBy</div>
        </div>
    </div>

    <!-- Table -->
    <div class="tbl-wrap mb-4" style="background:var(--bg)">
        <div class="tbl-scroll">
            <table class="tbl">
                <thead>
                    <tr>
                        <th style="width:45px">#</th>
                        <th>Item Description</th>
                        <th>SKU</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="color:var(--text-muted)">@i</td>
                            <td class="td-strong">
                                @item.ProductName
                                @if (!string.IsNullOrEmpty(item.IMEI1))
                                {
                                    <div style="font-size:11px;color:var(--primary-text);font-family:monospace;margin-top:2px">
                                        <i class="bi bi-upc-scan me-1"></i>IMEI 1: @item.IMEI1
                                        @if (!string.IsNullOrEmpty(item.IMEI2))
                                        {
                                            <span class="ms-2">| IMEI 2: @item.IMEI2</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td><span class="code-pill">@item.ProductCode</span></td>
                            <td class="text-end" style="color:var(--text-secondary)">₹@item.SellingPrice.ToString("F2")</td>
                            <td class="text-center" style="font-weight:600">@item.Quantity</td>
                            <td class="text-end td-strong">₹@item.Total.ToString("F2")</td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Summary -->
    <div class="row justify-content-end">
        <div class="col-md-6">
            <div class="d-flex justify-content-between mb-2">
                <span style="color:var(--text-secondary)">Sub-Total:</span>
                <span class="td-strong">₹@Model.SubTotal.ToString("N2")</span>
            </div>
            @if (Model.Discount > 0)
            {
                <div class="d-flex justify-content-between mb-2" style="color:var(--danger)">
                    <span>Discount:</span>
                    <span>-₹@Model.Discount.ToString("N2")</span>
                </div>
            }
            <div class="d-flex justify-content-between mb-2">
                <span style="color:var(--text-secondary)">GST (@Model.GstPercentage%):</span>
                <span class="td-strong">₹@Model.GstAmount.ToString("N2")</span>
            </div>
            <hr class="s-divider my-2" />
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span style="font-weight:700;color:var(--text-primary)">Grand Total:</span>
                <span style="font-size:20px;font-weight:800;color:var(--primary-text)">₹@Model.GrandTotal.ToString("N2")</span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2" style="color:var(--success)">
                <span style="font-weight:600">Amount Paid:</span>
                <span style="font-size:16px;font-weight:700">₹@Model.AmountPaid.ToString("N2")</span>
            </div>

            @if (Model.DueAmount > 0)
            {
                <div class="d-flex justify-content-between align-items-center p-2 rounded" style="background:var(--danger-dim);color:var(--danger)">
                    <span style="font-weight:700">Remaining Due Amount:</span>
                    <span style="font-size:18px;font-weight:800">₹@Model.DueAmount.ToString("N2")</span>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between align-items-center p-2 rounded" style="background:var(--success-dim);color:var(--success)">
                    <span style="font-weight:600"><i class="bi bi-check-circle me-1"></i> Balance Due:</span>
                    <span style="font-weight:700">₹0.00 (Fully Paid)</span>
                </div>
            }
        </div>
    </div>

    <div class="text-center border-top pt-4 mt-5" style="border-color:var(--border)!important">
        <p style="font-size:13px;color:var(--text-muted);margin-bottom:4px">Thank you for shopping with us!</p>
        <p style="font-size:11px;color:var(--text-disabled);margin:0">This is a computer-generated tax invoice and requires no physical signature. GSTIN: @gstin</p>
    </div>
</div>

<!-- Email Invoice Modal -->
<div class="modal fade" id="emailInvoiceModal" tabindex="-1" aria-labelledby="emailInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--card-bg, #1E293B);color:var(--text-primary);border:1px solid var(--border);">
            <div class="modal-header" style="border-bottom:1px solid var(--border);">
                <h5 class="modal-title" id="emailInvoiceModalLabel">
                    <i class="bi bi-envelope-paper me-2 text-primary"></i>Email Invoice #@Model.InvoiceNumber
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SendInvoiceEmail" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="modal-body">
                    <p style="font-size:13px;color:var(--text-muted)">
                        Send full bill breakdown and attached official tax invoice PDF directly to the customer's email address.
                    </p>
                    <div class="fg mb-3">
                        <label class="fg-label">Customer Recipient Email <span class="text-danger">*</span></label>
                        <div class="fg-prefix-wrap">
                            <span class="fg-prefix"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="email" value="@Model.CustomerEmail" required class="fg-control" placeholder="customer@example.com" />
                        </div>
                    </div>
                    <div class="p-2 rounded" style="background:rgba(37,99,235,0.08);border:1px solid rgba(37,99,235,0.2);font-size:12px;">
                        <i class="bi bi-paperclip me-1 text-primary"></i> Includes attached: <strong>Invoice_@(Model.InvoiceNumber).pdf</strong>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--border);">
                    <button type="button" class="btn-d btn-outline btn-sm-d" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-d btn-primary btn-sm-d">
                        <i class="bi bi-send me-1"></i> Send Invoice &amp; PDF
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    @@media print {
        body * { visibility: hidden; }
        #print-area, #print-area * { visibility: visible; }
        #print-area {
            position: absolute; left: 0; top: 0; width: 100%;
            border: none !important; box-shadow: none !important;
            padding: 0 !important; color: #000 !important; background: #fff !important;
        }
        #print-area * { color: #000 !important; }
    }
</style>
