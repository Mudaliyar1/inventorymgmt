@model IEnumerable<InventoryManagementSystem.Models.RepairTicket>
@{
    ViewData["Title"] = "Service & Repair Ticket Management";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-wrench-adjustable me-2 text-primary"></i>Service & Repair Ticketing</h3>
        <p class="text-muted small mb-0">Track device repair tickets, technician assignment, job statuses, and service charges</p>
    </div>
    <button type="button" class="btn btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createRepairModal">
        <i class="bi bi-plus-circle me-1"></i> New Repair Job Ticket
    </button>
</div>

<!-- Search & Status Filter -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-0" placeholder="Search Ticket #, IMEI, Customer, Model, or Technician...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select bg-light border-0">
                    <option value="">-- All Job Statuses --</option>
                    <option value="Received" selected="@(ViewBag.Status == "Received")">Received</option>
                    <option value="Diagnosing" selected="@(ViewBag.Status == "Diagnosing")">Diagnosing</option>
                    <option value="Repairing" selected="@(ViewBag.Status == "Repairing")">Repairing</option>
                    <option value="Ready" selected="@(ViewBag.Status == "Ready")">Ready for Delivery</option>
                    <option value="Delivered" selected="@(ViewBag.Status == "Delivered")">Delivered to Customer</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-dark w-100 rounded-pill"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-circle"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small uppercase">
                    <tr>
                        <th class="ps-4">Ticket #</th>
                        <th>Received Date</th>
                        <th>Customer</th>
                        <th>Device Model & IMEI</th>
                        <th>Problem Reported</th>
                        <th>Technician</th>
                        <th>Est. / Final Cost</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Update</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">No active service tickets found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model)
                        {
                            var badgeClass = t.Status switch
                            {
                                "Received" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
                                "Diagnosing" => "bg-info-subtle text-info border border-info-subtle",
                                "Repairing" => "bg-warning-subtle text-warning border border-warning-subtle",
                                "Ready" => "bg-primary-subtle text-primary border border-primary-subtle",
                                "Delivered" => "bg-success-subtle text-success border border-success-subtle",
                                _ => "bg-light text-dark border"
                            };

                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-primary">@t.TicketNumber</td>
                                <td class="small text-muted">@t.CreatedDate.ToString("yyyy-MM-dd HH:mm IST")</td>
                                <td>
                                    <div class="fw-semibold">@t.CustomerName</div>
                                    <div class="small text-muted">@t.CustomerPhone</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@t.DeviceBrand @t.DeviceModel</div>
                                    <div class="font-monospace small text-muted">IMEI: @(string.IsNullOrEmpty(t.IMEI) ? "-" : t.IMEI)</div>
                                </td>
                                <td>
                                    <div class="small text-wrap" style="max-width: 200px;">@t.ProblemDescription</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(t.TechnicianName) ? "Unassigned" : t.TechnicianName)</span></td>
                                <td>
                                    <div class="small text-muted">Est: ₹@t.EstimatedCost.ToString("N2")</div>
                                    <div class="fw-bold text-success">Final: ₹@t.FinalCost.ToString("N2")</div>
                                </td>
                                <td><span class="badge rounded-pill @badgeClass px-2 py-1">@t.Status</span></td>
                                <td class="pe-4 text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#updateStatusModal_@t.Id">
                                        Update
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modals outside table for HTML validity -->
@if (Model != null)
{
    foreach (var t in Model)
    {
        <div class="modal fade" id="updateStatusModal_@t.Id" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow rounded-4">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="fw-bold modal-title">Update Ticket #@t.TicketNumber</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@t.Id" />
                        <div class="modal-body py-3">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Job Status</label>
                                <select name="status" class="form-select">
                                    <option value="Received" selected="@(t.Status == "Received")">Received</option>
                                    <option value="Diagnosing" selected="@(t.Status == "Diagnosing")">Diagnosing Problem</option>
                                    <option value="Repairing" selected="@(t.Status == "Repairing")">Repairing / Replacing Parts</option>
                                    <option value="Ready" selected="@(t.Status == "Ready")">Ready for Customer Pickup</option>
                                    <option value="Delivered" selected="@(t.Status == "Delivered")">Delivered & Payment Collected</option>
                                    <option value="Cancelled" selected="@(t.Status == "Cancelled")">Cancelled</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Assigned Technician Name</label>
                                <input type="text" name="technicianName" value="@t.TechnicianName" class="form-control" placeholder="Technician Name">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Final Repair & Labor Cost (₹)</label>
                                <input type="number" step="0.01" name="finalCost" value="@t.FinalCost" class="form-control fw-bold text-success">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Technician Notes</label>
                                <textarea name="notes" rows="2" class="form-control" placeholder="Replaced display touch panel, tested battery performance...">@t.Notes</textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">Update Status</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Modal: Create Repair Ticket -->
<div class="modal fade" id="createRepairModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold modal-title"><i class="bi bi-wrench-adjustable me-2 text-primary"></i>Create Service & Repair Job Ticket</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Customer Name <span class="text-danger">*</span></label>
                            <input type="text" name="CustomerName" required class="form-control" placeholder="Customer Name">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Customer Phone <span class="text-danger">*</span></label>
                            <input type="tel" name="CustomerPhone" required class="form-control" placeholder="Customer Phone">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Device Brand <span class="text-danger">*</span></label>
                            <input type="text" name="DeviceBrand" required class="form-control" placeholder="e.g. Samsung, Apple, Vivo">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Device Model <span class="text-danger">*</span></label>
                            <input type="text" name="DeviceModel" required class="form-control" placeholder="e.g. Galaxy S21, iPhone 12">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">IMEI Number</label>
                            <input type="text" name="IMEI" class="form-control font-monospace" placeholder="15-digit IMEI">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Estimated Repair Cost (₹)</label>
                            <input type="number" step="0.01" name="EstimatedCost" class="form-control" placeholder="e.g. 1500.00">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Assigned Technician</label>
                            <input type="text" name="TechnicianName" class="form-control" placeholder="Technician Name">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Problem / Issue Reported <span class="text-danger">*</span></label>
                            <textarea name="ProblemDescription" required rows="2" class="form-control" placeholder="Screen broken, battery draining rapidly, charging port loose..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Repair Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>
