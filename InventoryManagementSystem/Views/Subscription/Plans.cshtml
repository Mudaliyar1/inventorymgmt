@model IEnumerable<InventoryManagementSystem.Models.SubscriptionPackage>
@inject InventoryManagementSystem.Interfaces.IPlatformSettingsService PlatformSettingsService
@{
    ViewData["Title"] = "Subscription Plans & Pricing";
    var currentPackage = ViewBag.CurrentPackage as InventoryManagementSystem.Models.SubscriptionPackage;
    var activeLicense = ViewBag.ActiveLicense as InventoryManagementSystem.Models.TenantLicense;
    var groupedFeatures = ViewBag.GroupedFeatures as Dictionary<string, List<FeatureDefinition>> ?? new Dictionary<string, List<FeatureDefinition>>();
    var allFeatures = ViewBag.AllFeatures as List<FeatureDefinition> ?? new List<FeatureDefinition>();
    var platformSettings = ViewBag.PlatformSettings as InventoryManagementSystem.Models.PlatformSettings ?? await PlatformSettingsService.GetSettingsAsync();
    var supportEmail = !string.IsNullOrWhiteSpace(platformSettings?.ContactEmail) ? platformSettings.ContactEmail : "support@sims.com";
    var supportPhone = !string.IsNullOrWhiteSpace(platformSettings?.ContactPhone) ? platformSettings.ContactPhone : "+91 98765 43210";
    var platformName = !string.IsNullOrWhiteSpace(platformSettings?.PlatformName) ? platformSettings.PlatformName : "SIMS SaaS Platform";
    var supportHours = platformSettings?.SupportHours;
    var officeAddress = platformSettings?.OfficeAddress;
}

<style>
    #shopPackageDetailsModal .modal-dialog {
        max-width: 840px;
    }
    #shopPackageDetailsModal .modal-content {
        background: #0f172a !important;
        background-color: #0f172a !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        border-radius: 16px !important;
        color: #f8fafc !important;
        box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.08) !important;
        overflow: hidden;
    }
    #shopPackageDetailsModal .modal-header {
        background: #131d31 !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding: 1.15rem 1.5rem !important;
    }
    #shopPackageDetailsModal .modal-title {
        color: #ffffff !important;
        font-weight: 700;
        letter-spacing: -0.01em;
    }
    #shopPackageDetailsModal .modal-body {
        background: #0b1120 !important;
        color: #e2e8f0 !important;
        padding: 1.5rem !important;
        max-height: 75vh;
        overflow-y: auto;
    }
    #shopPackageDetailsModal .modal-footer {
        background: #131d31 !important;
        border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding: 1rem 1.5rem !important;
    }
    .modal-hero-box {
        background: #131d31;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
    }
    .modal-quota-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        color: #e2e8f0;
    }
    .modal-feat-card {
        background: #131d31;
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 10px;
        padding: 12px 14px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        height: 100%;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }
    .modal-feat-card:hover {
        border-color: rgba(56, 189, 248, 0.35);
        transform: translateY(-1px);
    }
    .modal-feat-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.25);
        color: #10b981;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 15px;
    }
</style>

<div class="container-fluid px-2 px-md-3 py-3">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 font-display fw-bold mb-1">
                <i class="bi bi-shield-check text-warning me-2"></i>SaaS Subscription Packages & Upgrades
            </h1>
            <p class="text-muted fs-7 mb-0">Select the ideal plan tier for your mobile shop business and unlock powerful inventory management modules.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("MyPlan", "Subscription")" class="btn btn-primary btn-sm">
                <i class="bi bi-shield-check me-1"></i> My Active Plan
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <form id="plansAntiForgeryToken" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <!-- Active License Status Banner -->
    @if (currentPackage != null || activeLicense != null)
    {
        <div class="card-d card-p-lg mb-5 border-primary shadow-sm">
            <div class="row align-items-center g-3">
                <div class="col-md-7">
                    <h5 class="fw-bold mb-1" style="color:var(--text-primary)">
                        Active Shop Plan: <span class="text-primary font-mono fw-bold">@(currentPackage?.Name ?? "Basic Plan")</span>
                        <span class="badge @(activeLicense?.Status == "Active" ? "bg-success" : "bg-warning") ms-2 fs-7">@(activeLicense?.Status ?? "Active")</span>
                    </h5>
                    <div class="fs-7" style="color:var(--text-muted)">
                        Price: <strong class="text-success font-mono">₹@(currentPackage?.MonthlyPrice ?? 0)/mo</strong> |
                        Expiry Date: <strong style="color:var(--text-primary)">@(activeLicense != null ? activeLicense.ExpiryDate.ToString("MMMM dd, yyyy") : "N/A")</strong>
                        @if (activeLicense != null)
                        {
                            var days = (int)(activeLicense.ExpiryDate - DateTime.UtcNow).TotalDays;
                            <span class="badge @(days > 7 ? "bg-success" : "bg-danger") ms-2">@days Days Remaining</span>
                        }
                    </div>
                </div>
                <div class="col-md-5 text-md-end">
                    <a href="@Url.Action("Renew", "Subscription")" class="btn-d btn-primary">
                        <i class="bi bi-arrow-repeat me-1"></i> Renew Subscription
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Monthly / Yearly Billing Toggle Switch -->
    <div class="d-flex justify-content-center align-items-center mb-5">
        <div class="p-2 rounded-pill d-flex align-items-center gap-3" style="background:var(--card-bg);border:1px solid var(--border)">
            <span class="fw-bold fs-7 ps-2" id="labelMonthly" style="color:var(--text-primary)">Monthly Billing</span>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input cursor-pointer" type="checkbox" id="billingToggle" style="width:50px;height:26px" onchange="toggleBillingCycle(this)">
            </div>
            <span class="fs-7 pe-2" id="labelYearly" style="color:var(--text-muted)">
                Yearly Billing <span class="badge bg-success text-dark font-mono">SAVE 20%</span>
            </span>
        </div>
    </div>

    <!-- Responsive Package Cards Grid -->
    <div class="row g-4 mb-5 justify-content-center">
        @if (Model != null && Model.Any())
        {
            var count = Model.Count();
            var colClass = count == 1 ? "col-lg-6 col-md-8 col-12" : count == 2 ? "col-lg-5 col-md-6 col-12" : count == 3 ? "col-xl-4 col-lg-4 col-md-6 col-12" : "col-xl-3 col-lg-4 col-md-6 col-12";
            foreach (var pkg in Model.OrderBy(p => p.DisplayOrder))
            {
                var isCurrent = currentPackage != null && currentPackage.Id == pkg.Id;
                var pkgFeatures = allFeatures.Where(f => pkg.EnabledFeatures != null && pkg.EnabledFeatures.Contains(f.FeatureKey, StringComparer.OrdinalIgnoreCase)).ToList();

                <div class="@colClass">
                    <div class="card-d card-p-lg h-100 d-flex flex-column justify-content-between position-relative transition-all @(pkg.IsFeatured ? "border-warning shadow-lg" : isCurrent ? "border-primary" : "")" style="border:1px solid var(--border)">
                        @if (pkg.IsFeatured)
                        {
                            <span class="position-absolute top-0 end-0 bg-warning text-dark font-mono fw-bold px-3 py-1 rounded-bottom-start fs-8">
                                MOST POPULAR
                            </span>
                        }
                        else if (isCurrent)
                        {
                            <span class="position-absolute top-0 end-0 bg-primary text-dark font-mono fw-bold px-3 py-1 rounded-bottom-start fs-8">
                                CURRENT PLAN
                            </span>
                        }

                        <div>
                            <h4 class="font-display fw-bold mb-2" style="color:var(--text-primary)">@pkg.Name</h4>
                            <p class="fs-7 mb-3 min-h-40" style="color:var(--text-secondary)">@pkg.Description</p>

                            <!-- Price Display -->
                            <div class="mb-4">
                                <div class="price-monthly-block">
                                    <span class="fs-1 fw-bold text-success font-mono">₹@pkg.MonthlyPrice.ToString("N0")</span>
                                    <span class="fs-7" style="color:var(--text-muted)">/ month</span>
                                </div>
                                <div class="price-yearly-block d-none">
                                    <span class="fs-1 fw-bold text-success font-mono">₹@(pkg.YearlyPrice > 0 ? pkg.YearlyPrice.ToString("N0") : (pkg.MonthlyPrice * 10).ToString("N0"))</span>
                                    <span class="fs-7" style="color:var(--text-muted)">/ year</span>
                                </div>
                            </div>

                            <h6 class="font-display fw-bold text-info fs-7 mb-3 uppercase font-mono">Highlighted Features</h6>

                            <!-- Highlighted Feature Bullet Items -->
                            <ul class="list-unstyled fs-7 mb-4">
                                @if (pkgFeatures.Any())
                                {
                                    foreach (var feat in pkgFeatures.Take(6))
                                    {
                                        <li class="mb-2 d-flex align-items-center" style="color:var(--text-primary)">
                                            <i class="bi bi-check-circle-fill text-success me-2 fs-6 flex-shrink-0"></i>
                                            <span>@feat.FeatureName</span>
                                        </li>
                                    }
                                    if (pkgFeatures.Count > 6)
                                    {
                                        <li class="text-info fs-7 font-mono fw-bold mt-2">
                                            + @(pkgFeatures.Count - 6) additional modules included
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li class="fs-7" style="color:var(--text-muted)">Standard shop features</li>
                                }
                            </ul>
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="d-grid gap-2 pt-3 border-top" style="border-color:var(--border)!important">
                            <button type="button" class="btn-d btn-ghost btn-sm" onclick="openPackageDetailsModal('@pkg.Id')">
                                <i class="bi bi-info-circle me-1"></i> View More Details
                            </button>
                            @if (isCurrent)
                            {
                                <button type="button" class="btn-d btn-outline disabled" disabled>
                                    <i class="bi bi-check2-circle me-1"></i> Current Plan
                                </button>
                            }
                            else if (pkg.MonthlyPrice <= 0)
                            {
                                <button type="button" class="btn-d btn-outline disabled" disabled title="Trial plans are available for new shop signups only">
                                    <i class="bi bi-shield-lock me-1"></i> New Signups Only
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-d btn-primary btn-choose-plan" id="btn-choose-@pkg.Id" onclick="initiateDirectRazorpayRenewal('@pkg.Id', '@pkg.Name')">
                                    <i class="bi bi-lightning-charge-fill me-1"></i> Choose Plan
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- DYNAMIC PACKAGE COMPARISON MATRIX TABLE -->
    <div class="card-d card-p-lg mb-4">
        <h4 class="font-display fw-bold mb-2" style="color:var(--text-primary)">
            <i class="bi bi-table text-warning me-2"></i>Compare Package Capabilities Side-by-Side
        </h4>
        <p class="fs-7 mb-4" style="color:var(--text-secondary)">Detailed breakdown of included Shop Admin features across each subscription plan.</p>

        <div class="tbl-wrap" style="border:1px solid var(--border)">
            <div class="tbl-scroll">
                <table class="tbl mb-0 w-100">
                    <thead>
                        <tr>
                            <th class="pe-3">Feature / Module Name</th>
                            @foreach (var pkg in Model.OrderBy(p => p.DisplayOrder))
                            {
                                <th class="text-center font-mono py-3 px-3" style="text-wrap: nowrap;">
                                    <div class="fw-bold fs-6" style="color:var(--text-primary)">@pkg.Name</div>
                                    <div class="text-success fs-7">₹@pkg.MonthlyPrice/mo</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in groupedFeatures)
                        {
                            <tr style="background:var(--bg)">
                                <td colspan="@(Model.Count() + 1)" class="fw-bold text-warning font-mono fs-7 uppercase tracking-wider py-2">
                                    <i class="bi bi-folder2-open me-2"></i>@group.Key
                                </td>
                            </tr>
                            foreach (var feat in group.Value)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center py-1">
                                            <i class="bi @feat.Icon text-info me-2 fs-5 flex-shrink-0"></i>
                                            <div>
                                                <strong class="fs-6" style="color:var(--text-primary)">@feat.FeatureName</strong>
                                                <div class="fs-7 mt-1" style="color:var(--text-secondary)">@feat.Description</div>
                                            </div>
                                        </div>
                                    </td>
                                    @foreach (var pkg in Model.OrderBy(p => p.DisplayOrder))
                                    {
                                        var isInc = pkg.EnabledFeatures != null && pkg.EnabledFeatures.Contains(feat.FeatureKey, StringComparer.OrdinalIgnoreCase);
                                        <td class="text-center">
                                            @if (isInc)
                                            {
                                                <span class="badge bg-success-subtle text-success p-2" style="border-radius:50%" title="Included">
                                                    <i class="bi bi-check-lg fs-6"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger p-2" style="border-radius:50%" title="Not Included">
                                                    <i class="bi bi-x-lg fs-6"></i>
                                                </span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- DYNAMIC VIEW MORE DETAILS MODAL -->
<div class="modal fade" id="shopPackageDetailsModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-display fw-bold mb-0 text-white" id="detModalTitle">
                    <i class="bi bi-shield-check me-2 text-primary"></i>Package Feature Breakdown
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detModalBody">
                <!-- JS Dynamic Feature Categories -->
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm px-4 py-2" data-bs-dismiss="modal" style="color:#cbd5e1;border-color:#475569;border-radius:8px;font-weight:600;">Close</button>
                <button type="button" class="btn btn-primary btn-sm px-4 py-2 fw-bold d-inline-flex align-items-center gap-2" id="detModalUpgradeBtn" data-bs-toggle="modal" data-bs-target="#upgradeRequestModal" style="border-radius:8px;box-shadow:0 4px 14px rgba(59,130,246,0.4);">
                    <i class="bi bi-rocket-takeoff-fill"></i> Request Plan Upgrade
                </button>
            </div>
        </div>
    </div>
</div>

<!-- UPGRADE REQUEST / INQUIRY MODAL -->
<div class="modal fade" id="upgradeRequestModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:#0f172a!important;border:1px solid rgba(255,255,255,0.15)!important;color:#f8fafc!important;border-radius:14px;box-shadow:0 25px 50px -12px rgba(0,0,0,0.85);">
            <div class="modal-header border-bottom" style="border-color:rgba(255,255,255,0.1)!important;background:rgba(255,255,255,0.02);">
                <h5 class="modal-title font-display fw-bold mb-0 text-white">
                    <i class="bi bi-rocket-takeoff me-2 text-primary"></i>Request Subscription Upgrade / Inquiry
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="background:#0f172a;color:#f8fafc;">
                <div class="text-center mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                          style="width:56px;height:56px;background:rgba(59,130,246,0.15);border:1px solid rgba(59,130,246,0.3)">
                        <i class="bi bi-headset fs-3 text-primary"></i>
                    </span>
                    <h5 class="fw-bold text-light mb-1">Upgrade Your Shop Plan</h5>
                    <p class="text-secondary fs-7 mb-0">
                        Contact your @platformName support team to upgrade or activate additional quotas.
                    </p>
                </div>

                <div id="selectedPlanContainer" class="d-none rounded-3 py-2 px-3 fs-7 mb-3 text-center"
                     style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.35)">
                    <i class="bi bi-rocket-takeoff-fill text-warning me-1"></i>
                    <span class="text-secondary">Requested Plan:</span>
                    <strong id="selectedPlanName" class="text-warning ms-1"></strong>
                </div>

                <div class="rounded-3 mb-4" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1)">
                    <div class="d-flex align-items-center gap-3 px-3 py-3" style="border-bottom:1px solid rgba(255,255,255,0.07)">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                             style="width:36px;height:36px;background:rgba(6,182,212,0.15)">
                            <i class="bi bi-envelope-fill text-info"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="text-secondary" style="font-size:11px;text-transform:uppercase;letter-spacing:.5px">Support Email</div>
                            <a href="mailto:@supportEmail" id="upgradeEmailText"
                               class="text-light fw-semibold fs-7 text-decoration-none text-break">@supportEmail</a>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 px-3 py-3" style="border-bottom:1px solid rgba(255,255,255,0.07)">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                             style="width:36px;height:36px;background:rgba(6,182,212,0.15)">
                            <i class="bi bi-telephone-fill text-info"></i>
                        </div>
                        <div>
                            <div class="text-secondary" style="font-size:11px;text-transform:uppercase;letter-spacing:.5px">Support Hotline</div>
                            <a href="tel:@supportPhone" id="upgradePhoneText"
                               class="text-light fw-semibold fs-7 text-decoration-none">@supportPhone</a>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(supportHours))
                    {
                        <div class="d-flex align-items-center gap-3 px-3 py-3" style="border-bottom:1px solid rgba(255,255,255,0.07)">
                            <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                 style="width:36px;height:36px;background:rgba(245,158,11,0.15)">
                                <i class="bi bi-clock-history text-warning"></i>
                            </div>
                            <div>
                                <div class="text-secondary" style="font-size:11px;text-transform:uppercase;letter-spacing:.5px">Support Hours</div>
                                <div class="text-light fw-semibold fs-7">@supportHours</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(officeAddress))
                    {
                        <div class="d-flex align-items-center gap-3 px-3 py-3">
                            <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                 style="width:36px;height:36px;background:rgba(239,68,68,0.15)">
                                <i class="bi bi-geo-alt-fill text-danger"></i>
                            </div>
                            <div>
                                <div class="text-secondary" style="font-size:11px;text-transform:uppercase;letter-spacing:.5px">Office Address</div>
                                <div class="text-light fw-semibold fs-7">@officeAddress</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <a href="mailto:@supportEmail?subject=SaaS%20Plan%20Upgrade%20Inquiry&body=Hello%20Platform%20Support,%0A%0AWe%20would%20like%20to%20inquire%20about%20upgrading%20our%20subscription%20plan.%0A%0AThank%20you!"
                       id="upgradeEmailBtn" class="btn btn-primary flex-grow-1 fw-semibold shadow-sm">
                        <i class="bi bi-envelope-fill me-1"></i> Email Inquiry
                    </a>
                    <a href="tel:@supportPhone" id="upgradePhoneBtn" class="btn btn-outline-info flex-grow-1 fw-semibold">
                        <i class="bi bi-telephone-fill me-1"></i> Call Support
                    </a>
                </div>
            </div>
            <div class="modal-footer border-secondary justify-content-center py-2">
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        const rawPackages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new {
            id = p.Id,
            name = p.Name,
            desc = p.Description,
            monthly = p.MonthlyPrice,
            yearly = p.YearlyPrice,
            trialValue = p.TrialDuration > 0 ? p.TrialDuration : p.TrialDays,
            trialUnit = p.TrialDurationUnit,
            trialDays = p.TrialDays,
            maxAdmins = p.MaxAdmins,
            maxEmployees = p.MaxEmployees,
            maxProducts = p.MaxProducts,
            maxSuppliers = p.MaxSuppliers,
            features = p.EnabledFeatures ?? p.EnabledModules ?? new List<string>()
        })));

        const rawAllFeatures = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allFeatures.Select(f => new {
            key = f.FeatureKey,
            name = f.FeatureName,
            cat = f.Category,
            desc = f.Description,
            icon = f.Icon
        })));

        function toggleBillingCycle(toggleEl) {
            const isYearly = toggleEl.checked;
            const lblM = document.getElementById('labelMonthly');
            const lblY = document.getElementById('labelYearly');
            if (lblM) lblM.className = isYearly ? 'text-muted fs-7 ps-2' : 'text-light fw-bold fs-7 ps-2';
            if (lblY) lblY.className = isYearly ? 'text-light fw-bold fs-7 pe-2' : 'text-muted fs-7 pe-2';

            document.querySelectorAll('.price-monthly-block').forEach(b => b.classList.toggle('d-none', isYearly));
            document.querySelectorAll('.price-yearly-block').forEach(b => b.classList.toggle('d-none', !isYearly));
        }

        window.openPackageDetailsModal = function(pkgId) {
            const pkg = (rawPackages || []).find(p => String(p.id || p.Id || '').toLowerCase() === String(pkgId || '').toLowerCase());
            if (!pkg) {
                console.warn('Package details not found for ID:', pkgId);
                return;
            }

            const pName = pkg.name || pkg.Name || 'Package Details';
            const pDesc = pkg.desc || pkg.Description || '';
            const pMonthly = pkg.monthly ?? pkg.MonthlyPrice ?? 0;
            const pYearly = pkg.yearly ?? pkg.YearlyPrice ?? 0;
            const pFeatures = pkg.features || pkg.EnabledFeatures || pkg.EnabledModules || [];
            const pMaxAdmins = pkg.maxAdmins ?? pkg.MaxAdmins ?? 0;
            const pMaxStaff = pkg.maxEmployees ?? pkg.MaxEmployees ?? 0;
            const pMaxProducts = pkg.maxProducts ?? pkg.MaxProducts ?? 0;
            const pMaxSuppliers = pkg.maxSuppliers ?? pkg.MaxSuppliers ?? 0;
            const pTrialVal = pkg.trialValue ?? 0;
            const pTrialUnit = pkg.trialUnit || 'Days';

            const titleEl = document.getElementById('detModalTitle');
            if (titleEl) titleEl.innerHTML = `<i class="bi bi-shield-check me-2 text-primary"></i>${pName} — Included Features`;

            let trialBadge = '';
            if (pTrialVal > 0) {
                trialBadge = `<span class="badge" style="background:rgba(16,185,129,0.15);color:#34d399;border:1px solid rgba(16,185,129,0.3);font-size:12px;padding:5px 12px;border-radius:20px;font-weight:600;"><i class="bi bi-gift-fill me-1"></i>${pTrialVal} ${pTrialUnit} Free Trial</span>`;
            }

            let html = `
                <div class="modal-hero-box">
                    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <h3 class="fw-bold mb-0 text-white">${pName}</h3>
                            ${trialBadge}
                        </div>
                        <div class="text-end">
                            <span class="fs-3 fw-bold text-success font-mono">₹${Number(pMonthly).toLocaleString('en-IN')}</span>
                            <span class="text-secondary fs-7">/mo</span>
                            ${pYearly > 0 ? `<div class="fs-8 font-mono" style="color:#94a3b8!important;">(₹${Number(pYearly).toLocaleString('en-IN')}/yr billed annually)</div>` : ''}
                        </div>
                    </div>
                    <p class="fs-7 mb-3" style="color:#94a3b8!important;line-height:1.5;">${pDesc}</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="modal-quota-pill"><i class="bi bi-shield-lock text-warning"></i>Admins: <strong class="text-white">${pMaxAdmins > 0 ? pMaxAdmins : 'Unlimited'}</strong></span>
                        <span class="modal-quota-pill"><i class="bi bi-people text-info"></i>Staff: <strong class="text-white">${pMaxStaff > 0 ? pMaxStaff : 'Unlimited'}</strong></span>
                        <span class="modal-quota-pill"><i class="bi bi-box-seam text-primary"></i>Products: <strong class="text-white">${pMaxProducts > 0 ? pMaxProducts : 'Unlimited'}</strong></span>
                        <span class="modal-quota-pill"><i class="bi bi-truck text-success"></i>Suppliers: <strong class="text-white">${pMaxSuppliers > 0 ? pMaxSuppliers : 'Unlimited'}</strong></span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mb-3 mt-4">
                    <span style="width:3px;height:16px;background:#38bdf8;border-radius:2px;"></span>
                    <h6 class="mb-0 fw-bold font-mono text-uppercase" style="color:#38bdf8;font-size:12px;letter-spacing:0.06em;">Included Modules & Capabilities</h6>
                </div>
            `;

            // Group features by Category
            const cats = {};
            (rawAllFeatures || []).forEach(f => {
                const fCat = f.cat || f.Category || 'General';
                const fKey = f.key || f.FeatureKey || '';
                const fName = f.name || f.FeatureName || '';
                const fDesc = f.desc || f.Description || '';
                const fIcon = f.icon || f.Icon || 'bi-check2-circle';

                if (!cats[fCat]) cats[fCat] = [];
                const isIncluded = pFeatures.some(k => String(k || '').toLowerCase() === String(fKey || '').toLowerCase());
                if (isIncluded) {
                    cats[fCat].push({ key: fKey, name: fName, cat: fCat, desc: fDesc, icon: fIcon });
                }
            });

            let featCount = 0;
            for (const [catName, featList] of Object.entries(cats)) {
                if (!featList || featList.length === 0) continue;
                featCount += featList.length;
                html += `
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2 mt-3 pb-1" style="border-bottom:1px solid rgba(255,255,255,0.06);">
                            <span class="fw-bold font-mono fs-7 text-uppercase" style="color:#f59e0b;"><i class="bi bi-folder2-open me-2"></i>${catName}</span>
                            <span class="badge" style="background:#1e293b;color:#94a3b8;border:1px solid #334155;font-size:11px;">${featList.length} Included</span>
                        </div>
                        <div class="row g-2">
                `;
                featList.forEach(f => {
                    html += `
                        <div class="col-md-6">
                            <div class="modal-feat-card">
                                <div class="modal-feat-icon">
                                    <i class="bi ${f.icon}"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <strong class="text-white fs-7 d-block mb-1">${f.name}</strong>
                                    <div class="fs-8" style="color:#94a3b8!important;line-height:1.45;">${f.desc}</div>
                                </div>
                            </div>
                        </div>
                    `;
                });
                html += `</div></div>`;
            }

            if (featCount === 0) {
                html += `<div class="alert alert-info border-info text-info bg-dark"><i class="bi bi-info-circle me-2"></i>Includes all standard shop management modules.</div>`;
            }

            const modalBody = document.getElementById('detModalBody');
            if (modalBody) modalBody.innerHTML = html;

            const upgradeBtn = document.getElementById('detModalUpgradeBtn');
            if (upgradeBtn) {
                if (pMonthly <= 0) {
                    upgradeBtn.classList.add('d-none');
                } else {
                    upgradeBtn.classList.remove('d-none');
                    upgradeBtn.innerHTML = '<i class="bi bi-lightning-charge-fill me-1"></i> Choose & Pay (Razorpay)';
                    upgradeBtn.onclick = function() {
                        const modalEl = document.getElementById('shopPackageDetailsModal');
                        if (modalEl) {
                            const bsModal = bootstrap.Modal.getInstance(modalEl);
                            if (bsModal) bsModal.hide();
                        }
                        initiateDirectRazorpayRenewal(pkgId, pName);
                    };
                }
            }

            const modalEl = document.getElementById('shopPackageDetailsModal');
            if (modalEl) {
                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                bsModal.show();
            }
        };

        async function initiateDirectRazorpayRenewal(packageId, packageName) {
            const isYearly = document.getElementById('billingToggle')?.checked;
            const billingCycle = isYearly ? 'Yearly' : 'Monthly';

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const csrfToken = tokenInput ? tokenInput.value : '';

            const btn = document.getElementById('btn-choose-' + packageId);
            const originalHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Connecting...';
            }

            try {
                const formData = new FormData();
                formData.append('packageId', packageId);
                formData.append('billingCycle', billingCycle);
                formData.append('__RequestVerificationToken', csrfToken);

                const response = await fetch('@Url.Action("InitiateRazorpayRenewal", "Subscription")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();
                if (!data.success) {
                    alert('Could not start Razorpay payment: ' + (data.message || 'Unknown error'));
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = originalHtml;
                    }
                    return;
                }

                // Launch Razorpay Checkout Modal directly
                const options = {
                    key: data.keyId,
                    amount: data.amountInPaise,
                    currency: data.currency,
                    name: 'SIMS SaaS Platform',
                    description: data.packageName + ' Renewal (' + data.billingCycle + ')',
                    order_id: data.orderId,
                    handler: async function (paymentResponse) {
                        if (btn) {
                            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Activating...';
                        }

                        const verifyForm = new FormData();
                        verifyForm.append('razorpay_order_id', paymentResponse.razorpay_order_id);
                        verifyForm.append('razorpay_payment_id', paymentResponse.razorpay_payment_id);
                        verifyForm.append('razorpay_signature', paymentResponse.razorpay_signature);
                        verifyForm.append('__RequestVerificationToken', csrfToken);

                        const verifyRes = await fetch('@Url.Action("VerifyRazorpayRenewal", "Subscription")', {
                            method: 'POST',
                            body: verifyForm
                        });

                        const verifyData = await verifyRes.json();
                        if (verifyData.success) {
                            alert('Payment successful! Your license has been upgraded immediately. Receipt #' + verifyData.receiptNumber);
                            window.location.href = '@Url.Action("MyPlan", "Subscription")';
                        } else {
                            alert('Payment was processed but activation requires attention: ' + verifyData.message);
                            window.location.reload();
                        }
                    },
                    prefill: {
                        name: data.customerName,
                        email: data.customerEmail,
                        contact: data.customerPhone
                    },
                    theme: {
                        color: '#0284c7'
                    },
                    modal: {
                        ondismiss: function () {
                            if (btn) {
                                btn.disabled = false;
                                btn.innerHTML = originalHtml;
                            }
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.open();
            } catch (err) {
                console.error('Razorpay direct checkout error:', err);
                alert('An unexpected error occurred while initiating Razorpay payment. Please try again.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }
        }

        function selectUpgradePackage(name, id) {
            const container = document.getElementById('selectedPlanContainer');
            const nameEl = document.getElementById('selectedPlanName');
            const emailBtn = document.getElementById('upgradeEmailBtn');
            if (container && nameEl) {
                if (name) {
                    container.classList.remove('d-none');
                    nameEl.innerText = name;
                } else {
                    container.classList.add('d-none');
                }
            }
            if (emailBtn) {
                const targetEmail = '@supportEmail';
                const planName = encodeURIComponent(name || 'Plan Upgrade');
                emailBtn.href = `mailto:${targetEmail}?subject=Inquiry%20to%20Upgrade%20to%20${planName}&body=Hello%20Platform%20Support,%0A%0AWe%20would%20like%20to%20inquire%20about%20upgrading%20our%20shop%20subscription%20to%20the%20${planName}%20plan.%0A%0AThank%20you!`;
            }
        }
    </script>
}
