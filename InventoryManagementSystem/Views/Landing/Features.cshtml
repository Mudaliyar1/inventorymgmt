@{
    ViewData["Title"] = "Powerful Mobile Shop Features — SIMS SaaS";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary px-3 py-2 text-uppercase font-mono fw-bold fs-7 rounded-pill mb-2">Built for Mobile Retailers</span>
        <h1 class="display-4 font-display fw-bold mb-3 text-light">Next-Gen Shop Management Features</h1>
        <p class="lead text-muted mx-auto" style="max-width: 700px;">Explore the full suite of cloud tools designed to automate stock inventory, serial tracking, billing, and repairs.</p>
    </div>

    <div class="row g-4">
        <!-- Feature 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 border-top border-primary border-3">
                <div class="fs-1 text-primary mb-3"><i class="bi bi-qr-code-scan"></i></div>
                <h3 class="h5 font-display fw-bold text-light">Dual-IMEI & Barcode Tracking</h3>
                <p class="text-muted fs-7">Scan and track smartphone serial numbers, dual-IMEI identifiers, color variants, and storage options with complete barcode support.</p>
            </div>
        </div>

        <!-- Feature 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 border-top border-success border-3">
                <div class="fs-1 text-success mb-3"><i class="bi bi-calculator"></i></div>
                <h3 class="h5 font-display fw-bold text-light">POS & Custom Thermal Invoicing</h3>
                <p class="text-muted fs-7">Lightning fast POS checkout window. Print clean thermal or standard PDF invoices with GST breakdown, warranty terms, and discounts.</p>
            </div>
        </div>

        <!-- Feature 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 border-top border-warning border-3">
                <div class="fs-1 text-warning mb-3"><i class="bi bi-truck"></i></div>
                <h3 class="h5 font-display fw-bold text-light">Supplier Intake & Purchase Returns</h3>
                <p class="text-muted fs-7">Send digital purchase orders to vendors, record incoming shipments, handle dead-on-arrival returns, and track supplier payables.</p>
            </div>
        </div>

        <!-- Feature 4 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 border-top border-info border-3">
                <div class="fs-1 text-info mb-3"><i class="bi bi-tools"></i></div>
                <h3 class="h5 font-display fw-bold text-light">Repair Ticket Management</h3>
                <p class="text-muted fs-7">Manage repair intake jobs, track technician repair statuses, record replaced component costs, and notify customers on completion.</p>
            </div>
        </div>

        <!-- Feature 5 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 border-top border-danger border-3">
                <div class="fs-1 text-danger mb-3"><i class="bi bi-arrow-left-right"></i></div>
                <h3 class="h5 font-display fw-bold text-light">Trade-In Smartphone Exchange</h3>
                <p class="text-muted fs-7">Evaluate old smartphones during customer trade-ins, record condition ratings, apply instant store credit, and list refurbished items.</p>
            </div>
        </div>

        <!-- Feature 6 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card p-4 h-100 border-top border-secondary border-3">
                <div class="fs-1 text-light mb-3"><i class="bi bi-shield-check"></i></div>
                <h3 class="h5 font-display fw-bold text-light">Multi-Tenant Isolation & Role Security</h3>
                <p class="text-muted fs-7">Granular access control for Owners, Managers, Salesmen, Technicians, and Suppliers with automatic data tenant isolation.</p>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-5 pt-4">
        <a href="@Url.Action("Register", "Landing")" class="btn btn-primary btn-lg px-5 shadow-lg fw-bold"><i class="bi bi-rocket-takeoff me-2"></i> Start Your 14-Day Free Trial</a>
    </div>
</div>
