@model InventoryManagementSystem.Models.PendingRegistration
@{
    ViewData["Title"] = "Verify Your Email — SIMS Free Trial";
    Layout = "_Layout";
    var token = (string)ViewBag.Token;
    var contactEmail = (string)ViewBag.ContactEmail;
    var ownerName = (string)ViewBag.OwnerName;
    var cooldownSec = (int)(ViewBag.ResendCooldownSeconds ?? 0);
}

<div class="pz-page-wrap">
    <div class="pz-container" style="max-width: 580px;">

        <!-- Section Header -->
        <div class="pz-section-head mb-4 text-center">
            <span class="pz-accent-eyebrow">STEP 2 OF 2 — EMAIL VERIFICATION</span>
            <h1 class="pz-section-title">Verify your email address</h1>
            <span class="pz-heading-accent" aria-hidden="true"></span>
            <p class="pz-section-sub">
                We've sent a 6-digit verification code to <strong class="text-dark">@contactEmail</strong>. Enter it below to activate your shop and start your free trial.
            </p>
        </div>

        <div class="pz-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(56, 189, 248, 0.12); color: #0284c7; display: inline-flex; align-items: center; justify-content: center; font-size: 28px;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h4 class="mt-3 mb-1 fw-bold" style="color: #17181B;">Enter 6-Digit Code</h4>
                <p class="text-muted fs-8 mb-0">Code expires in 10 minutes. Check your spam folder if not found in inbox.</p>
            </div>

            <form method="post" action="@Url.Action("ConfirmRegistrationOtp", "Landing")" id="otpConfirmForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@token" />

                <div class="mb-4">
                    <label class="pz-form-label text-center d-block mb-2" style="color: #17181B; font-weight: 600;">
                        Verification Code (OTP)
                    </label>
                    <div class="d-flex justify-content-center">
                        <input type="text"
                               name="otp"
                               id="otpInput"
                               class="pz-form-control text-center fw-bold"
                               style="max-width: 260px; font-size: 28px; letter-spacing: 8px; font-family: monospace; height: 60px; border: 2px solid #0284c7; border-radius: 10px;"
                               placeholder="123456"
                               maxlength="6"
                               pattern="\d{6}"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               required
                               autofocus />
                    </div>
                    <div class="text-center mt-2">
                        <small class="text-muted">Enter the 6-digit number without spaces</small>
                    </div>
                </div>

                <div class="mb-4">
                    <button type="submit" class="pz-btn-primary w-100 py-3 text-center justify-content-center text-decoration-none d-flex align-items-center gap-2" id="btnSubmitOtp">
                        <span>Verify &amp; Activate Free Trial</span>
                        <i class="bi bi-arrow-right-circle ms-1"></i>
                    </button>
                </div>
            </form>

            <div class="text-center pt-3 border-top">
                <p class="mb-2 fs-8 text-muted">Didn't receive the email code?</p>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary fw-semibold px-3 py-1"
                        id="btnResendOtp"
                        onclick="triggerResendOtp()"
                        @(cooldownSec > 0 ? "disabled" : "")>
                    <i class="bi bi-arrow-repeat me-1"></i>
                    <span id="resendBtnText">@(cooldownSec > 0 ? $"Resend in {cooldownSec}s" : "Resend Verification Code")</span>
                </button>
                <div class="mt-3 fs-8">
                    <a href="@Url.Action("Register", "Landing")" class="text-decoration-none text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Incorrect email? Start over
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    (function () {
        let cooldown = @cooldownSec;
        const btnResend = document.getElementById('btnResendOtp');
        const resendText = document.getElementById('resendBtnText');

        if (cooldown > 0) {
            const timer = setInterval(() => {
                cooldown--;
                if (cooldown <= 0) {
                    clearInterval(timer);
                    btnResend.removeAttribute('disabled');
                    resendText.textContent = "Resend Verification Code";
                } else {
                    resendText.textContent = `Resend in ${cooldown}s`;
                }
            }, 1000);
        }

        // Auto-submit when 6 digits are typed
        const otpInput = document.getElementById('otpInput');
        otpInput.addEventListener('input', function (e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length === 6) {
                document.getElementById('otpConfirmForm').submit();
            }
        });
    })();

    async function triggerResendOtp() {
        const btn = document.getElementById('btnResendOtp');
        const textSpan = document.getElementById('resendBtnText');
        btn.setAttribute('disabled', 'true');
        textSpan.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Sending...';

        try {
            const token = '@token';
            const form = new FormData();
            form.append('token', token);

            // Fetch request with antiforgery token
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            form.append('__RequestVerificationToken', csrfToken);

            const resp = await fetch('@Url.Action("ResendRegistrationOtp", "Landing")', {
                method: 'POST',
                body: form
            });

            const data = await resp.json();
            if (data.success) {
                alert(data.message);
                // Start 60 second cooldown
                let cd = 60;
                textSpan.textContent = `Resend in ${cd}s`;
                const t = setInterval(() => {
                    cd--;
                    if (cd <= 0) {
                        clearInterval(t);
                        btn.removeAttribute('disabled');
                        textSpan.textContent = "Resend Verification Code";
                    } else {
                        textSpan.textContent = `Resend in ${cd}s`;
                    }
                }, 1000);
            } else {
                alert(data.message || 'Error resending code.');
                btn.removeAttribute('disabled');
                textSpan.textContent = "Resend Verification Code";
            }
        } catch (err) {
            alert('Failed to connect to the server. Please check your connection and try again.');
            btn.removeAttribute('disabled');
            textSpan.textContent = "Resend Verification Code";
        }
    }
</script>
