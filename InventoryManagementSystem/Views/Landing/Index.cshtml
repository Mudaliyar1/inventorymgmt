@{
    ViewData["Title"] = "SIMS — Complete Mobile Shop Management Software";
    Layout = "_Layout";
}

<div class="py-5 text-center position-relative overflow-hidden">
    <div class="container py-5">
        <span class="badge bg-primary px-3 py-2 text-uppercase font-mono fw-bold fs-7 rounded-pill mb-3">Cloud-Based Multi-Tenant SaaS</span>
        <h1 class="display-3 font-display fw-bold mb-3 text-light">All-In-One Mobile Shop Management Software</h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 750px;">
            Streamline your inventory, IMEI device tracking, POS billing, supplier purchase orders, customer returns, and repair management from one secure platform.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="@Url.Action("Register", "Landing")" class="btn btn-primary btn-lg px-4 shadow-lg"><i class="bi bi-rocket-takeoff me-2"></i> Start 14-Day Free Trial</a>
            <a href="@Url.Action("Pricing", "Landing")" class="btn btn-outline-light btn-lg px-4"><i class="bi bi-tags me-2"></i> View Pricing Plans</a>
        </div>
    </div>
</div>

<div class="py-5 bg-dark border-top border-bottom border-secondary">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="h3 font-display fw-bold">Everything Your Mobile Shop Needs</h2>
            <p class="text-muted fs-6">Engineered specifically for smartphone retailers, distributors, and repair centers.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <div class="fs-1 text-primary mb-3"><i class="bi bi-phone"></i></div>
                    <h3 class="h5 font-display fw-bold text-light">IMEI & Device Tracking</h3>
                    <p class="text-muted fs-7 mb-0">Track exact dual-IMEI and serial numbers from purchase order stock-in to POS customer billing and warranty claims.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <div class="fs-1 text-success mb-3"><i class="bi bi-receipt"></i></div>
                    <h3 class="h5 font-display fw-bold text-light">Fast POS & GST Invoicing</h3>
                    <p class="text-muted fs-7 mb-0">Instant checkout billing with custom serial/IMEI selection, automatic GST tax computation, and digital receipts.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <div class="fs-1 text-warning mb-3"><i class="bi bi-truck"></i></div>
                    <h3 class="h5 font-display fw-bold text-light">Supplier Order Management</h3>
                    <p class="text-muted fs-7 mb-0">Manage supplier catalog pricing, automated stock replenishment orders, purchase returns, and vendor accounts.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <div class="fs-1 text-info mb-3"><i class="bi bi-tools"></i></div>
                    <h3 class="h5 font-display fw-bold text-light">Repair & Service Ticketing</h3>
                    <p class="text-muted fs-7 mb-0">Track phone repair status, technician assignments, part costs, labor charges, and customer notification alerts.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <div class="fs-1 text-danger mb-3"><i class="bi bi-arrow-left-right"></i></div>
                    <h3 class="h5 font-display fw-bold text-light">Trade-In & Exchange</h3>
                    <p class="text-muted fs-7 mb-0">Valuate old smartphones, inspect device conditions, and process seamless trade-in discounts on new purchases.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <div class="fs-1 text-primary mb-3"><i class="bi bi-graph-up-arrow"></i></div>
                    <h3 class="h5 font-display fw-bold text-light">Real-Time Reports & Analytics</h3>
                    <p class="text-muted fs-7 mb-0">Comprehensive profit & loss analytics, daily sales summaries, fast-moving items, and automated email alerts.</p>
                </div>
            </div>
        </div>
    </div>
</div>
