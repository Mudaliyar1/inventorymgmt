function renderBatchTable() {
    const tbody = document.getElementById('batchTableBody');
    const badge = document.getElementById('batchCountBadge');
    const btnBadge = document.getElementById('btnBatchCount');
    const submitBtn = document.getElementById('submitBatchBtn');

    badge.innerText = batchScannedDevices.length;
    btnBadge.innerText = batchScannedDevices.length;
    submitBtn.disabled = (batchScannedDevices.length === 0);

    if (batchScannedDevices.length === 0) {
        tbody.innerHTML = `
            <tr id="emptyBatchRow">
                <td colspan="6" class="text-center py-5 text-muted">
                    <i class="bi bi-upc-scan fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    No mobile devices scanned yet. Click <strong>"Start Camera Batch Scan"</strong> above.
                </td>
            </tr>`;
        return;
    }

    let html = '';
    batchScannedDevices.forEach((dev, idx) => {
        html += `
            <tr>
                <td class="fw-bold">${idx + 1}</td>
                <td>
                    <span class="font-monospace fw-bold text-primary">${dev.IMEI1}</span>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="Optional IMEI 2" value="${dev.IMEI2 || ''}" onchange="updateBatchDevice(${idx}, 'IMEI2', this.value)">
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="Serial (Optional)" value="${dev.SerialNumber || ''}" onchange="updateBatchDevice(${idx}, 'SerialNumber', this.value)">
                </td>
                <td>
                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check2-circle me-1"></i>Verified Ready</span>
                </td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeBatchDevice(${idx})">
                        <i class="bi bi-trash3"></i>
                    </button>
                </td>
            </tr>`;
    });
    tbody.innerHTML = html;
}

function updateBatchDevice(index, field, val) {
    if (batchScannedDevices[index]) {
        batchScannedDevices[index][field] = val.trim();
    }
}

function removeBatchDevice(index) {
    batchScannedDevices.splice(index, 1);
    renderBatchTable();
    updateModalBatchCount();
}

function clearBatchList() {
    if (batchScannedDevices.length === 0) return;
    if (confirm('Are you sure you want to clear all scanned devices in this batch?')) {
        batchScannedDevices = [];
        renderBatchTable();
        updateModalBatchCount();
    }
}

// BATCH SUBMISSION TO SUPPLIER ENDPOINT
async function submitBatchStockIn() {
    if (batchScannedDevices.length === 0) return;

    const productId = document.getElementById('BatchProductId').value;
    if (!productId) {
        alert('Please select a Mobile Model first!');
        return;
    }

    const payload = {
        ProductId: productId,
        SupplierName: document.getElementById('BatchSupplierName').value,
        VariantId: document.getElementById('BatchVariantId')?.value || '',
        ColorId: document.getElementById('BatchColorId')?.value || '',
        Variant: document.getElementById('BatchVariantName')?.value || '',
        Color: document.getElementById('BatchColorName')?.value || '',
        PurchasePrice: parseFloat(document.getElementById('BatchPurchasePrice').value) || 0,
        SellingPrice: parseFloat(document.getElementById('BatchSellingPrice').value) || 0,
        Devices: batchScannedDevices
    };

    const btn = document.getElementById('submitBatchBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Receiving Devices into Inventory...';

    try {
        const res = await fetch('@Url.Action("StockInDeviceBatch", "SupplierDashboard")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert('Error receiving batch: ' + (data.message || 'Validation failed'));
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-check2-circle me-1"></i> Finish & Add Batch to Stock (${batchScannedDevices.length})`;
        }
    } catch (err) {
        console.error('Batch submission error:', err);
        alert('Failed to submit batch: ' + err);
        btn.disabled = false;
        btn.innerHTML = `<i class="bi bi-check2-circle me-1"></i> Finish & Add Batch to Stock (${batchScannedDevices.length})`;
    }
}

// IMEI VALIDATION (LUHN & DATABASE)
async function validateImeiInput(input, helpId) {
    const val = input.value.trim();
    const help = document.getElementById(helpId);
    if (!help) return;

    if (!val) {
        help.innerHTML = '';
        input.classList.remove('is-valid', 'is-invalid');
        return;
    }

    if (!/^\d{14,16}$/.test(val)) {
        help.innerHTML = '<span class="text-danger"><i class="bi bi-x-circle me-1"></i>IMEI must be 14-16 digits numeric</span>';
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
        return;
    }

    help.innerHTML = '<span class="text-muted"><span class="spinner-border spinner-border-sm me-1"></span>Checking uniqueness...</span>';
    try {
        const res = await fetch(`/Stock/CheckImeiExists?imei=${encodeURIComponent(val)}`);
        const data = await res.json();
        if (data.exists) {
            help.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>IMEI already exists in inventory (${data.status})</span>`;
            input.classList.add('is-invalid');
            input.classList.remove('is-valid');
        } else {
            help.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Valid & Available</span>';
            input.classList.add('is-valid');
            input.classList.remove('is-invalid');
        }
    } catch (e) {
        help.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Format valid</span>';
        input.classList.add('is-valid');
    }
}
</script>
}
