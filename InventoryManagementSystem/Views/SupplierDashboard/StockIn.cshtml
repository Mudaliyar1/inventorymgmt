@model InventoryManagementSystem.ViewModels.SupplierStockInViewModel
@{
    ViewData["Title"] = "Supplier Stock In — Inventory Intake";
    var brands = ViewBag.Brands as List<string> ?? new List<string>();
    var allProductsJson = ViewBag.AllActiveProductsJson as string ?? "[]";
}

<!-- Page Header -->
<div class="ph mb-4">
    <div>
        <h1 class="ph-title"><i class="bi bi-arrow-down-circle me-2" style="color:var(--success)"></i>Supplier Stock In</h1>
        <p class="ph-sub">Receive IMEI-tracked physical mobile units or bulk accessory stock using camera barcode scanner into your vendor catalog.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("StockOut")" class="btn-d btn-outline">
            <i class="bi bi-arrow-up-circle me-1" style="color:var(--danger)"></i> Stock Out
        </a>
        <a href="@Url.Action("Inventory")" class="btn-d btn-outline">
            <i class="bi bi-boxes me-1"></i> Stock Inventory
        </a>
    </div>
</div>

<!-- Stock In KPI Metrics Row -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Total Inflow Units</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;color:var(--success)">
                    <i class="bi bi-box-arrow-in-down" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:var(--success)">@Model.TotalStockInUnits</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Cumulative units received</div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Today's Intake</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;color:#3B82F6">
                    <i class="bi bi-calendar2-check" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:#3B82F6">@Model.TodayStockInUnits</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Units stocked in today</div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Inflow Valuation</span>
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(168,85,247,0.15);display:flex;align-items:center;justify-content:center;color:#A855F7">
                    <i class="bi bi-currency-rupee" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:#A855F7">₹@Model.TotalStockInValuation.ToString("N0")</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Wholesale asset replenishment</div>
        </div>
    </div>

    <div class="col-xl-3 col-sm-6">
        <div class="card-d card-p-lg h-100" style="background:var(--bg-card);border:1px solid var(--border)">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase">Intake Events</span>
                <div style="width:36px;height:36px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary)">
                    <i class="bi bi-clock-history" style="font-size:18px"></i>
                </div>
            </div>
            <div style="font-size:28px;font-weight:800;color:var(--primary)">@Model.TotalTransactionsCount</div>
            <div style="font-size:12px;color:var(--text-muted)" class="mt-1">Recorded intake transactions</div>
        </div>
    </div>
</div>

<!-- Tabs Navigation Matching Shop Admin Format -->
<ul class="nav nav-pills mb-4 gap-2" id="stockInTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active rounded-pill px-4" id="single-imei-tab" data-bs-toggle="tab" data-bs-target="#single-imei-panel" type="button">
            <i class="bi bi-phone me-1"></i> Single Mobile Device (IMEI)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-4" id="bulk-imei-tab" data-bs-toggle="tab" data-bs-target="#bulk-imei-panel" type="button">
            <i class="bi bi-camera-video me-1"></i> Bulk Receive Mobile Devices (Camera Batch Scan)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-4" id="bulk-tab" data-bs-toggle="tab" data-bs-target="#bulk-panel" type="button">
            <i class="bi bi-boxes me-1"></i> Bulk Accessory Stock In
        </button>
    </li>
</ul>

<div class="tab-content" id="stockInTabContent">
    <!-- PANEL 1: SINGLE IMEI DEVICE STOCK IN -->
    <div class="tab-pane fade show active" id="single-imei-panel">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <form action="@Url.Action("StockInDevice", "SupplierDashboard")" method="post" id="singleDeviceForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Select Brand <span class="text-secondary fw-normal">(Filter Models)</span></label>
                            <select id="SingleBrandSelect" class="form-select" onchange="onSingleBrandChanged(this.value)">
                                <option value="">-- All Brands --</option>
                                @if (brands != null)
                                {
                                    foreach (var b in brands)
                                    {
                                        <option value="@b">@b</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Select Mobile Model <span class="text-danger">*</span></label>
                            <select name="ProductId" id="SingleProductId" class="form-select" required onchange="onSingleProductChanged(this.value)">
                                <option value="">-- Select Product Model --</option>
                                @if (Model.Products != null)
                                {
                                    foreach (var p in Model.Products)
                                    {
                                        <option value="@p.Id">@p.Name (SKU: @p.Code - Qty: @p.CurrentStock) - @(p.IsImeiRequired ? "Requires IMEI" : "Accessory")</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Supplier Vendor Account</label>
                            <input type="text" class="form-control bg-light" value="@(Model.Supplier?.CompanyName ?? "Your Supplier Account")" readonly disabled />
                        </div>

                        <!-- Dynamic Model, Variant & Color Selection -->
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Storage / Variant <span class="text-secondary fw-normal">(For Apple/iOS: Storage only)</span> <span class="text-danger">*</span></label>
                            <select id="SingleVariantSelect" class="form-select" onchange="onSingleVariantChanged(this.value)" required>
                                <option value="">-- Select Mobile Model First --</option>
                            </select>
                            <input type="hidden" name="VariantId" id="SingleVariantId" />
                            <input type="hidden" name="Variant" id="SingleVariantName" />
                            <div id="SingleCustomVariantWrap" class="mt-2" style="display:none">
                                <input type="text" id="SingleCustomVariant" class="form-control form-control-sm" placeholder="e.g. 128GB, 256GB (or 12GB / 256GB)" oninput="onSingleCustomVariantInput(this.value)" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Color <span class="text-danger">*</span></label>
                            <select id="SingleColorSelect" class="form-select" onchange="onSingleColorChanged(this.value)" required>
                                <option value="">-- Select Variant First --</option>
                            </select>
                            <input type="hidden" name="ColorId" id="SingleColorId" />
                            <input type="hidden" name="Color" id="SingleColorName" />
                            <div id="SingleCustomColorWrap" class="mt-2" style="display:none">
                                <input type="text" id="SingleCustomColor" class="form-control form-control-sm" placeholder="e.g. Phantom Black, Pink gold" oninput="onSingleCustomColorInput(this.value)" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Serial Number</label>
                            <input type="text" name="SerialNumber" class="form-control font-monospace" placeholder="Serial Number (Optional)">
                        </div>

                        <!-- Live Stock & Specs Banner -->
                        <div class="col-12" id="SingleVariantStockBanner" style="display:none">
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:rgba(59, 130, 246, 0.08);border:1px solid rgba(59, 130, 246, 0.25)">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:36px;height:36px;border-radius:10px;background:#3b82f6;color:#fff;display:flex;align-items:center;justify-content:center">
                                        <i class="bi bi-phone"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold text-primary" id="SingleBannerTitle">Selected Mobile Variant</span>
                                        <div class="small text-muted" id="SingleBannerDetails">Color &amp; Specifications</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-7 fw-bold" id="SingleBannerStockBadge">
                                        <i class="bi bi-box-seam me-1"></i> Current Stock: 0 Units
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- IMEI 1 with Scan Button -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Primary IMEI (IMEI 1) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" name="IMEI1" id="SingleIMEI1" required class="form-control font-monospace fw-bold" placeholder="15-digit IMEI 1" onchange="validateImeiInput(this, 'SingleIMEI1Help')">
                                <button type="button" class="btn btn-outline-primary" onclick="openCameraScanner('single_imei1')">
                                    <i class="bi bi-upc-scan me-1"></i> Scan IMEI 1
                                </button>
                            </div>
                            <div id="SingleIMEI1Help" class="form-text small"></div>
                        </div>

                        <!-- IMEI 2 with Scan Button -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Secondary IMEI (IMEI 2 - Dual SIM)</label>
                            <div class="input-group">
                                <input type="text" name="IMEI2" id="SingleIMEI2" class="form-control font-monospace" placeholder="15-digit IMEI 2" onchange="validateImeiInput(this, 'SingleIMEI2Help')">
                                <button type="button" class="btn btn-outline-secondary" onclick="openCameraScanner('single_imei2')">
                                    <i class="bi bi-upc-scan me-1"></i> Scan IMEI 2
                                </button>
                            </div>
                            <div id="SingleIMEI2Help" class="form-text small"></div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Wholesale Cost (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" name="PurchasePrice" id="SinglePurchasePrice" class="form-control font-monospace fw-bold" placeholder="0.00" required>
                            <div class="form-text small text-muted">Auto-suggested from product pricing, editable for this IMEI</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Retail Selling Price (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" name="SellingPrice" id="SingleSellingPrice" class="form-control font-monospace fw-bold text-success" placeholder="0.00" required>
                            <div class="form-text small text-muted">Auto-suggested from retail shop pricing, editable for this IMEI</div>
                        </div>
                    </div>
                    <hr class="my-4">
                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-light rounded-pill px-4">Reset</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4"><i class="bi bi-plus-circle me-1"></i> Stock In Device</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- PANEL 2: BULK RECEIVE MOBILE DEVICES (CAMERA BATCH SCAN) -->
    <div class="tab-pane fade" id="bulk-imei-panel">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-layers me-2"></i>Batch Header & Pricing Setup</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Select Brand <span class="text-secondary fw-normal">(Filter Models)</span></label>
                        <select id="BatchBrandSelect" class="form-select" onchange="onBatchBrandChanged(this.value)">
                            <option value="">-- All Brands --</option>
                            @if (brands != null)
                            {
                                foreach (var b in brands)
                                {
                                    <option value="@b">@b</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Select Mobile Model <span class="text-danger">*</span></label>
                        <select id="BatchProductId" class="form-select" required onchange="onBatchProductChanged(this.value)">
                            <option value="">-- Select Product Model --</option>
                            @if (Model.Products != null)
                            {
                                foreach (var p in Model.Products)
                                {
                                    <option value="@p.Id">@p.Name (SKU: @p.Code - Qty: @p.CurrentStock) - @(p.IsImeiRequired ? "Requires IMEI" : "Accessory")</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Supplier Vendor Account</label>
                        <input type="text" id="BatchSupplierName" class="form-control bg-light" value="@(Model.Supplier?.CompanyName ?? "Your Supplier Account")" readonly disabled />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Storage / Variant <span class="text-secondary fw-normal">(For Apple/iOS: Storage only)</span> <span class="text-danger">*</span></label>
                        <select id="BatchVariantSelect" class="form-select" onchange="onBatchVariantChanged(this.value)" required>
                            <option value="">-- Select Model First --</option>
                        </select>
                        <input type="hidden" id="BatchVariantId" />
                        <input type="hidden" id="BatchVariantName" />
                        <div id="BatchCustomVariantWrap" class="mt-2" style="display:none">
                            <input type="text" id="BatchCustomVariant" class="form-control form-control-sm" placeholder="e.g. 128GB, 256GB (or 12GB / 256GB)" oninput="onBatchCustomVariantInput(this.value)" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Color <span class="text-danger">*</span></label>
                        <select id="BatchColorSelect" class="form-select" onchange="onBatchColorChanged(this.value)" required>
                            <option value="">-- Select Variant First --</option>
                        </select>
                        <input type="hidden" id="BatchColorId" />
                        <input type="hidden" id="BatchColorName" />
                        <div id="BatchCustomColorWrap" class="mt-2" style="display:none">
                            <input type="text" id="BatchCustomColor" class="form-control form-control-sm" placeholder="e.g. Phantom Black, Pink gold" oninput="onBatchCustomColorInput(this.value)" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Wholesale Unit Cost (₹)</label>
                        <input type="number" step="0.01" id="BatchPurchasePrice" class="form-control font-monospace" placeholder="0.00">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Retail Selling Price (₹)</label>
                        <input type="number" step="0.01" id="BatchSellingPrice" class="form-control font-monospace fw-bold text-success" placeholder="0.00">
                    </div>

                    <!-- Batch Live Stock Banner -->
                    <div class="col-12" id="BatchVariantStockBanner" style="display:none">
                        <div class="p-3 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:rgba(59, 130, 246, 0.08);border:1px solid rgba(59, 130, 246, 0.25)">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:36px;height:36px;border-radius:10px;background:#3b82f6;color:#fff;display:flex;align-items:center;justify-content:center">
                                    <i class="bi bi-boxes"></i>
                                </div>
                                <div>
                                    <span class="fw-bold text-primary" id="BatchBannerTitle">Selected Mobile Variant</span>
                                    <div class="small text-muted" id="BatchBannerDetails">Color &amp; Specifications</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-7 fw-bold" id="BatchBannerStockBadge">
                                    <i class="bi bi-box-seam me-1"></i> Current Stock: 0 Units
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2" onclick="startBulkBatchCameraScan()">
                            <i class="bi bi-camera-video-fill me-2"></i> Start Camera Batch Scan
                        </button>
                        <span class="text-muted small ms-2">Scan mobile box barcodes sequentially</span>
                    </div>
                    <div class="badge bg-primary-subtle text-primary border px-3 py-2 rounded-pill fs-6 fw-bold">
                        Scanned Devices: <span id="batchCountBadge">0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- BATCH SCANNED LIST TABLE -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-list-check me-2"></i>Scanned Mobile Units Checklist</h6>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="clearBatchList()">Clear Batch</button>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small uppercase">
                            <tr>
                                <th>#</th>
                                <th>Primary IMEI (IMEI 1)</th>
                                <th>Secondary IMEI (IMEI 2)</th>
                                <th>Serial Number</th>
                                <th>Status Validation</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="batchTableBody">
                            <tr id="emptyBatchRow">
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-upc-scan fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No mobile devices scanned yet. Click <strong>"Start Camera Batch Scan"</strong> above.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" id="submitBatchBtn" class="btn btn-success rounded-pill px-5 py-2 fw-bold" onclick="submitBatchStockIn()" disabled>
                        <i class="bi bi-check2-circle me-1"></i> Finish & Add Batch to Stock (<span id="btnBatchCount">0</span>)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- PANEL 3: BULK ACCESSORY STOCK IN -->
    <div class="tab-pane fade" id="bulk-panel">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <form action="@Url.Action("StockIn", "SupplierDashboard")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="stockInMode" value="Quantity" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Select Brand <span class="text-secondary fw-normal">(Filter Items)</span></label>
                            <select id="AccessoryBrandSelect" class="form-select" onchange="onAccessoryBrandChanged(this.value)">
                                <option value="">-- All Brands --</option>
                                @if (brands != null)
                                {
                                    foreach (var b in brands)
                                    {
                                        <option value="@b">@b</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Select Product <span class="text-danger">*</span></label>
                            <select name="ProductId" class="form-select" id="AccessoryProductId" required onchange="onAccessoryProductChanged(this.value)">
                                <option value="">-- Select Product --</option>
                                @if (Model.Products != null)
                                {
                                    foreach (var p in Model.Products)
                                    {
                                        <option value="@p.Id">@p.Name (SKU: @p.Code - Qty: @p.CurrentStock) - @(p.IsImeiRequired ? "Requires IMEI" : "Accessory")</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Supplier Vendor Account</label>
                            <input type="text" class="form-control bg-light" value="@(Model.Supplier?.CompanyName ?? "Your Supplier Account")" readonly disabled />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Storage / Variant <span class="text-secondary fw-normal">(For Apple/iOS: Storage only)</span></label>
                            <select id="AccessoryVariantSelect" class="form-select" onchange="onAccessoryVariantChanged(this.value)">
                                <option value="">-- Standard / Base Variant --</option>
                            </select>
                            <input type="hidden" name="VariantId" id="AccessoryVariantId" />
                            <input type="hidden" name="VariantName" id="AccessoryVariantName" />
                            <div id="AccessoryCustomVariantWrap" class="mt-2" style="display:none">
                                <input type="text" id="AccessoryCustomVariant" class="form-control form-control-sm" placeholder="e.g. 128GB, 256GB (or 12GB / 256GB)" oninput="onAccessoryCustomVariantInput(this.value)" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Color</label>
                            <select id="AccessoryColorSelect" class="form-select" onchange="onAccessoryColorChanged(this.value)">
                                <option value="">-- Standard / Default Color --</option>
                            </select>
                            <input type="hidden" name="ColorId" id="AccessoryColorId" />
                            <input type="hidden" name="ColorName" id="AccessoryColorName" />
                            <div id="AccessoryCustomColorWrap" class="mt-2" style="display:none">
                                <input type="text" id="AccessoryCustomColor" class="form-control form-control-sm" placeholder="e.g. Phantom Black, Desert Titanium" oninput="onAccessoryCustomColorInput(this.value)" />
                            </div>
                        </div>

                        <!-- Accessory Live Stock Banner -->
