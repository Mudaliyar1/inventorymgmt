</div>

<!-- Stock In Audit History Table -->
<div class="card-d card-p mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
    <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-3 mb-3 gap-2" style="border-color:var(--border)!important">
        <div>
            <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-clock-history me-2"></i>Recent Stock In Activity & Audit Log</h6>
            <span class="text-muted small">Displaying recent inflow transactions for your supplied products.</span>
        </div>
        <form method="get" action="@Url.Action("StockIn")" class="d-flex gap-2">
            <div class="search-pill" style="max-width:280px">
                <i class="bi bi-search search-pill-icon"></i>
                <input type="text" name="search" value="@Model.SearchQuery" class="search-pill-input" placeholder="Filter product or reason..." />
            </div>
            <button type="submit" class="btn btn-sm btn-outline-primary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchQuery))
            {
                <a href="@Url.Action("StockIn")" class="btn btn-sm btn-outline-secondary">Clear</a>
            }
        </form>
    </div>

    @if (Model.Transactions == null || !Model.Transactions.Any())
    {
        <div class="text-center py-5">
            <div style="width:60px;height:60px;border-radius:50%;background:var(--bg-tertiary);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:var(--text-muted)">
                <i class="bi bi-inbox" style="font-size:28px"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">No Stock In Transactions Recorded Yet</h6>
            <p class="text-muted small mb-0">Use the form above to record your first stock intake.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0" style="font-size:14px">
                <thead>
                    <tr class="table-light">
                        <th class="ps-3">Date & Time (IST)</th>
                        <th>Product Name & Specs</th>
                        <th>Units Added</th>
                        <th>Stock Transition</th>
                        <th>Intake Reason / Remarks</th>
                        <th>Attributed To</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td class="ps-3 text-muted">
                                @t.Timestamp.ToIst().ToString("dd-MMM-yyyy")
                                <br /><small style="font-size:11px">@t.Timestamp.ToIst().ToString("hh:mm tt IST")</small>
                            </td>
                            <td>
                                <strong class="text-dark d-block">@t.ProductName</strong>
                                @if (!string.IsNullOrEmpty(t.ProductCode))
                                {
                                    <small class="text-muted font-monospace">SKU: @t.ProductCode</small>
                                }
                                @if (!string.IsNullOrEmpty(t.IMEI))
                                {
                                    <small class="badge bg-info-subtle text-info font-monospace ms-1">IMEI: @t.IMEI</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success fw-bold px-2 py-1">
                                    +@t.Quantity Units
                                </span>
                            </td>
                            <td>
                                <span class="text-muted">@t.PreviousStock</span>
                                <i class="bi bi-arrow-right mx-1 text-success"></i>
                                <strong class="text-dark">@t.CurrentStock</strong>
                            </td>
                            <td>
                                <span class="d-block text-dark">@(string.IsNullOrWhiteSpace(t.Reason) ? "Factory Stock In" : t.Reason)</span>
                            </td>
                            <td>
                                <small class="text-muted">@(string.IsNullOrWhiteSpace(t.ExecutedBy) ? "Supplier" : t.ExecutedBy)</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex align-items-center justify-content-between pt-3 mt-2 border-top" style="border-color:var(--border)!important">
                <span class="text-muted small">Showing Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalFilteredCount total items)</span>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("StockIn", new { search = Model.SearchQuery, page = Model.CurrentPage - 1 })">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(Model.CurrentPage == p ? "active" : "")">
                            <a class="page-link" href="@Url.Action("StockIn", new { search = Model.SearchQuery, page = p })">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("StockIn", new { search = Model.SearchQuery, page = Model.CurrentPage + 1 })">Next</a>
                    </li>
                </ul>
            </div>
        }
    }
</div>

@section Scripts {
<script>
let html5QrcodeScanner = null;
let currentScanTargetMode = 'single_imei1';
let batchScannedDevices = [];
let singleProductVariants = [];
let batchProductVariants = [];
let accessoryProductVariants = [];

const allActiveProducts = @Html.Raw(allProductsJson);

function populateProductDropdown(selectEl, products, placeholder, selectedValue) {
    if (!selectEl) return;
    let html = `<option value="">${placeholder}</option>`;
    products.forEach(p => {
        const isSel = (p.id === selectedValue) ? ' selected' : '';
        html += `<option value="${p.id}"${isSel}>${p.displayText}</option>`;
    });
    selectEl.innerHTML = html;
}

function onSingleBrandChanged(brand) {
    const prodSelect = document.getElementById('SingleProductId');
    const currentVal = prodSelect.value;
    let filtered = allActiveProducts;
    if (brand) {
        filtered = allActiveProducts.filter(p => (p.brand || '').toLowerCase() === brand.toLowerCase());
    }
    const matchCurrent = filtered.some(p => p.id === currentVal);
    populateProductDropdown(prodSelect, filtered, '-- Select Product Model --', matchCurrent ? currentVal : '');
    if (!matchCurrent) {
        prodSelect.value = '';
        onSingleProductChanged('');
    }
}

function onBatchBrandChanged(brand) {
    const prodSelect = document.getElementById('BatchProductId');
    const currentVal = prodSelect.value;
    let filtered = allActiveProducts;
    if (brand) {
        filtered = allActiveProducts.filter(p => (p.brand || '').toLowerCase() === brand.toLowerCase());
    }
    const matchCurrent = filtered.some(p => p.id === currentVal);
    populateProductDropdown(prodSelect, filtered, '-- Select Product Model --', matchCurrent ? currentVal : '');
    if (!matchCurrent) {
        prodSelect.value = '';
        onBatchProductChanged('');
    }
}

function onAccessoryBrandChanged(brand) {
    const prodSelect = document.getElementById('AccessoryProductId');
    const currentVal = prodSelect.value;
    let filtered = allActiveProducts;
    if (brand) {
        filtered = allActiveProducts.filter(p => (p.brand || '').toLowerCase() === brand.toLowerCase());
    }
    const matchCurrent = filtered.some(p => p.id === currentVal);
    populateProductDropdown(prodSelect, filtered, '-- Select Product --', matchCurrent ? currentVal : '');
    if (!matchCurrent) {
        prodSelect.value = '';
        onAccessoryProductChanged('');
    }
}

// SINGLE DEVICE CASCADE
async function onSingleProductChanged(productId) {
    const variantSelect = document.getElementById('SingleVariantSelect');
    const colorSelect = document.getElementById('SingleColorSelect');
    const banner = document.getElementById('SingleVariantStockBanner');
    const customVarWrap = document.getElementById('SingleCustomVariantWrap');
    const customColorWrap = document.getElementById('SingleCustomColorWrap');
    
    document.getElementById('SingleVariantId').value = '';
    document.getElementById('SingleVariantName').value = '';
    document.getElementById('SingleColorId').value = '';
    document.getElementById('SingleColorName').value = '';
    if (customVarWrap) customVarWrap.style.display = 'none';
    if (customColorWrap) customColorWrap.style.display = 'none';
    if (banner) banner.style.display = 'none';

    if (productId) {
        const prodObj = allActiveProducts.find(p => p.id === productId);
        if (prodObj && prodObj.brand) {
            const brandSelect = document.getElementById('SingleBrandSelect');
            if (brandSelect && brandSelect.value !== prodObj.brand) {
                brandSelect.value = prodObj.brand;
            }
        }
    }

    if (!productId) {
        variantSelect.innerHTML = '<option value="">-- Select Mobile Model First --</option>';
        colorSelect.innerHTML = '<option value="">-- Select Variant First --</option>';
        return;
    }

    variantSelect.innerHTML = '<option value="">Loading variants...</option>';
    colorSelect.innerHTML = '<option value="">-- Select Variant First --</option>';

    try {
        let res = await fetch(`/SupplierDashboard/GetProductVariants?productId=${encodeURIComponent(productId)}`);
        if (!res.ok) {
            res = await fetch(`/Product/GetProductVariants?productId=${encodeURIComponent(productId)}`);
        }
        singleProductVariants = await res.json();

        if (singleProductVariants && singleProductVariants.length > 0) {
            let options = '<option value="">-- Select Storage / Hardware Variant --</option>';
            singleProductVariants.forEach(v => {
                const stockText = v.availableStock !== undefined ? ` (Stock: ${v.availableStock} Units)` : '';
                options += `<option value="${v.variantId}">${v.displayVariant}${stockText}</option>`;
            });
            options += '<option value="__custom__">+ Other / Custom Variant</option>';
            variantSelect.innerHTML = options;

            if (singleProductVariants.length === 1) {
                variantSelect.value = singleProductVariants[0].variantId;
                onSingleVariantChanged(singleProductVariants[0].variantId);
            }
        } else {
            variantSelect.innerHTML = '<option value="default-variant">Standard Variant</option><option value="__custom__">+ Enter Custom Variant</option>';
            variantSelect.value = 'default-variant';
            onSingleVariantChanged('default-variant');
        }
    } catch (err) {
        console.error('Error fetching product variants:', err);
        variantSelect.innerHTML = '<option value="default-variant">Standard Variant</option><option value="__custom__">+ Enter Custom Variant</option>';
        variantSelect.value = 'default-variant';
        onSingleVariantChanged('default-variant');
    }
}

function onSingleVariantChanged(variantId) {
    const colorSelect = document.getElementById('SingleColorSelect');
    const customVarWrap = document.getElementById('SingleCustomVariantWrap');
    const customColorWrap = document.getElementById('SingleCustomColorWrap');
    const banner = document.getElementById('SingleVariantStockBanner');
    const purchaseInput = document.getElementById('SinglePurchasePrice');
    const sellingInput = document.getElementById('SingleSellingPrice');

    document.getElementById('SingleColorId').value = '';
    document.getElementById('SingleColorName').value = '';
    if (customColorWrap) customColorWrap.style.display = 'none';

    if (variantId === '__custom__') {
        if (customVarWrap) customVarWrap.style.display = 'block';
        document.getElementById('SingleVariantId').value = '';
        document.getElementById('SingleVariantName').value = document.getElementById('SingleCustomVariant')?.value || '';
        colorSelect.innerHTML = '<option value="__custom__">+ Enter Custom Color</option>';
        onSingleColorChanged('__custom__');
        if (banner) banner.style.display = 'none';
        return;
    }

    if (customVarWrap) customVarWrap.style.display = 'none';

    let selectedVariant = singleProductVariants.find(v => v.variantId === variantId);
    if (!selectedVariant && variantId === 'default-variant') {
        selectedVariant = {
            variantId: 'default-variant',
            displayVariant: 'Standard Variant',
            colors: [{ colorId: 'default-color', name: 'Standard' }]
        };
    }

    if (!selectedVariant) {
        colorSelect.innerHTML = '<option value="">-- Select Variant First --</option>';
        if (banner) banner.style.display = 'none';
        return;
    }

    document.getElementById('SingleVariantId').value = selectedVariant.variantId || '';
    document.getElementById('SingleVariantName').value = selectedVariant.displayVariant || '';

    if (selectedVariant.purchasePrice && purchaseInput) {
        purchaseInput.value = selectedVariant.purchasePrice;
    }
    if (selectedVariant.sellingPrice && sellingInput) {
        sellingInput.value = selectedVariant.sellingPrice;
    }

    if (selectedVariant.colors && selectedVariant.colors.length > 0) {
        let options = '<option value="">-- Select Color Option --</option>';
        selectedVariant.colors.forEach(c => {
            const stockText = c.availableStock !== undefined ? ` (Stock: ${c.availableStock} Units)` : '';
            options += `<option value="${c.colorId}">${c.name}${stockText}</option>`;
        });
        options += '<option value="__custom__">+ Other / Custom Color</option>';
        colorSelect.innerHTML = options;

        if (selectedVariant.colors.length === 1) {
            colorSelect.value = selectedVariant.colors[0].colorId;
            onSingleColorChanged(selectedVariant.colors[0].colorId);
        }
    } else {
        colorSelect.innerHTML = '<option value="default-color">Standard Color</option><option value="__custom__">+ Enter Custom Color</option>';
        colorSelect.value = 'default-color';
        onSingleColorChanged('default-color');
    }

    updateSingleStockBanner(selectedVariant, null);
}

function onSingleCustomVariantInput(val) {
    document.getElementById('SingleVariantName').value = val;
}

function onSingleColorChanged(colorId) {
    const customColorWrap = document.getElementById('SingleCustomColorWrap');
    const purchaseInput = document.getElementById('SinglePurchasePrice');
    const sellingInput = document.getElementById('SingleSellingPrice');

    if (colorId === '__custom__') {
        if (customColorWrap) customColorWrap.style.display = 'block';
        document.getElementById('SingleColorId').value = '';
        document.getElementById('SingleColorName').value = document.getElementById('SingleCustomColor')?.value || '';
        return;
    }

    if (customColorWrap) customColorWrap.style.display = 'none';

    const variantId = document.getElementById('SingleVariantSelect').value;
    const selectedVariant = singleProductVariants.find(v => v.variantId === variantId);
    if (!selectedVariant) return;

    const selectedColor = (selectedVariant.colors || []).find(c => c.colorId === colorId);
    if (!selectedColor) return;

    document.getElementById('SingleColorId').value = selectedColor.colorId || '';
    document.getElementById('SingleColorName').value = selectedColor.name || '';

    if (selectedColor.purchasePrice && purchaseInput) {
        purchaseInput.value = selectedColor.purchasePrice;
    }
    if (selectedColor.sellingPrice && sellingInput) {
        sellingInput.value = selectedColor.sellingPrice;
    }

    updateSingleStockBanner(selectedVariant, selectedColor);
}

function onSingleCustomColorInput(val) {
    document.getElementById('SingleColorName').value = val;
}

function updateSingleStockBanner(variant, color) {
    const banner = document.getElementById('SingleVariantStockBanner');
    if (!banner) return;
    if (!variant) {
        banner.style.display = 'none';
        return;
    }

    const titleEl = document.getElementById('SingleBannerTitle');
    const detailsEl = document.getElementById('SingleBannerDetails');
    const badgeEl = document.getElementById('SingleBannerStockBadge');

    const variantName = variant.displayVariant || 'Standard Variant';
    const colorName = color ? color.name : 'All Colors';
    const stockQty = color ? (color.availableStock || 0) : (variant.availableStock || 0);

    titleEl.innerText = `${variantName} · ${colorName}`;
    detailsEl.innerText = `Wholesale: ₹${variant.purchasePrice?.toLocaleString() || 0} | Retail: ₹${variant.sellingPrice?.toLocaleString() || 0}`;
    badgeEl.innerHTML = `<i class="bi bi-box-seam me-1"></i> Current Stock: ${stockQty} Units`;

    banner.style.display = 'block';
}

// BATCH CASCADE
async function onBatchProductChanged(productId) {
    const variantSelect = document.getElementById('BatchVariantSelect');
