// AUDIO FEEDBACK
let audioContext = null;
function playScanSound(success = true) {
    try {
        if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
        if (audioContext.state === 'suspended') audioContext.resume();

        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();
        osc.connect(gain);
        gain.connect(audioContext.destination);

        if (success) {
            osc.frequency.setValueAtTime(880, audioContext.currentTime);
            osc.frequency.setValueAtTime(1760, audioContext.currentTime + 0.08);
            gain.gain.setValueAtTime(0.3, audioContext.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.25);
            osc.start();
            osc.stop(audioContext.currentTime + 0.25);
        } else {
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(300, audioContext.currentTime);
            osc.frequency.setValueAtTime(150, audioContext.currentTime + 0.1);
            gain.gain.setValueAtTime(0.4, audioContext.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioContext.currentTime + 0.3);
            osc.start();
            osc.stop(audioContext.currentTime + 0.3);
        }
    } catch (e) {
        console.warn('Audio feedback failed:', e);
    }
}

// CAMERA SCANNER ENGINE
async function openCameraScanner(targetMode) {
    currentScanTargetMode = targetMode;
    const modalEl = document.getElementById('cameraScannerModal');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    const subtitle = document.getElementById('scannerSubtitle');
    const btnNext = document.getElementById('btnNextScan');
    const batchStatus = document.getElementById('batchScanStatusText');

    if (targetMode === 'bulk_batch') {
        subtitle.innerText = 'Continuous Batch Scan Mode: Scan consecutive device barcodes';
        btnNext.style.display = 'inline-block';
        batchStatus.style.display = 'block';
        updateModalBatchCount();
    } else {
        subtitle.innerText = `Scan single barcode for ${targetMode === 'single_imei1' ? 'Primary IMEI 1' : 'Secondary IMEI 2'}`;
        btnNext.style.display = 'none';
        batchStatus.style.display = 'none';
    }

    setScannerFeedback('info', 'Initializing high-speed camera engine...');
    await initCameraEngine();
}

function updateModalBatchCount() {
    const el = document.getElementById('modalBatchCount');
    if (el) el.innerText = batchScannedDevices.length;
}

function closeCameraScanner() {
    stopCameraEngine();
    const modalEl = document.getElementById('cameraScannerModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();
}

async function initCameraEngine() {
    try {
        const cameras = await Html5Qrcode.getCameras();
        const select = document.getElementById('cameraSourceSelect');
        select.innerHTML = '';

        if (!cameras || cameras.length === 0) {
            setScannerFeedback('warning', 'No cameras detected. Please connect a webcam or use photo upload.');
            return;
        }

        let backCameraId = cameras[0].id;
        cameras.forEach(cam => {
            const opt = document.createElement('option');
            opt.value = cam.id;
            opt.text = cam.label || `Camera ${select.length + 1}`;
            if (cam.label.toLowerCase().includes('back') || cam.label.toLowerCase().includes('environment') || cam.label.toLowerCase().includes('rear')) {
                backCameraId = cam.id;
                opt.selected = true;
            }
            select.appendChild(opt);
        });

        select.onchange = () => {
            stopCameraEngine().then(() => startScannerWithCamera(select.value));
        };

        await startScannerWithCamera(backCameraId);
    } catch (err) {
        console.error('Camera init error:', err);
        setScannerFeedback('danger', 'Camera permission denied or not supported. Use manual barcode file upload.');
    }
}

async function startScannerWithCamera(cameraId) {
    if (html5QrcodeScanner) {
        await stopCameraEngine();
    }

    html5QrcodeScanner = new Html5Qrcode("html5-qr-reader");

    const config = {
        fps: 20,
        qrbox: { width: 350, height: 180 },
        aspectRatio: 1.777778,
        experimentalFeatures: {
            useBarCodeDetectorIfSupported: true
        }
    };

    try {
        await html5QrcodeScanner.start(
            cameraId,
            config,
            (decodedText, decodedResult) => {
                handleScannedBarcode(decodedText);
            },
            (errorMessage) => {
                // scanning frame error (ignore continuous no-barcode frames)
            }
        );
        setScannerFeedback('success', '<i class="bi bi-camera me-1"></i> Scanner active! Align barcode in center frame.');
    } catch (err) {
        console.error('Scanner start error:', err);
        setScannerFeedback('danger', 'Failed to start camera preview: ' + err);
    }
}

async function stopCameraEngine() {
    if (html5QrcodeScanner) {
        try {
            if (html5QrcodeScanner.isScanning) {
                await html5QrcodeScanner.stop();
            }
            html5QrcodeScanner.clear();
        } catch (e) {
            console.warn('Scanner stop error:', e);
        }
        html5QrcodeScanner = null;
    }
}

let isTorchOn = false;
async function toggleCameraTorch() {
    if (!html5QrcodeScanner || !html5QrcodeScanner.isScanning) return;
    try {
        isTorchOn = !isTorchOn;
        await html5QrcodeScanner.applyVideoConstraints({
            advanced: [{ torch: isTorchOn }]
        });
        document.getElementById('toggleTorchBtn').classList.toggle('btn-warning', isTorchOn);
        document.getElementById('toggleTorchBtn').classList.toggle('btn-outline-warning', !isTorchOn);
    } catch (e) {
        console.warn('Torch not supported:', e);
        alert('Flashlight/Torch is not supported on this camera/device.');
    }
}

async function scanUploadedBarcodeImage(input) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];

    const tempScanner = new Html5Qrcode("html5-qr-reader");
    setScannerFeedback('info', 'Analyzing uploaded image for barcodes...');

    try {
        const text = await tempScanner.scanFile(file, true);
        handleScannedBarcode(text);
    } catch (err) {
        console.error('File scan error:', err);
        setScannerFeedback('danger', 'No barcode found in image. Please try a clearer high-res photo.');
    }
}

function submitManualScan() {
    const input = document.getElementById('manualScannerInput');
    const val = input.value.trim();
    if (!val) return;
    handleScannedBarcode(val);
    input.value = '';
}

// BARCODE DISPATCHER
let scanCooldown = false;
async function handleScannedBarcode(rawBarcode) {
    if (scanCooldown) return;
    scanCooldown = true;
    setTimeout(() => { scanCooldown = false; }, 1200);

    const cleanBarcode = rawBarcode.replace(/[^0-9]/g, '').trim();
    const barcodeToUse = (cleanBarcode.length >= 14 && cleanBarcode.length <= 16) ? cleanBarcode : rawBarcode.trim();

    if (!barcodeToUse) {
        playScanSound(false);
        setScannerFeedback('danger', 'Barcode scanned but content was empty or invalid.');
        return;
    }

    if (currentScanTargetMode === 'single_imei1') {
        playScanSound(true);
        const imeiInput = document.getElementById('SingleIMEI1');
        imeiInput.value = barcodeToUse;
        setScannerFeedback('success', `Detected IMEI 1: <strong>${barcodeToUse}</strong>`);
        validateImeiInput(imeiInput, 'SingleIMEI1Help');
        setTimeout(() => { closeCameraScanner(); }, 800);
    } 
    else if (currentScanTargetMode === 'single_imei2') {
        playScanSound(true);
        const imeiInput = document.getElementById('SingleIMEI2');
        imeiInput.value = barcodeToUse;
        setScannerFeedback('success', `Detected IMEI 2: <strong>${barcodeToUse}</strong>`);
        validateImeiInput(imeiInput, 'SingleIMEI2Help');
        setTimeout(() => { closeCameraScanner(); }, 800);
    } 
    else if (currentScanTargetMode === 'bulk_batch') {
        const existing = batchScannedDevices.find(d => d.IMEI1 === barcodeToUse || d.IMEI2 === barcodeToUse);
        if (existing) {
            playScanSound(false);
            setScannerFeedback('warning', `Duplicate in batch! <strong>${barcodeToUse}</strong> already in checklist.`);
            return;
        }

        setScannerFeedback('info', `Validating <strong>${barcodeToUse}</strong> with database...`);
        try {
            const checkRes = await fetch(`/Stock/CheckImeiExists?imei=${encodeURIComponent(barcodeToUse)}`);
            const checkData = await checkRes.json();

            if (checkData.exists) {
                playScanSound(false);
                setScannerFeedback('danger', `Cannot Add! IMEI <strong>${barcodeToUse}</strong> already exists in inventory (Status: ${checkData.status})`);
                return;
            }

            playScanSound(true);
            batchScannedDevices.push({
                IMEI1: barcodeToUse,
                IMEI2: '',
                SerialNumber: '',
                Valid: true
            });

            renderBatchTable();
            updateModalBatchCount();
            setScannerFeedback('success', `Added to batch: <strong>${barcodeToUse}</strong>. Scan next box...`);
        } catch (e) {
            playScanSound(true);
            batchScannedDevices.push({
                IMEI1: barcodeToUse,
                IMEI2: '',
                SerialNumber: '',
                Valid: true
            });
            renderBatchTable();
            updateModalBatchCount();
            setScannerFeedback('success', `Scanned: <strong>${barcodeToUse}</strong>.`);
        }
    }
}

