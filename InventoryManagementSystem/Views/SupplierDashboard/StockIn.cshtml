            <div class="modal-footer border-0 pt-0 justify-content-between">
                <div class="small fw-semibold text-muted" id="batchScanStatusText">
                    Batch Count: <span id="modalBatchCount" class="badge bg-primary">0</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" id="btnNextScan" class="btn btn-outline-primary rounded-pill px-3" style="display:none;" onclick="prepareNextScan()">
                        <i class="bi bi-arrow-right-circle me-1"></i> Scan Next Device
