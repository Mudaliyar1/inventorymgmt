@model InventoryManagementSystem.Models.SupplierPurchaseReturn
@{
    ViewData["Title"] = "Return Claim #" + Model.ReturnNumber;
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-box-seam me-2" style="color:var(--danger)"></i>Return Claim Details #@Model.ReturnNumber</h1>
        <p class="ph-sub">Submitted by Admin on @Model.CreatedAt.ToIst().ToString("dd-MMM-yyyy hh:mm tt IST")</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Returns","SupplierDashboard")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left me-1"></i> Back to Damaged & Returned Stock Stats
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Details & Items -->
    <div class="col-12 col-lg-8">
        <!-- Claim Info Overview Card -->
        <div class="card-d card-p mb-4">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3" style="border-color:var(--border)!important">
                <div>
                    <span class="badge bg-danger-subtle text-danger me-2 fs-6">Reason: @Model.Reason</span>
                    <span class="badge bg-primary-subtle text-primary fs-6">Resolution: @Model.ResolutionType</span>
                </div>
                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Status: @Model.Status</span>
            </div>

            <div class="row g-3" style="font-size:14px">
                <div class="col-6 col-sm-3">
                    <span class="text-muted d-block mb-1">Return Number</span>
                    <strong class="text-dark">#@Model.ReturnNumber</strong>
                </div>
                <div class="col-6 col-sm-3">
                    <span class="text-muted d-block mb-1">Purchase Order #</span>
                    <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model.PurchaseOrderNumber) ? "N/A" : (Model.PurchaseOrderNumber.StartsWith("#") ? Model.PurchaseOrderNumber : "#" + Model.PurchaseOrderNumber))</strong>
                </div>
                <div class="col-6 col-sm-3">
                    <span class="text-muted d-block mb-1">Returned Qty</span>
                    <strong class="text-dark">@Model.TotalQuantity Units</strong>
                </div>
                <div class="col-6 col-sm-3">
                    <span class="text-muted d-block mb-1">Total Return Value</span>
                    <strong class="text-danger">₹@Model.TotalReturnValue.ToString("N2")</strong>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.AdditionalRemarks))
            {
                <div class="mt-3 p-3 rounded-3" style="background:var(--bg-tertiary)">
                    <span class="fw-bold d-block text-dark mb-1"><i class="bi bi-chat-left-text me-1"></i>Admin Claim Description / Remarks:</span>
                    <p class="mb-0 text-muted" style="white-space:pre-wrap">@Model.AdditionalRemarks</p>
                </div>
            }
        </div>

        <!-- Returned Items Table -->
        <div class="card-d card-p mb-4 p-0 overflow-hidden">
            <div class="p-3 border-bottom" style="border-color:var(--border)!important">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-phone me-2"></i>Returned Products & Specs</h6>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:14px">
                    <thead>
                        <tr class="table-light">
                            <th class="ps-3">Product Name & Specs</th>
                            <th>Brand & Model</th>
                            <th>Unit Price</th>
                            <th>Qty</th>
                            <th>Total Return Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded" style="width:40px;height:40px;object-fit:cover;background:var(--bg-tertiary)" onerror="this.onerror=null;this.src='/images/product-placeholder.png'" />
                                        <div>
                                            <div class="fw-bold text-dark">@item.ProductName</div>
                                            <small class="text-muted">Variant: @(item.Variant ?? "N/A") | Storage: @(item.Storage ?? "N/A") | Color: @(item.Color ?? "N/A")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.Brand @item.ModelName</td>
                                <td>₹@item.UnitPurchasePrice.ToString("N2")</td>
                                <td><span class="badge bg-secondary">@item.Quantity</span></td>
                                <td><strong class="text-danger">₹@item.ReturnValue.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Specific Returned Devices / IMEIs -->
        @if (Model.DeviceDetails != null && Model.DeviceDetails.Any())
        {
            <div class="card-d card-p mb-4">
                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-barcode me-2"></i>Specific Returned Device IMEIs / Serials (@Model.DeviceDetails.Count)</h6>
                <div class="row g-2">
                    @foreach (var dev in Model.DeviceDetails)
                    {
                        <div class="col-12 col-md-6">
                            <div class="p-2 border rounded-3 d-flex align-items-center justify-content-between" style="border-color:var(--border)!important;background:var(--bg-tertiary)">
                                <div>
                                    <strong class="d-block text-dark">IMEI 1: @(dev.IMEI1 ?? "N/A")</strong>
                                    @if (!string.IsNullOrEmpty(dev.IMEI2)) { <small class="text-muted d-block">IMEI 2: @dev.IMEI2</small> }
                                    @if (!string.IsNullOrEmpty(dev.SerialNumber)) { <small class="text-muted d-block">Serial: @dev.SerialNumber</small> }
                                </div>
                                <span class="badge bg-danger-subtle text-danger">@dev.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Actions & Supplier Response Form -->
    <div class="col-12 col-lg-4">
        <!-- Supplier Decision & Action Card -->
        <div class="card-d card-p mb-4">
            <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-gear-fill me-2"></i>Supplier Action & Response</h6>

            @if (Model.Status == InventoryManagementSystem.Models.PurchaseReturnStatus.Submitted || Model.Status == InventoryManagementSystem.Models.PurchaseReturnStatus.SupplierNotified)
            {
                <div class="alert alert-info border-0 rounded-3 mb-3" style="font-size:13px">
                    <i class="bi bi-info-circle me-1"></i> This return request is pending your review. Choose your stock action (Back to Inventory or Damaged / Sent for Repair) and accept or reject below.
                </div>

                <form method="post" action="@Url.Action("AcceptReturn", "SupplierDashboard")" class="mb-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    
                    <!-- Disposition Dropdown -->
                    <div class="mb-3">
                        <label class="form-label text-dark fw-bold" style="font-size:12px">
                            <i class="bi bi-diagram-3 text-primary me-1"></i>Action on Returned Items (Disposition)
                        </label>
                        <select name="disposition" class="form-select form-select-sm" id="dispositionSelector" onchange="updateDispositionHelp(this.value)">
                            <option value="Damaged / Sent for Repair" selected>🛠️ Damaged / Sent for Repair (Quarantine in Damaged Inventory)</option>
                            <option value="Back to Inventory">📦 Back to Inventory (Restock directly to active supplier catalog)</option>
                        </select>
                        <div id="dispositionHelpText" class="mt-2 p-2 rounded-2" style="font-size:11px;background:var(--bg-tertiary);border:1px solid var(--border)">
                            <i class="bi bi-tools text-warning me-1"></i>
                            <strong>Damaged / Sent for Repair:</strong> Deducts stock from shop admin and routes to your <strong>Damaged & Repair Items</strong> ledger. Will <u>not</u> increase your active sellable inventory until repaired.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted fw-semibold" style="font-size:12px">Supplier Acceptance Notes (Optional)</label>
                        <textarea name="supplierNotes" class="form-control form-control-sm" rows="2" placeholder="Notes for admin regarding repair, replacement or refund..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold" onclick="return confirm('Confirm accepting return claim #@Model.ReturnNumber with selected disposition?')">
                        <i class="bi bi-check-circle me-1"></i> Accept Return Request
                    </button>
                </form>

                <hr style="border-color:var(--border)" />

                <form method="post" action="@Url.Action("RejectReturn", "SupplierDashboard")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label text-muted fw-semibold" style="font-size:12px">Rejection Reason (Required)</label>
                        <textarea name="rejectionReason" class="form-control form-control-sm" rows="2" placeholder="Explain why this return claim is being rejected..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Confirm rejecting return claim #@Model.ReturnNumber?')">
                        <i class="bi bi-x-circle me-1"></i> Reject Return Request
                    </button>
                </form>
            }
            else
            {
                <div class="mb-3">
                    <span class="text-muted d-block mb-1">Current Claim Status</span>
                    <strong class="text-dark fs-5">@Model.Status</strong>
                </div>

                <!-- Accepted Disposition Details Box -->
                @if (!string.IsNullOrEmpty(Model.ReturnDisposition))
                {
                    var isBackToInv = Model.ReturnDisposition == InventoryManagementSystem.Models.ReturnDispositionType.BackToInventory;
                    <div class="mb-3 p-3 rounded-3" style="background:@(isBackToInv ? "rgba(16, 185, 129, 0.1)" : "rgba(245, 158, 11, 0.1)");border:1px solid @(isBackToInv ? "rgba(16, 185, 129, 0.3)" : "rgba(245, 158, 11, 0.3)")">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="fw-bold" style="font-size:12px;color:@(isBackToInv ? "#10b981" : "#f59e0b")">
                                <i class="bi @(isBackToInv ? "bi-box-seam" : "bi-tools") me-1"></i>Accepted Disposition
                            </span>
                            <span class="badge @(isBackToInv ? "bg-success" : "bg-warning text-dark")">@Model.ReturnDisposition</span>
                        </div>
                        <div style="font-size:12px;color:var(--text-secondary)">
                            @if (isBackToInv)
                            {
                                <span><i class="bi bi-check2 text-success me-1"></i>Items were restocked directly to your active supplier inventory. Shop admin stock was deducted.</span>
                            }
                            else
                            {
                                <span><i class="bi bi-tools text-warning me-1"></i>Items segregated into Damaged Inventory (not added to sellable stock). Shop stock was deducted.</span>
                            }
                        </div>
                    </div>
                }

                <!-- Damaged Repair Management Quick Actions (if Damaged / Sent for Repair) -->
                @if (Model.ReturnDisposition == InventoryManagementSystem.Models.ReturnDispositionType.DamagedRepair || (!string.IsNullOrEmpty(Model.RepairStatus) && Model.ReturnDisposition != InventoryManagementSystem.Models.ReturnDispositionType.BackToInventory))
                {
                    var repStatus = Model.RepairStatus ?? InventoryManagementSystem.Models.ReturnRepairStatus.UnderRepair;
                    var repBadgeClass = repStatus switch
                    {
                        InventoryManagementSystem.Models.ReturnRepairStatus.RepairedAndRestocked => "bg-success",
                        InventoryManagementSystem.Models.ReturnRepairStatus.Scrapped => "bg-danger",
                        _ => "bg-warning text-dark"
                    };

                    <div class="card-d card-p mb-3 p-3 rounded-3" style="background:var(--bg-tertiary);border:1px solid var(--border)">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold text-dark" style="font-size:12px"><i class="bi bi-wrench-adjustable me-1 text-primary"></i>Repair Lifecycle Status</span>
                            <span class="badge @repBadgeClass">@repStatus</span>
                        </div>

                        @if (repStatus == InventoryManagementSystem.Models.ReturnRepairStatus.RepairedAndRestocked)
                        {
                            <div class="alert alert-success py-2 px-3 mb-2" style="font-size:12px">
                                <i class="bi bi-check-circle-fill me-1"></i> Repaired and restocked to your catalog on @(Model.RepairedAt?.ToIst().ToString("dd-MMM-yyyy hh:mm tt IST") ?? "N/A").
                            </div>
                        }
                        else if (repStatus == InventoryManagementSystem.Models.ReturnRepairStatus.Scrapped)
                        {
                            <div class="alert alert-danger py-2 px-3 mb-2" style="font-size:12px">
                                <i class="bi bi-x-octagon-fill me-1"></i> Items marked as permanently scrapped / written off.
                            </div>
                        }

                        <form method="post" action="@Url.Action("UpdateRepairStatus", "SupplierDashboard")" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                            <div class="mb-2">
                                <label class="form-label text-muted fw-semibold" style="font-size:11px">Update Repair Outcome</label>
                                <select name="newRepairStatus" class="form-select form-select-sm">
                                    <option value="@InventoryManagementSystem.Models.ReturnRepairStatus.UnderRepair" selected="@(repStatus == InventoryManagementSystem.Models.ReturnRepairStatus.UnderRepair ? "selected" : null)">🛠️ Under Repair (Currently being fixed)</option>
                                    <option value="@InventoryManagementSystem.Models.ReturnRepairStatus.RepairedAndRestocked" selected="@(repStatus == InventoryManagementSystem.Models.ReturnRepairStatus.RepairedAndRestocked ? "selected" : null)">✅ Repaired &amp; Restock to Inventory</option>
                                    <option value="@InventoryManagementSystem.Models.ReturnRepairStatus.Scrapped" selected="@(repStatus == InventoryManagementSystem.Models.ReturnRepairStatus.Scrapped ? "selected" : null)">❌ Scrapped / Written Off (Unrepairable)</option>
                                </select>
                            </div>

                            <div class="mb-2">
                                <input type="text" name="repairNotes" class="form-control form-control-sm" placeholder="Repair action notes..." value="@Model.RepairNotes" style="font-size:12px" />
                            </div>

                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                <i class="bi bi-arrow-repeat me-1"></i> Update Repair Status
                            </button>
                        </form>

                        <div class="text-center mt-2">
                            <a href="@Url.Action("DamagedProducts", "SupplierDashboard")" class="text-decoration-none" style="font-size:12px">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Open Damaged Products Ledger
                            </a>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.SupplierNotes))
                {
                    <div class="mb-3 p-3 rounded-3" style="background:var(--bg-tertiary)">
                        <span class="fw-bold d-block text-dark mb-1"><i class="bi bi-sticky me-1"></i>Supplier Notes:</span>
                        <p class="mb-0 text-muted" style="white-space:pre-wrap">@Model.SupplierNotes</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <div class="mb-3 p-3 rounded-3 bg-danger-subtle text-danger">
                        <span class="fw-bold d-block mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Rejection Reason:</span>
                        <p class="mb-0" style="white-space:pre-wrap">@Model.RejectionReason</p>
                    </div>
                }

                <!-- Update Status Form for Processing / Shipped / Completed -->
                <form method="post" action="@Url.Action("UpdatePurchaseReturnStatus", "SupplierDashboard")" class="mt-3 border-top pt-3" style="border-color:var(--border)!important">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label text-muted fw-semibold" style="font-size:12px">Update Processing Status</label>
                        <select name="newStatus" class="form-select form-select-sm">
                            @foreach (var st in InventoryManagementSystem.Models.PurchaseReturnStatus.AllStatuses)
                            {
                                <option value="@st" selected="@(Model.Status == st ? "selected" : null)">@st</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted fw-semibold" style="font-size:12px">Additional Supplier Notes</label>
                        <textarea name="supplierNotes" class="form-control form-control-sm" rows="2">@Model.SupplierNotes</textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-save me-1"></i> Save Status Update
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<script>
    function updateDispositionHelp(val) {
        var box = document.getElementById('dispositionHelpText');
        if (!box) return;
        if (val === 'Back to Inventory') {
            box.innerHTML = '<i class="bi bi-box-seam text-success me-1"></i><strong>Back to Inventory:</strong> Products will be immediately <u>restocked into your supplier catalog</u> inventory and deducted from the shop admin.';
        } else {
            box.innerHTML = '<i class="bi bi-tools text-warning me-1"></i><strong>Damaged / Sent for Repair:</strong> Deducts stock from shop admin and routes items to your <strong>Damaged & Repair Items</strong> ledger. Will <u>not</u> increase your active sellable inventory until repaired.';
        }
    }
</script>

