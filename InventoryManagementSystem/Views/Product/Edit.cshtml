@model ProductEditViewModel
@{
    ViewData["Title"] = "Edit Mobile Product";
}

<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-pencil-square me-2" style="color:var(--primary)"></i>Edit Mobile Product</h1>
        <p class="ph-sub">Update mobile model specifications, pricing, hardware features and category.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","Product")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="productEditForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CurrentImageUrl" />

    <!-- Automatic Mobile Specification Finder Banner -->
    <div class="card-d mb-4 border-primary shadow-sm" style="background: linear-gradient(135deg, rgba(25, 135, 84, 0.05), rgba(13, 202, 240, 0.05)); border: 1px solid rgba(25, 135, 84, 0.3);">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div>
                    <h6 class="mb-1 text-success font-weight-bold"><i class="bi bi-shield-check me-2"></i>Official-Manufacturer-First Specification Finder</h6>
                    <p class="text-muted small mb-0">Search official technical specs automatically or paste a direct specification URL below.</p>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-info" onclick="toggleDirectUrlMode()">
                        <i class="bi bi-link-45deg me-1"></i> Paste Spec URL
                    </button>
                    <button type="button" class="btn btn-sm btn-success" onclick="searchOnlineSpecs(false)">
                        <i class="bi bi-search me-1"></i> Search Official Specs
                    </button>
                </div>
            </div>

            <!-- Standard Search Inputs -->
            <div class="row g-2 align-items-center" id="standardSearchInputs">
                <div class="col-md-4">
                    <input type="text" id="autoSearchBrand" class="fg-control form-control-sm" placeholder="Brand (e.g. vivo, Apple, Samsung, Xiaomi)" value="@Model.Specs?.ProcessorBrand">
                </div>
                <div class="col-md-5">
                    <input type="text" id="autoSearchModel" class="fg-control form-control-sm" placeholder="Model Name (e.g. X200, iPhone 15, S24 Ultra)" value="@Model.Name">
                </div>
                <div class="col-md-3">
                    <input type="text" id="autoSearchVariant" class="fg-control form-control-sm" placeholder="Variant (e.g. 12GB / 256GB)">
                </div>
            </div>

            <!-- Direct URL Entry Input Banner (Toggleable) -->
            <div class="row g-2 align-items-center mt-2 d-none" id="directUrlBannerInput">
                <div class="col-md-9">
                    <input type="url" id="directBannerUrl" class="form-control form-control-sm" placeholder="Paste Direct Specification Page URL (e.g. https://www.vivo.com/in/products/x200 or https://www.gsmarena.com/...)">
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-info text-white btn-sm w-100" onclick="extractFromBannerUrl()">
                        <i class="bi bi-download me-1"></i> Extract Specs from URL
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Form Column -->
        <div class="col-lg-8">
            <div class="card-d card-p-lg mb-4">
                <div class="s-title"><i class="bi bi-phone me-2" style="color:var(--primary)"></i>Mobile Device &amp; Product Information</div>
                <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <div class="fg">
                            <label class="fg-label" asp-for="Name">Product / Model Title <span class="req">*</span></label>
                            <input asp-for="Name" id="Name" class="fg-control" placeholder="e.g. Samsung Galaxy S24 Ultra" required>
                            <span asp-validation-for="Name" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label" asp-for="Brand">Brand</label>
                            <input asp-for="Brand" id="Brand" class="fg-control" placeholder="e.g. Samsung, Apple, Vivo">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label" asp-for="ModelName">Model Name</label>
                            <input asp-for="ModelName" id="ModelName" class="fg-control" placeholder="e.g. Galaxy S24 Ultra">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label" asp-for="Variant">RAM / Storage Variant</label>
                            <input asp-for="Variant" id="Variant" class="fg-control" placeholder="e.g. 12GB RAM / 256GB">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="fg">
                            <label class="fg-label" asp-for="Color">Color</label>
                            <input asp-for="Color" id="Color" class="fg-control" placeholder="e.g. Titanium Black">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="fg-label mb-0" asp-for="Code">SKU / Product Code <span class="req">*</span></label>
                                <button type="button" class="btn-d btn-ghost btn-sm-d py-0" style="height:22px;font-size:11px;padding:0 8px;" onclick="generateSKU()">
                                    <i class="bi bi-magic me-1"></i> Auto Generate
                                </button>
                            </div>
                            <div class="fg-action-wrap">
                                <input asp-for="Code" id="Code" class="fg-control" placeholder="e.g. SAM-S24U-256" required>
                                <button type="button" class="fg-action-btn" onclick="generateSKU()" title="Generate SKU Code">
                                    <i class="bi bi-magic"></i> Generate
                                </button>
                            </div>
                            <span asp-validation-for="Code" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <label class="fg-label mb-0" asp-for="Barcode">Barcode / UPC <span class="req">*</span></label>
                                <button type="button" class="btn-d btn-ghost btn-sm-d py-0" style="height:22px;font-size:11px;padding:0 8px;" onclick="generateBarcode()">
                                    <i class="bi bi-upc-scan me-1"></i> Auto Generate
                                </button>
                            </div>
                            <div class="fg-action-wrap">
                                <input asp-for="Barcode" id="Barcode" class="fg-control" placeholder="e.g. 890123456789" required>
                                <button type="button" class="fg-action-btn" onclick="generateBarcode()" title="Generate Barcode">
                                    <i class="bi bi-upc-scan"></i> Generate
                                </button>
                            </div>
                            <span asp-validation-for="Barcode" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="CategoryId">Category <span class="req">*</span></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="fg-control" required>
                                <option value="">— Select Category —</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="Status">Status</label>
                            <select asp-for="Status" class="fg-control">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="PurchasePrice">Purchase Price (₹) <span class="req">*</span></label>
                            <div class="fg-prefix-wrap">
                                <span class="fg-prefix">₹</span>
                                <input asp-for="PurchasePrice" class="fg-control" type="number" step="0.01" min="0" placeholder="0.00" required>
                            </div>
                            <span asp-validation-for="PurchasePrice" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="SellingPrice">Selling Price (₹) <span class="req">*</span></label>
                            <div class="fg-prefix-wrap">
                                <span class="fg-prefix">₹</span>
                                <input asp-for="SellingPrice" class="fg-control" type="number" step="0.01" min="0" placeholder="0.00" required>
                            </div>
                            <span asp-validation-for="SellingPrice" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="fg">
                            <label class="fg-label" asp-for="MinimumStock">Minimum Safety Stock <span class="req">*</span></label>
                            <input asp-for="MinimumStock" class="fg-control" type="number" min="0" placeholder="e.g. 5" required>
                            <span asp-validation-for="MinimumStock" class="fg-error"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="fg mb-0">
                            <label class="fg-label" asp-for="Description">Description & Key Specs</label>
                            <textarea asp-for="Description" class="fg-control" rows="2" placeholder="Add product description, specifications or features…"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mobile Hardware Specifications Card -->
            <div class="card-d card-p-lg mb-4">
                <div class="s-title"><i class="bi bi-cpu me-2" style="color:var(--primary)"></i>Mobile Hardware Specifications</div>
                
                <ul class="nav nav-tabs mb-3" id="specsTab" role="tablist" style="border-bottom-color:var(--border)">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="proc-tab" data-bs-toggle="tab" data-bs-target="#proc-tab-pane" type="button"><i class="bi bi-cpu me-1"></i> Performance</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="disp-tab" data-bs-toggle="tab" data-bs-target="#disp-tab-pane" type="button"><i class="bi bi-display me-1"></i> Display &amp; Camera</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="batt-tab" data-bs-toggle="tab" data-bs-target="#batt-tab-pane" type="button"><i class="bi bi-battery-charging me-1"></i> Battery &amp; Network</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="os-tab" data-bs-toggle="tab" data-bs-target="#os-tab-pane" type="button"><i class="bi bi-shield-check me-1"></i> OS &amp; Security</button>
                    </li>
                </ul>

                <div class="tab-content" id="specsTabContent">
                    <!-- Tab 1: Performance -->
                    <div class="tab-pane fade show active" id="proc-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Processor Brand</label>
                                    <input type="text" asp-for="Specs.ProcessorBrand" class="fg-control" placeholder="e.g. Qualcomm, Apple, MediaTek" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Processor / Chipset Name</label>
                                    <input type="text" asp-for="Specs.ProcessorName" class="fg-control" placeholder="e.g. Snapdragon 8 Gen 3, A16 Bionic" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">CPU Cores &amp; Speed</label>
                                    <input type="text" asp-for="Specs.CpuCores" class="fg-control" placeholder="e.g. Octa-Core 3.3 GHz" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">GPU</label>
                                    <input type="text" asp-for="Specs.Gpu" class="fg-control" placeholder="e.g. Adreno 750" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">RAM Type</label>
                                    <input type="text" asp-for="Specs.RamType" class="fg-control" placeholder="e.g. LPDDR5X" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Storage Type</label>
                                    <input type="text" asp-for="Specs.StorageType" class="fg-control" placeholder="e.g. UFS 4.0, NVMe" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2: Display & Camera -->
                    <div class="tab-pane fade" id="disp-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Display Size (inches)</label>
                                    <input type="text" asp-for="Specs.DisplaySize" class="fg-control" placeholder="e.g. 6.8 inches" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Display Type</label>
                                    <input type="text" asp-for="Specs.DisplayType" class="fg-control" placeholder="e.g. Dynamic AMOLED 2X" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Refresh Rate</label>
                                    <input type="text" asp-for="Specs.RefreshRate" class="fg-control" placeholder="e.g. 120Hz" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Primary Rear Camera (MP)</label>
                                    <input type="text" asp-for="Specs.PrimaryRearCameraMp" class="fg-control" placeholder="e.g. 200 MP + 50 MP + 12 MP" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Front Selfie Camera (MP)</label>
                                    <input type="text" asp-for="Specs.FrontCameraMp" class="fg-control" placeholder="e.g. 12 MP" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Camera Features</label>
                                    <input type="text" asp-for="Specs.CameraFeatures" class="fg-control" placeholder="e.g. OIS, 8K Video, 100x Zoom" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3: Battery & Network -->
                    <div class="tab-pane fade" id="batt-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Battery Capacity (mAh)</label>
                                    <input type="number" asp-for="Specs.BatteryCapacityMah" class="fg-control" placeholder="5000" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Fast Charging (Wattage)</label>
                                    <input type="text" asp-for="Specs.FastChargingWattage" class="fg-control" placeholder="e.g. 45W Fast Charging" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Charging Port</label>
                                    <select asp-for="Specs.ChargingPortType" class="fg-control">
                                        <option value="USB Type-C">USB Type-C</option>
                                        <option value="Lightning">Lightning</option>
                                        <option value="Micro-USB">Micro-USB</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">5G Network Support?</label>
                                    <select asp-for="Specs.Network5G" class="fg-control">
                                        <option value="true">Yes — 5G Supported</option>
                                        <option value="false">No — 4G LTE Only</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">SIM Type</label>
                                    <select asp-for="Specs.SimType" class="fg-control">
                                        <option value="Dual SIM">Dual SIM (Nano + Nano)</option>
                                        <option value="eSIM + Physical SIM">eSIM + Physical SIM</option>
                                        <option value="Single SIM">Single SIM</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">NFC Support?</label>
                                    <select asp-for="Specs.Nfc" class="fg-control">
                                        <option value="true">Yes (Tap &amp; Pay)</option>
                                        <option value="false">No NFC</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="fg">
                                    <label class="fg-label">Wireless Charging?</label>
                                    <select asp-for="Specs.WirelessCharging" class="fg-control">
                                        <option value="false">No Wireless Charging</option>
                                        <option value="true">Yes Wireless Charging</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 4: OS & Security -->
                    <div class="tab-pane fade" id="os-tab-pane">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Operating System</label>
                                    <select asp-for="Specs.OperatingSystem" class="fg-control">
                                        <option value="Android">Android</option>
                                        <option value="iOS">iOS</option>
                                        <option value="KaiOS">KaiOS</option>
                                        <option value="Other">Other OS</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">OS Version</label>
                                    <input type="text" asp-for="Specs.OsVersion" class="fg-control" placeholder="e.g. Android 14, iOS 17" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="fg">
                                    <label class="fg-label">Fingerprint Sensor</label>
                                    <select asp-for="Specs.FingerprintSensor" class="fg-control">
                                        <option value="In-Display Ultrasonic">In-Display Ultrasonic</option>
                                        <option value="Side-Mounted">Side-Mounted</option>
                                        <option value="Rear-Mounted">Rear-Mounted</option>
                                        <option value="None">None</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="fg">
                                    <label class="fg-label">Water/Dust Resistance Rating</label>
                                    <input type="text" asp-for="Specs.WaterResistance" class="fg-control" placeholder="e.g. IP68 Water/Dust Resistant" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="fg">
                                    <label class="fg-label">Audio &amp; Speakers</label>
                                    <input type="text" asp-for="Specs.AudioFeatures" class="fg-control" placeholder="e.g. Stereo Speakers, Dolby Atmos" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <div class="card-d card-p-lg">
                <div class="s-title">Product Image</div>

                <div class="upload-area" onclick="document.getElementById('ProductImage').click()">
                    <img id="image-preview"
                         src="@(string.IsNullOrEmpty(Model.CurrentImageUrl) ? "/images/default-product.png" : Model.CurrentImageUrl)"
                         alt="Preview"
                         style="max-height:160px;max-width:100%;border-radius:var(--radius-md);object-fit:cover;display:block;margin:0 auto 12px">
                    <div class="upload-area-text">
                        <i class="bi bi-cloud-upload me-1"></i>
                        @(string.IsNullOrEmpty(Model.CurrentImageUrl) ? "Click to upload image" : "Click to change image")
                    </div>
                    <div class="upload-area-hint">JPG, PNG or WEBP · Max 5 MB</div>
                </div>

                <input asp-for="ProductImage"
                       id="ProductImage"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       style="display:none"
                       onchange="previewImg(this)">
                <span asp-validation-for="ProductImage" class="fg-error mt-2"></span>
            </div>
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-end gap-3 mt-4">
        <a href="@Url.Action("Index","Product")" class="btn-d btn-outline">Cancel</a>
        <button type="submit" class="btn-d btn-primary">
            <i class="bi bi-check2"></i> Save Changes
        </button>
    </div>
</form>

<!-- Review Specifications Modal -->
<div class="modal fade" id="specReviewModal" tabindex="-1" aria-labelledby="specReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <div>
                    <h5 class="modal-title font-weight-bold" id="specReviewModalLabel">
                        <i class="bi bi-card-checklist text-primary me-2"></i>Review Extracted Specifications (100% Model Parity)
                    </h5>
                    <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
                        <span class="badge bg-primary text-white" id="modalStatsPill">Specifications Found: 0 / 44</span>
                        <span class="badge bg-success text-white" id="modalOfficialCountPill">Official: 0</span>
                        <span class="badge bg-warning text-dark d-none" id="modalThirdPartyCountPill">Third-Party: 0</span>
                        <span class="badge bg-secondary text-white" id="modalUnavailablePill">Unavailable: 44</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Source Provenance & Status Header -->
                <div class="mb-3 p-3 rounded border" id="modalHeaderBox" style="background:#f8f9fa;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <div>
                            <span class="badge rounded-pill bg-success fs-6 px-3 py-2" id="modalSourceBadge">🟢 Official Manufacturer</span>
                            <span class="badge bg-secondary ms-2" id="modalConfidenceBadge">High Match</span>
                        </div>
                        <div class="text-end small">
                            <strong id="modalSourceSite">Official Manufacturer Website</strong>
                            <div id="modalSourceLinks" class="mt-1"></div>
                        </div>
                    </div>
                    <div class="text-muted small" id="modalConfidenceReason">Extracted directly from manufacturer's official published page.</div>
                </div>

                <!-- Fallback Warning Box -->
                <div id="modalFallbackNoticeBox" class="alert alert-warning d-none py-2 px-3 small">
                    <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Official specification page could not be retrieved.</div>
                    <p class="mb-2">The official website did not return an exact match or blocked automated access. Choose an option below:</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="searchOnlineSpecs(false)"><i class="bi bi-arrow-clockwise me-1"></i>Try Again</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="showCustomUrlInput()"><i class="bi bi-link-45deg me-1"></i>Enter Official URL</button>
                        <button type="button" class="btn btn-sm btn-warning" onclick="searchOnlineSpecs(true)"><i class="bi bi-globe me-1"></i>Search Third-Party Sources</button>
                        <button type="button" class="btn btn-sm btn-outline-dark" data-bs-dismiss="modal"><i class="bi bi-pencil-square me-1"></i>Enter Manually</button>
                    </div>
                </div>

                <!-- Custom URL Entry Input Box -->
                <div id="customUrlBox" class="card p-3 mb-3 d-none border-info bg-light">
                    <label class="form-label small fw-bold">Enter Official Specification Page URL:</label>
                    <div class="input-group input-group-sm">
                        <input type="url" id="customUrlInput" class="form-control" placeholder="https://www.vivo.com/in/products/x200">
