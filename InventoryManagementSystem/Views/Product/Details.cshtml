@model Product
@{
    ViewData["Title"] = "Product Details - " + Model.Name;
    decimal margin = Model.SellingPrice - Model.PurchasePrice;
    decimal marginPercentage = Model.PurchasePrice > 0 ? (margin / Model.PurchasePrice) * 100 : 0;
}

<div class="ph">
    <div>
        <h1 class="ph-title">@Model.Name</h1>
        <p class="ph-sub">SKU Code: <span class="code-pill">@Model.Code</span></p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","Product")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>
        <a href="@Url.Action("Edit","Product",new{id=Model.Id})" class="btn-d btn-primary">
            <i class="bi bi-pencil"></i> Edit Product
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Visual Presentation -->
    <div class="col-lg-4">
        <div class="card-d card-p-lg text-center mb-4">
            <div class="s-title text-start"><i class="bi bi-image me-2" style="color:var(--primary)"></i>Product Image</div>
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-product.png" : Model.ImageUrl)"
                 alt="Product"
                 style="max-height:220px;width:100%;object-fit:cover;border-radius:var(--radius-md);border:1px solid var(--border)">
        </div>

        <!-- Labels -->
        <div class="card-d card-p-lg text-center">
            <div class="s-title text-start"><i class="bi bi-qr-code me-2" style="color:var(--success)"></i>System Labels</div>
            
            <div class="p-3 mb-3 bg-white rounded-3 d-flex justify-content-center">
                <svg id="barcode-canvas"></svg>
            </div>
            
            <div class="p-3 bg-white rounded-3 d-flex justify-content-center mx-auto" style="width:fit-content">
                <div id="qrcode-canvas"></div>
            </div>
            <div style="font-size:12px;color:var(--text-muted);margin-top:8px">Value: <span class="code-pill">@Model.Barcode</span></div>
        </div>
    </div>

    <!-- Specifications -->
    <div class="col-lg-8">
        <div class="card-d card-p-lg h-100">
            <div class="s-title"><i class="bi bi-card-list me-2" style="color:var(--primary)"></i>Specifications Sheet</div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">PRODUCT NAME</div>
                    <div class="td-strong" style="font-size:15px">@Model.Name</div>
                </div>
                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">CATEGORY</div>
                    <div class="td-strong" style="font-size:15px">@(ViewBag.CategoryName ?? "—")</div>
                </div>

                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">SKU CODE</div>
                    <span class="code-pill">@Model.Code</span>
                </div>
                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">BARCODE VALUE</div>
                    <span class="code-pill">@Model.Barcode</span>
                </div>

                <div class="col-md-4">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">PURCHASE PRICE</div>
                    <div style="font-weight:600;color:var(--text-secondary)">₹@Model.PurchasePrice.ToString("N2")</div>
                </div>
                <div class="col-md-4">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">SELLING PRICE</div>
                    <div style="font-weight:700;color:var(--primary-text)">₹@Model.SellingPrice.ToString("N2")</div>
                </div>
                <div class="col-md-4">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">PROFIT MARGIN</div>
                    <div style="font-weight:700;color:var(--success)">₹@margin.ToString("N2") <small style="color:var(--text-muted)">(@marginPercentage.ToString("F1")%)</small></div>
                </div>

                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;margin-bottom:4px">CURRENT STOCK LEVEL</div>
                    @if (Model.CurrentStock <= 0)
                    {
                        <span class="badge-d badge-red"><i class="bi bi-x-circle"></i> Out Of Stock</span>
                    }
                    else if (Model.CurrentStock <= Model.MinimumStock)
                    {
                        <span class="badge-d badge-amber"><i class="bi bi-exclamation-triangle"></i> Low Stock: @Model.CurrentStock units</span>
                    }
                    else
                    {
                        <span class="badge-d badge-green"><i class="bi bi-check-circle"></i> In Stock: @Model.CurrentStock units</span>
                    }
                </div>
                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">SAFETY THRESHOLD</div>
                    <div class="td-strong">@Model.MinimumStock units</div>
                </div>

                <div class="col-12 mt-3 pt-3" style="border-top:1px solid var(--border)">
                    <div class="s-title mb-3"><i class="bi bi-cpu me-2" style="color:var(--primary)"></i>Mobile Hardware Specifications Sheet</div>
                    
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">PROCESSOR &amp; CHIPSET</div>
                            <div class="td-strong"><i class="bi bi-cpu me-1 text-primary"></i>@(string.IsNullOrWhiteSpace(Model.Specs?.ProcessorName) ? (string.IsNullOrWhiteSpace(Model.Processor) ? "Not Specified" : Model.Processor) : $"{Model.Specs?.ProcessorBrand} {Model.Specs?.ProcessorName}")</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.Chipset)) { <div style="font-size:12px;color:var(--text-muted)">Chipset: @Model.Specs.Chipset</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.CpuCores)) { <div style="font-size:12px;color:var(--text-muted)">Cores: @Model.Specs.CpuCores (@Model.Specs?.CpuClockSpeed)</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.Gpu)) { <div style="font-size:12px;color:var(--text-muted)">GPU: @Model.Specs.Gpu</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">RAM &amp; STORAGE</div>
                            <div class="td-strong"><i class="bi bi-memory me-1 text-success"></i>@(string.IsNullOrWhiteSpace(Model.Variant) ? (string.IsNullOrWhiteSpace(Model.Ram) && string.IsNullOrWhiteSpace(Model.Storage) ? "Not Specified" : $"{Model.Ram} / {Model.Storage}") : Model.Variant)</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.RamType)) { <div style="font-size:12px;color:var(--text-muted)">RAM Type: @Model.Specs.RamType</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.StorageType)) { <div style="font-size:12px;color:var(--text-muted)">Storage Type: @Model.Specs.StorageType</div> }
                            @if (Model.Specs != null && Model.Specs.ExpandableStorage) { <div style="font-size:12px;color:var(--text-muted)">Expandable: Up to @(Model.Specs.MaxExpandableStorage ?? "Card Slot")</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">DISPLAY SPECIFICATIONS</div>
                            <div class="td-strong"><i class="bi bi-display me-1 text-info"></i>@(string.IsNullOrWhiteSpace(Model.Specs?.DisplaySize) ? (string.IsNullOrWhiteSpace(Model.DisplaySize) ? "Not Specified" : Model.DisplaySize) : $"{Model.Specs.DisplaySize} {Model.Specs.DisplayType}")</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.Resolution)) { <div style="font-size:12px;color:var(--text-muted)">Resolution: @Model.Specs.Resolution</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.RefreshRate)) { <div style="font-size:12px;color:var(--text-muted)">Refresh Rate: @Model.Specs.RefreshRate</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.ScreenProtection)) { <div style="font-size:12px;color:var(--text-muted)">Protection: @Model.Specs.ScreenProtection</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">CAMERA SETUP</div>
                            <div class="td-strong"><i class="bi bi-camera me-1 text-danger"></i>Primary: @(string.IsNullOrWhiteSpace(Model.Specs?.PrimaryRearCameraMp) ? "Not Specified" : Model.Specs.PrimaryRearCameraMp)</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.UltrawideCameraMp)) { <div style="font-size:12px;color:var(--text-muted)">Ultrawide: @Model.Specs.UltrawideCameraMp</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.TelephotoCameraMp)) { <div style="font-size:12px;color:var(--text-muted)">Telephoto: @Model.Specs.TelephotoCameraMp</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.FrontCameraMp)) { <div style="font-size:12px;color:var(--text-muted)">Selfie: @Model.Specs.FrontCameraMp</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.CameraFeatures)) { <div style="font-size:12px;color:var(--text-muted)">Features: @Model.Specs.CameraFeatures</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">BATTERY &amp; CHARGING</div>
                            <div class="td-strong"><i class="bi bi-battery-charging me-1 text-warning"></i>@(Model.Specs != null && Model.Specs.BatteryCapacityMah > 0 ? $"{Model.Specs.BatteryCapacityMah} mAh" : (string.IsNullOrWhiteSpace(Model.BatteryCapacity) ? "Not Specified" : Model.BatteryCapacity))</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.FastChargingWattage)) { <div style="font-size:12px;color:var(--text-muted)">Fast Charge: @Model.Specs.FastChargingWattage (@Model.Specs.ChargingPortType)</div> }
                            @if (Model.Specs != null && Model.Specs.WirelessCharging) { <div style="font-size:12px;color:var(--text-muted)">Wireless Charging Supported</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">NETWORK &amp; CONNECTIVITY</div>
                            <div class="td-strong"><i class="bi bi-wifi me-1 text-primary"></i>@(Model.Specs != null && Model.Specs.Network5G ? "5G Network Supported" : "4G LTE")</div>
                            <div style="font-size:12px;color:var(--text-muted)">SIM: @(Model.Specs?.SimType ?? "Dual SIM") @(Model.Specs != null && Model.Specs.EsimSupport ? "(eSIM Supported)" : "")</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.WifiVersion)) { <div style="font-size:12px;color:var(--text-muted)">Wi-Fi: @Model.Specs.WifiVersion | BT: @Model.Specs.BluetoothVersion</div> }
                            @if (Model.Specs != null && Model.Specs.Nfc) { <div style="font-size:12px;color:var(--text-muted)">NFC: Enabled</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">OS &amp; SECURITY</div>
                            <div class="td-strong"><i class="bi bi-shield-check me-1 text-secondary"></i>@(Model.Specs?.OperatingSystem ?? "Android") @Model.Specs?.OsVersion</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.FingerprintSensor)) { <div style="font-size:12px;color:var(--text-muted)">Biometrics: @Model.Specs.FingerprintSensor</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">PHYSICAL DESIGN &amp; COLORS</div>
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.OfficialColors)) { <div class="td-strong"><i class="bi bi-palette me-1 text-dark"></i>Colors: @Model.Specs.OfficialColors</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.WaterResistance)) { <div style="font-size:12px;color:var(--text-muted)">IP Rating: @Model.Specs.WaterResistance</div> }
                            @if (!string.IsNullOrWhiteSpace(Model.Specs?.DimensionsWeight)) { <div style="font-size:12px;color:var(--text-muted)">Dimensions: @Model.Specs.DimensionsWeight</div> }
                        </div>

                        <div class="col-md-4">
                            <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">SENSORS</div>
                            <div style="font-size:12px;color:var(--text-secondary)">@(string.IsNullOrWhiteSpace(Model.Specs?.Sensors) ? "Standard Accelerometer, Proximity, Light Sensors" : Model.Specs.Sensors)</div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">DESCRIPTION</div>
                    <div style="color:var(--text-secondary);font-size:14px;margin-top:4px;white-space:pre-wrap">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</div>
                </div>

                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">CREATED DATE</div>
                    <div style="color:var(--text-muted);font-size:12px">@Model.CreatedDate.ToIstString("MMM d, yyyy HH:mm IST")</div>
                </div>
                <div class="col-md-6">
                    <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase">LAST MODIFIED</div>
                    <div style="color:var(--text-muted);font-size:12px">@Model.UpdatedDate.ToIstString("MMM d, yyyy HH:mm IST")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            JsBarcode("#barcode-canvas", "@Model.Barcode", {
                format: "CODE128",
                width: 1.5,
                height: 50,
                displayValue: true,
                lineColor: "#0F172A"
            });

            new QRCode(document.getElementById("qrcode-canvas"), {
                text: "@Model.Barcode",
                width: 100,
                height: 100,
                colorDark : "#0F172A",
                colorLight : "#FFFFFF",
                correctLevel : QRCode.CorrectLevel.H
            });
        });
    </script>
}
