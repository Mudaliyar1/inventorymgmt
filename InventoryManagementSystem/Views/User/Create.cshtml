@model User
@{
    ViewData["Title"] = "Add Employee";
    var groupedPermissions = ViewBag.GroupedPermissions as IEnumerable<ModulePermissionsGroup> ?? new List<ModulePermissionsGroup>();
}

<div class="ph">
    <div>
        <h1 class="ph-title">Add New Employee</h1>
        <p class="ph-sub">Register employee credentials and dynamically assign module permissions.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","User")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Employee List
        </a>
    </div>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>

    <div class="row g-4">
        <!-- Left Column: Employee Profile Details -->
        <div class="col-lg-5">
            <div class="card-d card-p-lg">
                <div class="s-title"><i class="bi bi-person-badge me-2" style="color:var(--primary)"></i>Employee Identity</div>

                <div class="fg">
                    <label class="fg-label" asp-for="EmployeeId">Employee ID <span class="req">*</span></label>
                    <input asp-for="EmployeeId" class="fg-control" placeholder="e.g. EMP-1001" required />
                    <span asp-validation-for="EmployeeId" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="FullName">Full Name <span class="req">*</span></label>
                    <input asp-for="FullName" class="fg-control" placeholder="e.g. Rahul Sharma" required />
                    <span asp-validation-for="FullName" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="Username">Username <span class="req">*</span></label>
                    <input asp-for="Username" class="fg-control" placeholder="e.g. rahul_sales" required />
                    <span asp-validation-for="Username" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="Email">Email Address <span class="req">*</span></label>
                    <input asp-for="Email" type="email" class="fg-control" placeholder="e.g. rahul@sims.com" required />
                    <span asp-validation-for="Email" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="PhoneNumber">Contact Phone</label>
                    <input asp-for="PhoneNumber" class="fg-control" placeholder="e.g. +91 98765 43210" />
                    <span asp-validation-for="PhoneNumber" class="fg-error"></span>
                </div>

                <input type="hidden" asp-for="Role" value="Staff" />

                <div class="fg mb-0">
                    <label class="fg-label">Login Password <span class="req">*</span></label>
                    <input type="password" name="rawPassword" class="fg-control" placeholder="Minimum 6 characters" required />
                </div>
            </div>
        </div>

        <!-- Right Column: Dynamic Module Permissions Checkbox Matrix -->
        <div class="col-lg-7" id="permissionsContainer">
            <div class="card-d card-p-lg">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="s-title mb-0"><i class="bi bi-shield-check me-2" style="color:var(--success)"></i>Module Permissions Matrix</div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn-d btn-ghost btn-sm-d" onclick="toggleAllPermissions(true)">Select All</button>
                        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="toggleAllPermissions(false)">Deselect All</button>
                    </div>
                </div>
                <p style="font-size:12px;color:var(--text-muted)" class="mb-4">
                    Tick the checkboxes below to grant page and action access to this employee. Discovered dynamically from the project controllers.
                </p>

                @foreach (var group in groupedPermissions)
                {
                    <div class="card-d mb-3" style="background:var(--bg);border:1px solid var(--border)">
                        <div class="card-p p-3 d-flex align-items-center justify-content-between border-bottom" style="border-color:var(--border)!important">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi @group.IconClass text-primary"></i>
                                <span style="font-weight:700;font-size:14px;color:var(--text-primary)">@group.ModuleName</span>
                                <span class="badge-d badge-gray" style="font-size:11px">@group.Permissions.Count Actions</span>
                            </div>
                            <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:12px;font-weight:600;color:var(--text-muted);user-select:none">
                                <input type="checkbox" onchange="toggleModuleGroup(this, '@group.ControllerName')" />
                                Toggle Module
                            </label>
                        </div>

                        <div class="card-p p-3">
                            <div class="row g-2">
                                @foreach (var perm in group.Permissions)
                                {
                                    <div class="col-md-6">
                                        <label class="d-flex align-items-start gap-2 p-2 rounded perm-checkbox-item" style="cursor:pointer;user-select:none;background:var(--card-bg);border:1px solid var(--border);transition:all 0.15s ease">
                                            <input type="checkbox" name="selectedPermissions" value="@perm.PermissionKey"
                                                   class="perm-check perm-check-@group.ControllerName mt-1" />
                                            <div>
                                                <div style="font-size:12px;font-weight:600;color:var(--text-primary)">@perm.DisplayName</div>
                                                <div style="font-size:10px;color:var(--text-muted)">
                                                    <span class="code-pill" style="font-size:10px;padding:1px 4px">@perm.PermissionKey</span>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <hr class="s-divider" />
                <div class="d-flex align-items-center justify-content-end gap-2">
                    <a href="@Url.Action("Index","User")" class="btn-d btn-outline">Cancel</a>
                    <button type="submit" class="btn-d btn-primary">
                        <i class="bi bi-check2-circle"></i> Create Employee Account
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleModuleGroup(master, controller) {
            const checks = document.querySelectorAll('.perm-check-' + controller);
            checks.forEach(c => c.checked = master.checked);
        }

        function toggleAllPermissions(checked) {
            const checks = document.querySelectorAll('.perm-check');
            checks.forEach(c => c.checked = checked);
        }

        function toggleRolePermissions(role) {
            const container = document.getElementById('permissionsContainer');
            if (role === 'Admin') {
                toggleAllPermissions(true);
            }
        }
    </script>
}
