@model User
@{
    ViewData["Title"] = "Add Employee";
    var groupedPermissions = ViewBag.GroupedPermissions as IEnumerable<ModulePermissionsGroup> ?? new List<ModulePermissionsGroup>();
}

<div class="ph">
    <div>
        <h1 class="ph-title">Add New Employee</h1>
        <p class="ph-sub">Register employee credentials and dynamically assign module permissions.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","User")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Employee List
        </a>
    </div>
</div>

<form asp-action="Create" method="post">
    @if (ViewBag.LimitReached == true)
    {
        <!-- Package Limit Warning Banner -->
        <div class="alert alert-danger d-flex align-items-center justify-content-between mb-4 p-3 border-danger bg-opacity-10 bg-danger text-danger rounded-3 shadow-sm">
            <div class="d-flex align-items-center">
                <i class="bi bi-slash-circle-fill fs-3 me-3"></i>
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill me-2"></i>Not Applicable in Current Plan</h5>
                    <div>@ViewBag.LimitMessage</div>
                    <small class="d-block mt-1 text-muted">Upgrade your plan to unlock more staff employee accounts.</small>
                </div>
            </div>
            <a href="@Url.Action("Plans", "Subscription")" class="btn btn-warning shadow-sm">
                <i class="bi bi-rocket-takeoff me-1"></i> View Other Plans
            </a>
        </div>

        <!-- Package Limit Modal Popup -->
        <div class="modal fade show d-block" id="packageLimitModal" tabindex="-1" style="background: rgba(0,0,0,0.8); isolation: isolate; z-index: 1055;" data-bs-backdrop="static" data-bs-keyboard="false" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark text-light border-warning shadow-lg">
                    <div class="modal-header border-secondary bg-warning bg-opacity-10 text-warning">
                        <h5 class="modal-title font-display fw-bold mb-0">
                            <i class="bi bi-shield-slash-fill me-2"></i>Not Applicable in Current Plan
                        </h5>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <div class="mb-3">
                            <span class="badge-d badge-yellow p-3 rounded-circle d-inline-flex align-items-center justify-content-center" style="width:70px;height:70px;font-size:32px">
                                <i class="bi bi-lock-fill text-warning"></i>
                            </span>
                        </div>
                        <h5 class="fw-bold text-light mb-2">Package Limit Reached</h5>
                        <p class="text-light fs-6 mb-4 fw-semibold">
                            @ViewBag.LimitMessage
                        </p>
                        <div class="alert alert-warning text-dark border-warning fs-7 mb-0 fw-bold shadow-sm">
                            <i class="bi bi-info-circle-fill me-1"></i> Upgrade to a higher plan to unlock additional staff accounts, inventory items, and advanced SaaS features.
                        </div>
                    </div>
                    <div class="modal-footer border-secondary justify-content-center gap-2">
                        <a href="@Url.Action("Index", "User")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Go Back
                        </a>
                        <a href="@Url.Action("Plans", "Subscription")" class="btn btn-warning shadow-sm">
                            <i class="bi bi-rocket-takeoff me-1"></i> View Other Plans & Upgrade
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>

    <div class="row g-4">
        <!-- Left Column: Employee Profile Details -->
        <div class="col-lg-5">
            <div class="card-d card-p-lg">
                <div class="s-title"><i class="bi bi-person-badge me-2" style="color:var(--primary)"></i>Employee Identity</div>

                <div class="fg">
                    <label class="fg-label" asp-for="EmployeeId">Employee ID <span class="req">*</span></label>
                    <input asp-for="EmployeeId" class="fg-control" placeholder="e.g. EMP-1001" required />
                    <span asp-validation-for="EmployeeId" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="FullName">Full Name <span class="req">*</span></label>
                    <input asp-for="FullName" class="fg-control" placeholder="e.g. Rahul Sharma" required />
                    <span asp-validation-for="FullName" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="Username">Username <span class="req">*</span></label>
                    <input asp-for="Username" class="fg-control" placeholder="e.g. rahul_sales" required />
                    <span asp-validation-for="Username" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="Email">Email Address <span class="req">*</span></label>
                    <input asp-for="Email" type="email" class="fg-control" placeholder="e.g. rahul@sims.com" required />
                    <span asp-validation-for="Email" class="fg-error"></span>
                </div>

                <div class="fg">
                    <label class="fg-label" asp-for="PhoneNumber">Contact Phone</label>
                    <input asp-for="PhoneNumber" class="fg-control" placeholder="e.g. +91 98765 43210" />
                    <span asp-validation-for="PhoneNumber" class="fg-error"></span>
                </div>

                <input type="hidden" asp-for="Role" value="Staff" />

                <div class="fg mb-3">
                    <label class="fg-label">Login Password <span class="req">*</span></label>
                    <div class="position-relative">
                        <input type="password" id="empPasswordInput" name="rawPassword" class="fg-control" style="padding-right:42px" placeholder="Create login password" required oninput="evaluateEmpPwdPolicy(this.value)" />
                        <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleEmpPassword('empPasswordInput', this)" style="border:none;background:none;text-decoration:none;">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Password Requirements Checklist -->
                <div class="p-3 mb-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:12px">
                    <div style="font-weight:700;color:var(--text-muted);margin-bottom:6px;text-transform:uppercase;font-size:11px">
                        <i class="bi bi-shield-lock text-primary me-1"></i>Password must contain:
                    </div>
                    <div id="emp-req-len" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="emp-icon-len"></i> Minimum 8 characters
                    </div>
                    <div id="emp-req-upper" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="emp-icon-upper"></i> One uppercase letter (A-Z)
                    </div>
                    <div id="emp-req-lower" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="emp-icon-lower"></i> One lowercase letter (a-z)
                    </div>
                    <div id="emp-req-num" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="emp-icon-num"></i> One number (0-9)
                    </div>
                    <div id="emp-req-spec" style="color:var(--text-muted);margin-bottom:2px">
                        <i class="bi bi-circle me-1" id="emp-icon-spec"></i> One special character (!@@#$%^&*...)
                    </div>
                </div>

                <div class="fg mb-0">
                    <label class="fg-label">Confirm Password <span class="req">*</span></label>
                    <div class="position-relative">
                        <input type="password" id="empConfirmPasswordInput" name="confirmPassword" class="fg-control" style="padding-right:42px" placeholder="Repeat login password" required oninput="evaluateEmpPwdMatch()" />
                        <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted p-2" onclick="toggleEmpPassword('empConfirmPasswordInput', this)" style="border:none;background:none;text-decoration:none;">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="text-danger small mt-1" id="empMatchError"></div>
                </div>
            </div>
        </div>

        <!-- Right Column: Dynamic Module Permissions Checkbox Matrix -->
        <div class="col-lg-7" id="permissionsContainer">
            <div class="card-d card-p-lg">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="s-title mb-0"><i class="bi bi-shield-check me-2" style="color:var(--success)"></i>Module Permissions Matrix</div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn-d btn-ghost btn-sm-d" onclick="toggleAllPermissions(true)">Select All</button>
                        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="toggleAllPermissions(false)">Deselect All</button>
                    </div>
                </div>
                <p style="font-size:12px;color:var(--text-muted)" class="mb-4">
                    Tick the checkboxes below to grant page and action access to this employee. Discovered dynamically from the project controllers.
                </p>

                @foreach (var group in groupedPermissions)
                {
                    <div class="card-d mb-3" style="background:var(--bg);border:1px solid var(--border)">
                        <div class="card-p p-3 d-flex align-items-center justify-content-between border-bottom" style="border-color:var(--border)!important">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi @group.IconClass text-primary"></i>
                                <span style="font-weight:700;font-size:14px;color:var(--text-primary)">@group.ModuleName</span>
                                <span class="badge-d badge-gray" style="font-size:11px">@group.Permissions.Count Actions</span>
                            </div>
                            <label class="d-flex align-items-center gap-2" style="cursor:pointer;font-size:12px;font-weight:600;color:var(--text-muted);user-select:none">
                                <input type="checkbox" onchange="toggleModuleGroup(this, '@group.ControllerName')" checked />
                                Toggle Module
                            </label>
                        </div>

                        <div class="card-p p-3">
                            <div class="row g-2">
                                @foreach (var perm in group.Permissions)
                                {
                                    <div class="col-md-6">
                                        <label class="d-flex align-items-start gap-2 p-2 rounded perm-checkbox-item" style="cursor:pointer;user-select:none;background:var(--card-bg);border:1px solid var(--border);transition:all 0.15s ease">
                                            <input type="checkbox" name="selectedPermissions" value="@perm.PermissionKey"
                                                   class="perm-check perm-check-@group.ControllerName mt-1" checked />
                                            <div>
                                                <div style="font-size:12px;font-weight:600;color:var(--text-primary)">@perm.DisplayName</div>
                                                <div style="font-size:10px;color:var(--text-muted)">
                                                    <span class="code-pill" style="font-size:10px;padding:1px 4px">@perm.PermissionKey</span>
                                                </div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <hr class="s-divider" />
                <div class="d-flex align-items-center justify-content-end gap-2">
                    <a href="@Url.Action("Index","User")" class="btn-d btn-outline">Cancel</a>
                    @if (ViewBag.LimitReached == true)
                    {
                        <button type="button" class="btn-d btn-secondary" disabled title="@ViewBag.LimitMessage">
                            <i class="bi bi-lock-fill"></i> Creation Disabled (Limit Reached)
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn-d btn-primary">
                            <i class="bi bi-check2-circle"></i> Create Employee Account
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleModuleGroup(master, controller) {
            const checks = document.querySelectorAll('.perm-check-' + controller);
            checks.forEach(c => c.checked = master.checked);
        }

        function toggleAllPermissions(checked) {
            const checks = document.querySelectorAll('.perm-check');
            checks.forEach(c => c.checked = checked);
        }

        function toggleRolePermissions(role) {
            const container = document.getElementById('permissionsContainer');
            if (role === 'Admin') {
                toggleAllPermissions(true);
            }
        }

        function toggleEmpPassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function setEmpRuleState(rowId, iconId, isMet) {
            const row = document.getElementById(rowId);
            const icon = document.getElementById(iconId);
            if (!row || !icon) return;
            if (isMet) {
                row.style.color = '#34d399';
                row.style.fontWeight = '600';
                icon.className = 'bi bi-check-circle-fill text-success me-1';
            } else {
                row.style.color = 'var(--text-muted)';
                row.style.fontWeight = 'normal';
                icon.className = 'bi bi-circle me-1';
            }
        }

        function evaluateEmpPwdPolicy(val) {
            val = val || '';
            setEmpRuleState('emp-req-len', 'emp-icon-len', val.length >= 8);
            setEmpRuleState('emp-req-upper', 'emp-icon-upper', /[A-Z]/.test(val));
            setEmpRuleState('emp-req-lower', 'emp-icon-lower', /[a-z]/.test(val));
            setEmpRuleState('emp-req-num', 'emp-icon-num', /[0-9]/.test(val));
            setEmpRuleState('emp-req-spec', 'emp-icon-spec', /[^A-Za-z0-9]/.test(val));
            evaluateEmpPwdMatch();
        }

        function evaluateEmpPwdMatch() {
            const pwd = document.getElementById('empPasswordInput')?.value || '';
            const conf = document.getElementById('empConfirmPasswordInput')?.value || '';
            const err = document.getElementById('empMatchError');
            if (conf.length > 0 && pwd !== conf) {
                if (err) err.innerText = 'Passwords do not match.';
            } else {
                if (err) err.innerText = '';
            }
        }
    </script>
}
