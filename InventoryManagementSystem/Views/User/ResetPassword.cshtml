@model User
@{
    ViewData["Title"] = "Override Password - " + Model.Username;
}

<div class="ph">
    <div>
        <h1 class="ph-title">Override Password</h1>
        <p class="ph-sub">Directly set a new login password for staff user: <span style="color:var(--text-primary)">@Model.Username</span></p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index","User")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left"></i> Back to Staff List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card-d card-p-lg">
            <div class="s-title"><i class="bi bi-key me-2" style="color:var(--warning)"></i>Reset Password</div>
            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert-d alert-danger mb-4"></div>

                <div class="fg">
                    <label class="fg-label">New Password <span class="req">*</span></label>
                    <input name="newPassword" type="password" class="fg-control" placeholder="Min 6 characters" required />
                </div>

                <div class="fg">
                    <label class="fg-label">Confirm New Password <span class="req">*</span></label>
                    <input name="confirmPassword" type="password" class="fg-control" placeholder="Repeat new password" required />
                </div>

                <hr class="s-divider">
                <div class="d-flex align-items-center justify-content-end gap-3">
                    <a href="@Url.Action("Index","User")" class="btn-d btn-outline">Cancel</a>
                    <button type="submit" class="btn-d btn-danger">
                        <i class="bi bi-key-fill"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
