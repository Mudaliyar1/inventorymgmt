@model IEnumerable<InventoryManagementSystem.Models.SupplierOrder>
@{
    ViewData["Title"] = "Supplier Order Management";
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, long> ?? new Dictionary<string, long>();
    var suppliers = ViewBag.Suppliers as IEnumerable<InventoryManagementSystem.Models.Supplier> ?? new List<InventoryManagementSystem.Models.Supplier>();
    var currentStatus = ViewBag.Status as string;
    var selectedSupplierId = ViewBag.SupplierId as string;
    var search = ViewBag.Search as string;
    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    long totalCount = ViewBag.TotalCount is long tc ? tc : (Model?.Count() ?? 0);
    int pageSize = 20;
    long startRecord = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    long endRecord = Math.Min(currentPage * pageSize, totalCount);
}

<!-- Page Header -->
<div class="ph">
    <div>
        <h1 class="ph-title"><i class="bi bi-shop me-2" style="color:var(--primary)"></i>Supplier Order Management</h1>
        <p class="ph-sub">Manage vendor purchase orders, status workflows, and stock replenishment history</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Create")" class="btn-d btn-primary">
            <i class="bi bi-cart-plus me-1"></i> + Create Purchase Order
        </a>
    </div>
</div>

<!-- Status Filter Tabs Bar -->
<div class="d-flex align-items-center gap-2 mb-4 overflow-auto pb-2" style="border-bottom:1px solid var(--border)">
    <a href="@Url.Action("Index", new { supplierId = selectedSupplierId, search })" class="btn-d @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline") btn-sm-d">
        All Orders (@(statusCounts.GetValueOrDefault("Total", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Pending", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Pending" ? "btn-primary" : "btn-outline") btn-sm-d">
        Pending (@(statusCounts.GetValueOrDefault("Pending", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Accepted", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Accepted" ? "btn-primary" : "btn-outline") btn-sm-d">
        Accepted (@(statusCounts.GetValueOrDefault("Accepted", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Processing", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Processing" ? "btn-primary" : "btn-outline") btn-sm-d">
        Processing (@(statusCounts.GetValueOrDefault("Processing", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Shipped", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Shipped" ? "btn-primary" : "btn-outline") btn-sm-d">
        Shipped (@(statusCounts.GetValueOrDefault("Shipped", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Delivered", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Delivered" ? "btn-primary" : "btn-outline") btn-sm-d">
        Delivered (@(statusCounts.GetValueOrDefault("Delivered", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Completed", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Completed" ? "btn-primary" : "btn-outline") btn-sm-d">
        Completed (@(statusCounts.GetValueOrDefault("Completed", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Rejected", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Rejected" ? "btn-danger" : "btn-outline") btn-sm-d">
        Rejected (@(statusCounts.GetValueOrDefault("Rejected", 0)))
    </a>
    <a href="@Url.Action("Index", new { status = "Cancelled", supplierId = selectedSupplierId, search })" class="btn-d @(currentStatus == "Cancelled" ? "btn-primary" : "btn-outline") btn-sm-d">
        Cancelled (@(statusCounts.GetValueOrDefault("Cancelled", 0)))
    </a>
</div>

<!-- Detailed Filter Form -->
<div class="card-d card-p mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="fg-label"><i class="bi bi-search me-1 text-primary"></i>Search Keyword</label>
            <input type="text" name="search" value="@search" class="fg-control" placeholder="Order #, Supplier Name, Email, Product..." />
        </div>
        <div class="col-md-3">
            <label class="fg-label"><i class="bi bi-truck me-1 text-info"></i>Filter by Supplier</label>
            <select name="supplierId" class="fg-control">
                <option value="">All Suppliers</option>
                @foreach (var sup in suppliers)
                {
                    <option value="@sup.Id" selected="@(selectedSupplierId == sup.Id)">@sup.CompanyName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="fg-label"><i class="bi bi-funnel me-1 text-warning"></i>Filter by Status</label>
            <select name="status" class="fg-control">
                <option value="">All Statuses</option>
                <option value="Pending" selected="@(currentStatus == "Pending")">Pending</option>
                <option value="Accepted" selected="@(currentStatus == "Accepted")">Accepted</option>
                <option value="Processing" selected="@(currentStatus == "Processing")">Processing</option>
                <option value="Shipped" selected="@(currentStatus == "Shipped")">Shipped</option>
                <option value="Delivered" selected="@(currentStatus == "Delivered")">Delivered</option>
                <option value="Completed" selected="@(currentStatus == "Completed")">Completed</option>
                <option value="Rejected" selected="@(currentStatus == "Rejected")">Rejected</option>
                <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-center gap-2">
            <button type="submit" class="btn-d btn-primary w-100"><i class="bi bi-funnel"></i> Apply Filter</button>
            <a href="@Url.Action("Index")" class="btn-d btn-outline" title="Clear Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<div class="card-d card-p p-0 overflow-hidden mb-4">
    <div class="tbl-scroll">
        <table class="tbl mb-0">
            <thead>
                <tr>
                    <th class="ps-3">PO Number</th>
                    <th>Supplier Vendor</th>
                    <th>Date Created</th>
                    <th>Items Count</th>
                    <th>Total Units</th>
                    <th>Grand Total</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-cart-x text-muted d-block mb-2" style="font-size:32px"></i>
                            No purchase orders found matching the filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var o in Model)
                    {
                        var statusBadge = o.Status switch
                        {
                            "Pending" => "badge-warning",
                            "Accepted" => "badge-info",
                            "Processing" => "badge-primary",
                            "Shipped" => "badge-primary",
                            "Delivered" => "badge-success",
                            "Completed" => "badge-success",
                            "Rejected" => "badge-danger",
                            "Cancelled" => "badge-gray",
                            _ => "badge-gray"
                        };
                        <tr>
                            <td class="ps-3 fw-bold">
                                <a href="@Url.Action("Details", new { id = o.Id })" class="text-decoration-none" style="color:var(--primary)">
                                    @o.OrderNumber
                                </a>
                            </td>
                            <td>
                                <div style="font-weight:700;color:var(--text-primary)">@o.DisplaySupplierVendorName</div>
                                @if (!string.IsNullOrWhiteSpace(o.SupplierCompanyName) && o.SupplierCompanyName != o.DisplaySupplierVendorName)
                                {
                                    <div style="font-size:11px;color:var(--text-secondary)">@o.SupplierCompanyName</div>
                                }
                                <div style="font-size:11px;color:var(--text-muted)">@o.SupplierEmail</div>
                            </td>
                            <td style="font-size:12px;color:var(--text-primary)">@o.CreatedAt.ToIst().ToString("dd-MMM-yyyy hh:mm tt IST")</td>
                            <td><span class="badge-d badge-gray">@o.Items.Count Products</span></td>
                            <td style="font-weight:700">@o.TotalQuantity Units</td>
                            <td style="font-weight:800;color:var(--success)">₹@o.GrandTotal.ToString("N2")</td>
                            <td><span class="badge-d @statusBadge">@o.Status</span></td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <a href="@Url.Action("Details", new { id = o.Id })" class="btn-d btn-ghost btn-sm-d text-primary" title="View Order Details">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                    @if (o.Status == "Delivered" || o.Status == "Completed" || o.Status == "Accepted" || o.Status == "Processing" || o.Status == "Shipped")
                                    {
                                        <a href="@Url.Action("Create", "PurchaseReturn", new { orderId = o.Id })" class="btn-d btn-ghost btn-sm-d text-warning" title="Return Purchase Items">
                                            <i class="bi bi-arrow-return-left me-1"></i> Return
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination Controls Bar -->
@if (totalPages > 1)
{
    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 bg-card p-3 rounded-3 mb-4" style="border:1px solid var(--border)">
        <div class="text-muted style-sm" style="font-size:13px">
            Showing <strong class="text-primary">@startRecord</strong> to <strong class="text-primary">@endRecord</strong> of <strong>@totalCount</strong> purchase orders
        </div>
        <nav aria-label="Purchase Order Pagination">
            <ul class="pagination pagination-sm mb-0">
                <!-- Previous Button -->
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link style-pl" href="@Url.Action("Index", new { status = currentStatus, supplierId = selectedSupplierId, search, page = currentPage - 1 })">
                        <i class="bi bi-chevron-left"></i> Prev
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == 1 || p == totalPages || (p >= currentPage - 2 && p <= currentPage + 2))
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link style-pl" href="@Url.Action("Index", new { status = currentStatus, supplierId = selectedSupplierId, search, page = p })">
                                @p
                            </a>
                        </li>
                    }
                    else if (p == currentPage - 3 || p == currentPage + 3)
                    {
                        <li class="page-item disabled"><span class="page-link style-pl">...</span></li>
                    }
                }

                <!-- Next Button -->
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link style-pl" href="@Url.Action("Index", new { status = currentStatus, supplierId = selectedSupplierId, search, page = currentPage + 1 })">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
