                                <button type="button" class="cart-qty-btn" onclick="adjustModalQty(1)">+</button>
                            </div>
                            <div class="d-flex justify-content-between mb-3" style="font-size:12px">
                                <span class="text-muted">Line Subtotal:</span>
                                <span class="fw-bold text-success" id="ps_QuickSubtotal">₹0.00</span>
                            </div>
                            <button type="button" class="btn-d btn-primary w-100 btn-sm-d" onclick="addFromDetailsModal()">
                                <i class="bi bi-cart-plus me-1"></i> Add to Purchase Order
                            </button>
                        </div>
                    </div>

                    <!-- Right: Detailed Spec Tabs -->
                    <div class="col-lg-8">
                        <ul class="nav nav-tabs border-bottom mb-3" role="tablist" style="border-color:var(--border)!important">
                            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#mps-overview" type="button"><i class="bi bi-info-circle me-1"></i> Overview</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#mps-supplier" type="button" style="color:var(--primary);font-weight:700"><i class="bi bi-truck me-1"></i> Supplier Profile</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#mps-perf" type="button"><i class="bi bi-cpu me-1"></i> Performance</button></li>
