                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Display Size</div><div style="font-weight:700" id="ps_DispSize">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Resolution</div><div style="font-weight:700" id="ps_DispRes">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Refresh Rate</div><div style="font-weight:700" id="ps_Refresh">-</div></div>
                                    <div class="col-6 col-md-6"><div style="font-size:11px;color:var(--text-muted)">Rear Main Camera</div><div style="font-weight:700" id="ps_RearCam">-</div></div>
                                    <div class="col-6 col-md-6"><div style="font-size:11px;color:var(--text-muted)">Front Camera</div><div style="font-weight:700" id="ps_FrontCam">-</div></div>
                                </div>
                            </div>

                            <!-- Tab 5: Battery & Network -->
                            <div class="tab-pane fade" id="mps-battery">
                                <div class="row g-3">
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Battery Capacity</div><div style="font-weight:700" id="ps_Battery">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Fast Charging</div><div style="font-weight:700" id="ps_Charging">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">5G Support</div><div style="font-weight:700" id="ps_5G">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">SIM Support</div><div style="font-weight:700" id="ps_Sim">-</div></div>
                                </div>
                            </div>

                            <!-- Tab 6: OS & Security -->
                            <div class="tab-pane fade" id="mps-os">
                                <div class="row g-3">
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Operating System</div><div style="font-weight:700" id="ps_OS">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Fingerprint Sensor</div><div style="font-weight:700" id="ps_Biometrics">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Water Resistance</div><div style="font-weight:700" id="ps_IP">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">NFC Support</div><div style="font-weight:700" id="ps_NFC">-</div></div>
                                </div>
                            </div>
                        </div>

                        <hr class="s-divider my-3" />
                        <div class="fg mb-0">
                            <label class="fg-label text-muted">Description & Overview</label>
                            <div class="p-3 rounded" style="background:var(--bg);border:1px solid var(--border);font-size:13px;color:var(--text-primary)" id="ps_Description">-</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top d-flex justify-content-end" style="border-color:var(--border)!important">
                <button type="button" class="btn-d btn-outline" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

