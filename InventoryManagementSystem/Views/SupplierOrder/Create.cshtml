                <div class="text-center mb-3">
                    <h6 class="mb-1 fw-bold text-truncate" id="qqm_Name" style="color:var(--text-primary)">Product Name</h6>
                    <div class="text-muted" style="font-size:12px" id="qqm_Variant">8GB / 128GB</div>
