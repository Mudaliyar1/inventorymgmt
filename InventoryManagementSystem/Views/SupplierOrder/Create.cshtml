                            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#mps-battery" type="button"><i class="bi bi-battery-charging me-1"></i> Battery & Network</button></li>
                            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#mps-os" type="button"><i class="bi bi-shield-check me-1"></i> OS & Features</button></li>
                        </ul>

                        <div class="tab-content">
                            <!-- Tab 1: Overview -->
                            <div class="tab-pane fade show active" id="mps-overview">
                                <div class="row g-3">
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Brand & Model</div><div style="font-weight:700" id="ps_BrandModel">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Variant</div><div style="font-weight:700" id="ps_Variant">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Color</div><div style="font-weight:700" id="ps_Color">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Supplied By</div><div style="font-weight:700;color:var(--primary)" id="ps_OverviewSupplier">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Supplier Price</div><div style="font-weight:700;color:var(--primary)" id="ps_SupplierPrice">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Retail Selling Price</div><div style="font-weight:700;color:var(--success)" id="ps_SellingPrice">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Current Stock</div><div style="font-weight:700" id="ps_Stock">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Barcode</div><div style="font-weight:700" id="ps_Barcode">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Warranty</div><div style="font-weight:700" id="ps_Warranty">-</div></div>
                                </div>
                            </div>

                            <!-- Tab 2: Supplier Profile -->
                            <div class="tab-pane fade" id="mps-supplier">
                                <div class="p-3 rounded mb-3" style="background:var(--bg);border:1px solid var(--border)">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2 border-bottom pb-2" style="border-color:var(--border)!important">
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width:38px;height:38px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:18px">
                                                <i class="bi bi-building"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold" id="ps_SupCompany" style="color:var(--text-primary);font-size:16px">Vendor Company</h6>
                                                <span class="badge bg-success-subtle text-success" id="ps_SupStatus" style="font-size:11px">Active</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Contact Person</div><div style="font-weight:700" id="ps_SupContact">-</div></div>
                                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Phone</div><div style="font-weight:700" id="ps_SupPhone">-</div></div>
                                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Email</div><div style="font-weight:700" id="ps_SupEmail">-</div></div>
                                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">GSTIN</div><div style="font-weight:700;font-family:monospace" id="ps_SupGstin">-</div></div>
                                        <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Payment Terms</div><div style="font-weight:700" id="ps_SupTerms">-</div></div>
                                        <div class="col-12"><div style="font-size:11px;color:var(--text-muted)">Warehouse Address</div><div style="font-weight:600" id="ps_SupAddress">-</div></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 3: Performance -->
                            <div class="tab-pane fade" id="mps-perf">
                                <div class="row g-3">
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Processor</div><div style="font-weight:700" id="ps_Proc">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">CPU Cores</div><div style="font-weight:700" id="ps_Cores">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">GPU</div><div style="font-weight:700" id="ps_Gpu">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">RAM Memory</div><div style="font-weight:700" id="ps_Ram">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Internal Storage</div><div style="font-weight:700" id="ps_Storage">-</div></div>
                                    <div class="col-6 col-md-4"><div style="font-size:11px;color:var(--text-muted)">Expandable Slot</div><div style="font-weight:700" id="ps_Expandable">-</div></div>
                                </div>
                            </div>

                            <!-- Tab 4: Display & Camera -->
                            <div class="tab-pane fade" id="mps-display">
