@model IEnumerable<InventoryManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Create Purchase Order";
    var suppliers = ViewBag.Suppliers as IEnumerable<InventoryManagementSystem.Models.Supplier> ?? new List<InventoryManagementSystem.Models.Supplier>();
    var supplierProductCounts = ViewBag.SupplierProductCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var selectedSupplierId = ViewBag.SelectedSupplierId as string;
    var selectedSupplier = ViewBag.SelectedSupplier as InventoryManagementSystem.Models.Supplier;
    var availableBrands = ViewBag.AvailableBrands as List<InventoryManagementSystem.Controllers.BrandSummaryViewModel> ?? new List<InventoryManagementSystem.Controllers.BrandSummaryViewModel>();
    var selectedBrand = ViewBag.SelectedBrand as string;
    var categories = ViewBag.Categories as IEnumerable<InventoryManagementSystem.Models.Category> ?? new List<InventoryManagementSystem.Models.Category>();
    var selectedCategoryId = ViewBag.CategoryId as string;
    var availableModels = ViewBag.AvailableModels as List<string> ?? new List<string>();
    var selectedModelName = ViewBag.ModelName as string;
    var availableProductNames = ViewBag.AvailableProductNames as List<string> ?? new List<string>();
    var selectedProductName = ViewBag.ProductName as string;
    var minPrice = ViewBag.MinPrice as decimal?;
    var maxPrice = ViewBag.MaxPrice as decimal?;
    var sortBy = ViewBag.SortBy as string ?? "newest";
    var search = ViewBag.Search as string;

    bool hasSupplier = !string.IsNullOrWhiteSpace(selectedSupplierId) && selectedSupplier != null;
    bool hasBrand = hasSupplier && !string.IsNullOrWhiteSpace(selectedBrand);
    int stepNumber = !hasSupplier ? 1 : (!hasBrand ? 2 : 3);
}

<style>
    /* Hierarchical Stepper Styles */
    .po-stepper {
        display: flex;
        align-items: center;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 12px 20px;
        margin-bottom: 24px;
        gap: 12px;
        overflow-x: auto;
    }
    .po-step {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        white-space: nowrap;
        transition: color var(--ease);
    }
    .po-step.active {
        color: var(--primary);
        font-weight: 700;
    }
    .po-step.completed {
        color: var(--success);
    }
    .po-step-circle {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--text-muted);
    }
    .po-step.active .po-step-circle {
        background: var(--primary-dim);
        border-color: var(--primary);
        color: var(--primary);
        box-shadow: 0 0 12px var(--primary-dim);
    }
    .po-step.completed .po-step-circle {
        background: var(--success-dim);
        border-color: var(--success);
        color: var(--success);
    }
    .po-step-divider {
        flex: 1;
        min-width: 20px;
        height: 2px;
        background: var(--border);
        border-radius: 2px;
    }
    .po-step-divider.completed {
        background: var(--success);
    }

    /* Breadcrumbs */
    .po-breadcrumbs {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text-muted);
        margin-bottom: 12px;
        flex-wrap: wrap;
    }
    .po-breadcrumbs a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color var(--ease);
    }
    .po-breadcrumbs a:hover {
        color: var(--primary);
    }
    .po-breadcrumbs .current {
        color: var(--primary);
        font-weight: 700;
    }

    /* Master Dropdown Bar */
    .master-filter-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 18px 20px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    }

    /* Supplier & Brand Cards */
    .brand-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        transition: all 0.25s var(--ease);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
        height: 100%;
        text-decoration: none;
        color: inherit;
    }
    .brand-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary);
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25), 0 0 16px var(--primary-dim);
        color: inherit;
    }
    .brand-icon-wrap {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: var(--primary-dim);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 800;
        color: var(--primary);
        margin-bottom: 16px;
        border: 1px solid var(--border);
        transition: transform 0.25s var(--ease);
    }
    .brand-card:hover .brand-icon-wrap {
        transform: scale(1.08);
        background: var(--primary);
        color: #fff;
    }

    /* Product Card */
    .po-prod-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 16px;
        transition: all 0.2s var(--ease);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
    }
    .po-prod-card:hover {
        border-color: var(--primary);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }
    .po-prod-img-wrap {
        width: 100%;
        height: 160px;
        background: var(--bg);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 14px;
        border: 1px solid var(--border);
        position: relative;
    }
    .po-prod-img-wrap img {
        max-height: 140px;
        max-width: 90%;
        object-fit: contain;
        transition: transform 0.25s var(--ease);
    }
    .po-prod-card:hover .po-prod-img-wrap img {
        transform: scale(1.05);
    }

    /* Cart Sidebar */
    .po-cart-sidebar {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px;
        position: sticky;
        top: 80px;
    }
    .cart-item-row {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 10px 12px;
        margin-bottom: 10px;
        transition: border-color var(--ease);
    }
    .cart-item-row:hover {
        border-color: var(--primary);
    }
    .cart-qty-btn {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--bg-card);
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        transition: all 0.15s;
    }
    .cart-qty-btn:hover {
        background: var(--primary);
        color: #fff;
        border-color: var(--primary);
    }
</style>

<!-- Breadcrumbs Hierarchy -->
<div class="po-breadcrumbs">
    <a href="@Url.Action("Index")"><i class="bi bi-cart4 me-1"></i>Order Management</a>
    <i class="bi bi-chevron-right" style="font-size:10px"></i>
    @if (!hasSupplier)
    {
        <span class="current">Select Supplier</span>
    }
    else
    {
        <a href="@Url.Action("Create")">@(selectedSupplier?.DisplayVendorName ?? selectedSupplier?.CompanyName)</a>
        <i class="bi bi-chevron-right" style="font-size:10px"></i>
        @if (!hasBrand)
        {
            <span class="current">Select Brand</span>
        }
        else
        {
            <a href="@Url.Action("Create", new { selectedSupplierId = selectedSupplierId })">Brands</a>
            <i class="bi bi-chevron-right" style="font-size:10px"></i>
            <span class="current">@selectedBrand Products</span>
        }
    }
</div>

<!-- Page Header -->
<div class="ph mb-3">
    <div>
        <h1 class="ph-title">
            <i class="bi bi-bag-plus me-2" style="color:var(--primary)"></i>Create Supplier Purchase Order
        </h1>
        <p class="ph-sub">
            @if (!hasSupplier)
            {
                <span>Step 1: Choose a supplier vendor using the dropdown or vendor cards below</span>
            }
            else if (!hasBrand)
            {
                <span>Step 2: Select a mobile phone brand supplied by <strong style="color:var(--primary)">@selectedSupplier?.DisplayVendorName</strong> (@selectedSupplier?.DisplayCompanyName)</span>
            }
            else
            {
                <span>Step 3: Browse and select <strong style="color:var(--primary)">@selectedBrand</strong> devices supplied by <strong>@selectedSupplier?.DisplayVendorName</strong> (@selectedSupplier?.DisplayCompanyName)</span>
            }
        </p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Index")" class="btn-d btn-outline">
            <i class="bi bi-arrow-left me-1"></i> Order Management
        </a>
    </div>
</div>

<!-- Step Navigation Bar -->
<div class="po-stepper">
    <a href="@Url.Action("Create")" class="po-step @(stepNumber == 1 ? "active" : "completed")">
        <div class="po-step-circle">
            @if (stepNumber > 1) { <i class="bi bi-check-lg"></i> } else { <span>1</span> }
        </div>
        <span>1. Supplier @(hasSupplier ? $"({selectedSupplier?.DisplayVendorName})" : "")</span>
    </a>
    
    <div class="po-step-divider @(stepNumber > 1 ? "completed" : "")"></div>

    <a href="@(hasSupplier ? Url.Action("Create", new { selectedSupplierId = selectedSupplierId }) : "javascript:void(0)")" 
       class="po-step @(stepNumber == 2 ? "active" : (stepNumber > 2 ? "completed" : ""))"
       style="@(!hasSupplier ? "pointer-events:none;opacity:0.6" : "")">
        <div class="po-step-circle">
            @if (stepNumber > 2) { <i class="bi bi-check-lg"></i> } else { <span>2</span> }
        </div>
        <span>2. Brand @(hasBrand ? $"({selectedBrand})" : "")</span>
    </a>

    <div class="po-step-divider @(stepNumber > 2 ? "completed" : "")"></div>

    <div class="po-step @(stepNumber == 3 ? "active" : "")">
        <div class="po-step-circle">3</div>
        <span>3. Products</span>
    </div>

    <div class="po-step-divider"></div>

    <div class="po-step">
        <div class="po-step-circle">4</div>
        <span>4. Review Order</span>
    </div>
</div>

<!-- ========================================================
     MASTER HIERARCHY DROPDOWNS BAR (SUPPLIER, BRAND, PRODUCT, PRICE)
     ======================================================== -->
<div class="master-filter-card">
    <form method="get" class="row g-2 align-items-end" id="masterHierarchyForm">
        <!-- 1. Supplier Name Dropdown -->
        <div class="col-lg-3 col-md-6">
            <label class="fg-label">
                <i class="bi bi-truck me-1 text-primary"></i>Supplier Name
            </label>
            <select name="selectedSupplierId" class="fg-control" onchange="onSupplierDropdownChange(this)">
                <option value="">-- Choose Supplier Name --</option>
                @foreach (var sup in suppliers)
                {
                    int pCount = supplierProductCounts.TryGetValue(sup.Id, out var count) ? count : 0;
                    <option value="@sup.Id" selected="@(selectedSupplierId == sup.Id)">
                        @sup.DisplayVendorName — @sup.DisplayCompanyName (@pCount Products)
                    </option>
                }
            </select>
        </div>

        <!-- 2. Brand Name Dropdown -->
        <div class="col-lg-3 col-md-6">
            <label class="fg-label">
                <i class="bi bi-phone me-1 text-info"></i>Brand Name
            </label>
            <select name="brand" class="fg-control" onchange="onBrandDropdownChange(this)" @(!hasSupplier ? "disabled" : "")>
                <option value="">@(hasSupplier ? "-- Choose Brand Name --" : "-- Select Supplier First --")</option>
                @foreach (var b in availableBrands)
                {
                    <option value="@b.Brand" selected="@(string.Equals(selectedBrand, b.Brand, StringComparison.OrdinalIgnoreCase))">
                        @b.Brand (@b.ProductCount Products)
                    </option>
                }
            </select>
        </div>

        <!-- 3. Product Name Dropdown -->
        <div class="col-lg-3 col-md-6">
            <label class="fg-label">
                <i class="bi bi-box-seam me-1 text-success"></i>Product Name
            </label>
            <select name="productName" class="fg-control" onchange="this.form.submit()" @(!hasBrand ? "disabled" : "")>
                <option value="">@(hasBrand ? "-- All Product Names --" : "-- Select Brand First --")</option>
                @foreach (var pName in availableProductNames)
                {
                    <option value="@pName" selected="@(string.Equals(selectedProductName, pName, StringComparison.OrdinalIgnoreCase))">
                        @pName
                    </option>
                }
            </select>
        </div>

        <!-- 4. Price Sort Dropdown (LOW TO HIGH / HIGH TO LOW) -->
        <div class="col-lg-2 col-md-4">
            <label class="fg-label">
                <i class="bi bi-arrow-down-up me-1 text-warning"></i>Sort Price
            </label>
            <select name="sortBy" class="fg-control" onchange="this.form.submit()">
                <option value="price_asc" selected="@(sortBy == "price_asc")">Price: Low to High (₹)</option>
                <option value="price_desc" selected="@(sortBy == "price_desc")">Price: High to Low (₹)</option>
                <option value="newest" selected="@(sortBy == "newest")">Newest In Catalog</option>
                <option value="stock_desc" selected="@(sortBy == "stock_desc")">Stock: High to Low</option>
            </select>
        </div>

        <!-- 5. Reset Dropdowns Button -->
        <div class="col-lg-1 col-md-2 d-flex">
            <a href="@Url.Action("Create")" class="btn-d btn-outline w-100 text-center" title="Reset All Dropdown Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<div class="row g-4">
    <!-- Main Content Area -->
    <div class="@(hasSupplier ? "col-xl-8 col-lg-8" : "col-12")">

        @* ========================================================
           STEP 1: SUPPLIER SELECTION & CARDS
           ======================================================== *@
        @if (!hasSupplier)
        {
            <div class="card-d card-p-lg mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                    <div>
                        <h4 class="mb-1" style="font-weight:800;color:var(--text-primary)"><i class="bi bi-truck me-2 text-primary"></i>Available Supplier Vendors</h4>
                        <p class="mb-0 text-muted" style="font-size:13px">Select a supplier from the dropdown above or click on any vendor card below.</p>
                    </div>
                    <div style="min-width:240px">
                        <input type="text" id="supplierSearchInput" class="fg-control" placeholder="Quick filter suppliers..." oninput="filterSupplierCards()" />
                    </div>
                </div>

                @if (!suppliers.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-exclamation-circle text-warning d-block mb-3" style="font-size:42px"></i>
                        <h5 style="color:var(--text-primary)">No Active Suppliers Registered</h5>
                        <p>Please register suppliers in the Supplier Directory before creating purchase orders.</p>
                        <a href="/Supplier/Create" class="btn-d btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New Supplier</a>
                    </div>
                }
                else
                {
                    <div class="row g-3" id="supplierGrid">
                        @foreach (var sup in suppliers)
                        {
                            int pCount = supplierProductCounts.TryGetValue(sup.Id, out var count) ? count : 0;
                            var supJson = System.Text.Json.JsonSerializer.Serialize(sup);
                            <div class="col-md-6 col-xl-4 supplier-item-card" data-keywords="@((sup.DisplayVendorName ?? "").ToLower()) @((sup.DisplayCompanyName ?? "").ToLower()) @((sup.DisplayContactPerson ?? "").ToLower()) @((sup.Phone ?? "").ToLower()) @((sup.City ?? "").ToLower())">
                                <div class="card-d card-p h-100 d-flex flex-column justify-content-between" style="background:var(--bg);border:1px solid var(--border)">
                                    <div>
                                        <div class="d-flex align-items-start justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div style="width:38px;height:38px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:18px">
                                                    <i class="bi bi-shop"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold" style="color:var(--text-primary)">@sup.DisplayVendorName</h6>
                                                    <div style="font-size:12px;color:var(--text-muted);font-weight:500" class="mt-0.5">@sup.DisplayCompanyName</div>
                                                    @if (!string.IsNullOrWhiteSpace(sup.DisplayContactPerson) && sup.DisplayContactPerson != sup.DisplayCompanyName && sup.DisplayContactPerson != sup.DisplayVendorName)
                                                    {
                                                        <span class="text-muted" style="font-size:11px"><i class="bi bi-person me-1"></i>@sup.DisplayContactPerson</span>
                                                    }
                                                </div>
                                            </div>
                                            <span class="badge-d @(pCount > 0 ? "badge-info" : "badge-gray")" style="font-size:11px">
                                                @pCount Products
                                            </span>
                                        </div>

                                        <div class="p-2 rounded my-2" style="background:var(--bg-card);border:1px solid var(--border);font-size:12px">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted"><i class="bi bi-telephone me-1"></i>Phone:</span>
                                                <span class="fw-semibold">@(string.IsNullOrEmpty(sup.Phone) ? "-" : sup.Phone)</span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted"><i class="bi bi-envelope me-1"></i>Email:</span>
                                                <span class="fw-semibold text-truncate" style="max-width:140px">@(string.IsNullOrEmpty(sup.Email) ? "-" : sup.Email)</span>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span class="text-muted"><i class="bi bi-geo-alt me-1"></i>City:</span>
                                                <span class="fw-semibold">@sup.City</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 mt-2">
                                        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="openDirectSupplierModal('@sup.Id')" title="View full supplier vendor profile">
                                            <i class="bi bi-info-circle"></i>
                                        </button>
                                        <a href="@Url.Action("Create", new { selectedSupplierId = sup.Id })" class="btn-d btn-primary btn-sm-d w-100 text-center">
                                            <span>Select Supplier</span> <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* ========================================================
           STEP 2: BRAND SELECTION & CARDS
           ======================================================== *@
        @if (hasSupplier && !hasBrand)
        {
            <!-- Active Supplier Banner -->
            <div class="card-d card-p mb-4" style="background:var(--bg-card);border:1px solid var(--border)">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:48px;height:48px;border-radius:12px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:22px">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div>
                            <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;font-weight:700">Selected Supplier Vendor</div>
                            <h4 class="mb-0" style="font-weight:800;color:var(--text-primary)">@selectedSupplier?.DisplayVendorName</h4>
                            <div style="font-size:13px;color:var(--text-secondary);font-weight:600">@selectedSupplier?.DisplayCompanyName</div>
                            <div style="font-size:12px;color:var(--text-muted)">
                                Contact: <strong class="text-secondary">@selectedSupplier?.ContactPerson</strong> · 
                                Phone: <strong class="text-secondary">@selectedSupplier?.Phone</strong> · 
                                Email: <strong class="text-secondary">@selectedSupplier?.Email</strong>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="openDirectSupplierModal('@selectedSupplier?.Id')">
                            <i class="bi bi-card-text me-1"></i> Vendor Profile
                        </button>
                        <a href="@Url.Action("Create")" class="btn-d btn-outline btn-sm-d">
                            <i class="bi bi-arrow-left-right me-1"></i> Change Supplier
                        </a>
                    </div>
                </div>
            </div>

            <!-- Brand Selection Title -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h5 class="mb-1" style="font-weight:800;color:var(--text-primary)"><i class="bi bi-grid me-2 text-primary"></i>Select Brand</h5>
                    <p class="text-muted mb-0" style="font-size:13px">Choose from the brand dropdown above or click on any brand card below.</p>
                </div>
                <span class="badge-d badge-primary" style="font-size:12px">@availableBrands.Count Brands Available</span>
            </div>

            @if (!availableBrands.Any())
            {
                <div class="card-d card-p p-5 text-center text-muted">
                    <i class="bi bi-box-seam text-warning d-block mb-3" style="font-size:42px"></i>
                    <h5 style="color:var(--text-primary)">No Products Available for this Supplier</h5>
                    <p>There are no products currently associated with @selectedSupplier?.CompanyName.</p>
                    <a href="@Url.Action("Create")" class="btn-d btn-primary"><i class="bi bi-arrow-left me-1"></i> Choose Another Supplier</a>
                </div>
            }
            else
            {
                <div class="row g-3 mb-4" id="brandGrid">
                    @foreach (var b in availableBrands)
                    {
                        var brandName = b.Brand;
                        var isApple = brandName.Equals("Apple", StringComparison.OrdinalIgnoreCase);

                        <div class="col-xl-4 col-md-6 brand-item-card" data-brand="@brandName.ToLower()">
                            <a href="@Url.Action("Create", new { selectedSupplierId = selectedSupplierId, brand = brandName })" class="brand-card">
                                <div>
                                    <div class="d-flex align-items-start justify-content-between">
                                        <div class="brand-icon-wrap">
                                            @if (isApple)
                                            {
                                                <i class="bi bi-apple"></i>
                                            }
                                            else
                                            {
                                                <span>@brandName.Substring(0, Math.Min(2, brandName.Length)).ToUpper()</span>
                                            }
                                        </div>
                                        <span class="badge-d badge-success" style="font-size:11px">
                                            @b.ProductCount @(b.ProductCount == 1 ? "Product" : "Products")
                                        </span>
                                    </div>

                                    <h4 class="mb-1" style="font-weight:800;color:var(--text-primary)">@brandName</h4>
                                    
                                    @if (b.SampleModels.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @foreach (var sample in b.SampleModels)
                                            {
                                                <span class="badge-d badge-gray" style="font-size:10px">@sample</span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between" style="border-color:var(--border)!important">
                                    <span style="font-size:12px;font-weight:700;color:var(--primary)">Browse @brandName Products</span>
                                    <i class="bi bi-arrow-right text-primary"></i>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        }

        @* ========================================================
           STEP 3: BRAND PRODUCTS CATALOG (Supplier & Brand selected)
           ======================================================== *@
        @if (hasSupplier && hasBrand)
        {
            <!-- Brand & Supplier Context Header -->
            <div class="card-d card-p mb-3" style="background:var(--bg-card);border:1px solid var(--border)">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <a href="@Url.Action("Create", new { selectedSupplierId = selectedSupplierId })" class="btn-d btn-outline btn-sm-d" title="Return to Brand Selection">
                            <i class="bi bi-arrow-left me-1"></i> Back to Brands
                        </a>
                        <div>
                            <div style="font-size:11px;color:var(--text-muted)">
                                Supplier: <strong class="text-primary">@selectedSupplier?.DisplayVendorName</strong>
                                <span class="text-muted">(@selectedSupplier?.DisplayCompanyName)</span>
                            </div>
                            <h4 class="mb-0" style="font-weight:800;color:var(--text-primary)">
                                @selectedBrand Products
                                <span class="badge-d badge-info ms-2" style="font-size:12px;vertical-align:middle">@Model.Count() Devices</span>
                            </h4>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn-d btn-outline btn-sm-d" onclick="openDirectSupplierModal('@selectedSupplier?.Id')">
                            <i class="bi bi-truck me-1"></i> Supplier Profile
                        </button>
                    </div>
                </div>
            </div>

            <!-- In-Brand Advanced Filter Bar (Price Range & Model Name) -->
            <div class="card-d card-p mb-4" style="background:var(--bg);border:1px solid var(--border)">
                <form method="get" class="row g-2 align-items-end" id="productFilterForm">
                    <input type="hidden" name="selectedSupplierId" value="@selectedSupplierId" />
                    <input type="hidden" name="brand" value="@selectedBrand" />
                    <input type="hidden" name="productName" value="@selectedProductName" />
                    <input type="hidden" name="sortBy" value="@sortBy" />

                    <!-- Search Input -->
                    <div class="col-md-3">
                        <label class="fg-label"><i class="bi bi-search me-1 text-primary"></i>Keyword Search</label>
                        <input type="text" name="search" value="@search" class="fg-control" placeholder="Search SKU, RAM, Color..." />
                    </div>

                    <!-- Model Name Filter Dropdown -->
                    <div class="col-md-3">
                        <label class="fg-label"><i class="bi bi-phone me-1 text-info"></i>Model Name</label>
                        <select name="modelName" class="fg-control" onchange="this.form.submit()">
                            <option value="">All @selectedBrand Models</option>
                            @foreach (var m in availableModels)
                            {
                                <option value="@m" selected="@(string.Equals(selectedModelName, m, StringComparison.OrdinalIgnoreCase))">@m</option>
                            }
                        </select>
                    </div>

                    <!-- Min Price -->
                    <div class="col-md-2">
                        <label class="fg-label"><i class="bi bi-currency-rupee me-1 text-success"></i>Min Price (₹)</label>
                        <input type="number" name="minPrice" value="@minPrice" class="fg-control" placeholder="Min ₹" min="0" step="500" />
                    </div>

                    <!-- Max Price -->
                    <div class="col-md-2">
                        <label class="fg-label"><i class="bi bi-currency-rupee me-1 text-success"></i>Max Price (₹)</label>
                        <input type="number" name="maxPrice" value="@maxPrice" class="fg-control" placeholder="Max ₹" min="0" step="500" />
                    </div>

                    <!-- Apply & Reset Buttons -->
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn-d btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
                        <a href="@Url.Action("Create", new { selectedSupplierId = selectedSupplierId, brand = selectedBrand })" class="btn-d btn-outline" title="Clear Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>

            <!-- Product Grid -->
            @if (!Model.Any())
            {
                <div class="card-d card-p p-5 text-center text-muted">
                    <i class="bi bi-search text-muted d-block mb-3" style="font-size:42px"></i>
                    <h5 style="color:var(--text-primary)">No @selectedBrand Products Match Your Filter Criteria</h5>
                    <p class="mb-3">Try adjusting your price range, model filter, or product name dropdown above.</p>
                    <a href="@Url.Action("Create", new { selectedSupplierId = selectedSupplierId, brand = selectedBrand })" class="btn-d btn-primary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Clear All Product Filters
                    </a>
                </div>
            }
            else
            {
                <div class="row g-3 mb-4">
                    @foreach (var p in Model)
                    {
                        var supplierPrice = p.SupplierPrice > 0 ? p.SupplierPrice : p.PurchasePrice;
                        var prodJson = System.Text.Json.JsonSerializer.Serialize(p);
                        var supJson = selectedSupplier != null ? System.Text.Json.JsonSerializer.Serialize(selectedSupplier) : "null";
                        var isLowStock = p.CurrentStock <= p.MinimumStock;
                        var hasImage = !string.IsNullOrWhiteSpace(p.ImageUrl);

                        <div class="col-xl-4 col-md-6">
                            <div class="po-prod-card">
                                <div>
                                    <!-- Image Thumbnail -->
                                    <div class="po-prod-img-wrap">
                                        @if (hasImage)
                                        {
                                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted">
                                                <i class="bi bi-phone" style="font-size:44px;color:var(--text-muted)"></i>
                                                <div style="font-size:10px;text-transform:uppercase;font-weight:700">@p.Brand</div>
                                            </div>
                                        }

                                        <!-- Stock Pill -->
                                        <div style="position:absolute;top:8px;right:8px">
                                            <span class="badge-d @(p.CurrentStock <= 0 ? "badge-danger" : (isLowStock ? "badge-warning" : "badge-success"))" style="font-size:10px">
                                                Stock: @p.CurrentStock
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Basic Info -->
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="badge-d badge-gray" style="font-size:10px">@p.Brand</span>
                                        <span class="text-muted" style="font-size:11px">SKU: @p.Code</span>
                                    </div>

                                    <h6 class="mb-1 text-truncate" style="font-weight:800;color:var(--text-primary)" title="@p.Name">@p.Name</h6>
                                    
                                    <div class="text-muted mb-2" style="font-size:12px">
                                        @(string.IsNullOrEmpty(p.Variant) ? $"{p.Ram} / {p.Storage}" : p.Variant)
                                        @if (!string.IsNullOrEmpty(p.Color)) { <span>· @p.Color</span> }
                                    </div>

                                    <!-- Supplier Price Box -->
                                    <div class="p-2 rounded mb-3" style="background:var(--bg);border:1px solid var(--border)">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span style="font-size:11px;color:var(--text-muted)">Supplier Cost:</span>
                                            <span style="font-size:16px;font-weight:800;color:var(--primary)">₹@supplierPrice.ToString("N2")</span>
                                        </div>
                                        @if (p.SellingPrice > 0)
                                        {
                                            <div class="d-flex align-items-center justify-content-between mt-1">
                                                <span style="font-size:10px;color:var(--text-muted)">Shop Retail Price:</span>
                                                <span style="font-size:11px;font-weight:600;color:var(--text-secondary)">₹@p.SellingPrice.ToString("N2")</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn-d btn-outline btn-sm-d w-50" onclick='openProductSpecsModal(@Html.Raw(prodJson), @Html.Raw(supJson))'>
                                        <i class="bi bi-info-circle me-1"></i> Specs
                                    </button>
                                    <button type="button" class="btn-d btn-primary btn-sm-d w-50" onclick='openQtyStepperModal(@Html.Raw(prodJson), @supplierPrice)'>
                                        <i class="bi bi-cart-plus me-1"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

    </div>

    <!-- Right-Hand Live Purchase Cart Sidebar -->
    @if (hasSupplier)
    {
        <div class="col-xl-4 col-lg-4">
            <div class="po-cart-sidebar">
                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2" style="border-color:var(--border)!important">
                    <div>
                        <h5 class="mb-0" style="font-weight:800;color:var(--text-primary)">
                            <i class="bi bi-cart-check me-2 text-primary"></i>Order Basket
                        </h5>
                        <div style="font-size:11px;color:var(--text-muted)">Vendor: <strong class="text-primary">@selectedSupplier?.DisplayVendorName</strong> <span class="text-muted">(@selectedSupplier?.DisplayCompanyName)</span></div>
                    </div>
                    <button type="button" class="btn btn-link btn-sm text-danger p-0" onclick="clearCart()" title="Clear entire order basket" style="font-size:12px;text-decoration:none">
                        <i class="bi bi-trash3 me-1"></i>Clear
                    </button>
                </div>

                <div id="cartEmptyState" class="py-4 text-center text-muted" style="display:none">
                    <i class="bi bi-cart-x text-muted d-block mb-2" style="font-size:32px"></i>
                    <div style="font-size:13px;font-weight:600">Your basket is empty</div>
                    <div style="font-size:11px">Select a brand and add mobile products to build your purchase order.</div>
                </div>

                <div id="cartItemsList" style="max-height:380px;overflow-y:auto;padding-right:4px">
                    <!-- Populated dynamically via JS -->
                </div>

                <!-- Basket Summary & Totals -->
                <div id="cartSummaryBox" class="mt-3 pt-3 border-top" style="border-color:var(--border)!important">
                    <div class="d-flex justify-content-between mb-1" style="font-size:13px">
                        <span class="text-muted">Total Devices:</span>
                        <span class="fw-bold" id="cartTotalQty">0 Units</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="font-size:14px;font-weight:700;color:var(--text-primary)">Estimated Subtotal:</span>
                        <span style="font-size:18px;font-weight:800;color:var(--success)" id="cartSubtotal">₹0.00</span>
                    </div>

                    <!-- Submission Form to Review -->
                    <form asp-action="Review" method="post" id="poSubmitReviewForm">
                        <input type="hidden" name="supplierId" value="@selectedSupplierId" />
                        <div id="cartHiddenInputs"></div>

                        <button type="submit" class="btn-d btn-primary w-100 btn-lg-d" id="btnProceedReview">
                            <i class="bi bi-clipboard-check me-1"></i> Review Purchase Order
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@* ========================================================
   MODAL 1: COMPLETE PRODUCT HARDWARE SPECS (Product.Specs)
   ======================================================== *@
<div class="modal fade" id="productSpecsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;color:var(--text-primary)">
            <div class="modal-header border-bottom" style="border-color:var(--border)!important">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:38px;height:38px;border-radius:10px;background:var(--primary-dim);display:flex;align-items:center;justify-content:center;color:var(--primary)">
                        <i class="bi bi-phone" style="font-size:20px"></i>
                    </div>
                    <div>
                        <h5 class="modal-title mb-0" id="ps_Name" style="font-weight:800">Product Hardware Specs</h5>
                        <div style="font-size:12px;color:var(--text-muted)" id="ps_Code">SKU Details</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
