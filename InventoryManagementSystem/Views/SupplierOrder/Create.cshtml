                        </div>
                        <div id="ps_ThumbStrip" class="d-flex flex-wrap gap-2 overflow-auto" style="max-height:80px"></div>
                        
                        <!-- Quick Add Stepper inside Details Modal -->
                        <div class="p-3 rounded mt-3" style="background:var(--bg);border:1px solid var(--border)">
                            <div style="font-size:11px;color:var(--text-muted);font-weight:700;text-transform:uppercase" class="mb-2">Quick Add to Order</div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span style="font-size:12px;color:var(--text-muted)">Supplier Price:</span>
                                <span style="font-size:15px;font-weight:800;color:var(--primary)" id="ps_QuickPrice">₹0.00</span>
