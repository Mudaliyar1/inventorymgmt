@{
    ViewData["Title"] = "Error";
}

<div class="text-center p-5 glass-card mx-auto mt-5" style="max-width: 500px;">
    <i class="bi bi-exclamation-octagon-fill text-danger d-block" style="font-size: 4rem;"></i>
    <h1 class="text-danger fw-bold mt-3">Oops! Something went wrong</h1>
    <p class="text-secondary mt-3">An error occurred while processing your request. Please try again or contact your administrator if the issue persists.</p>
    <a href="/" class="btn btn-primary mt-4 px-4 rounded-pill"><i class="bi bi-house-door-fill me-2"></i>Go to Dashboard</a>
</div>
