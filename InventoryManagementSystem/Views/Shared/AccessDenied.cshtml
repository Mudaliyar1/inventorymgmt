@{
    ViewData["Title"] = "403 - Access Denied";
    Layout = "_Layout";
}

<div class="d-flex align-items-center justify-content-center" style="min-height:75vh">
    <div class="card-d card-p-lg text-center" style="max-width:560px;width:100%;border:1px solid var(--danger-dim);background:var(--card-bg)">
        <div class="mb-4">
            <div style="width:72px;height:72px;border-radius:50%;background:var(--danger-dim);color:var(--danger);display:inline-flex;align-items:center;justify-content:center;font-size:36px">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
        </div>

        <h2 style="font-weight:800;color:var(--text-primary);margin-bottom:8px">403 - Access Denied</h2>
        <p style="color:var(--text-secondary);font-size:14px;line-height:1.6;margin-bottom:24px">
            You do not have authorization to view this module or perform this action.
            <br />
            If you believe this is an error, please contact your System Administrator to request permission access.
        </p>

        <div class="d-flex align-items-center justify-content-center gap-3">
            <a href="@Url.Action("Index","Home")" class="btn-d btn-primary">
                <i class="bi bi-grid-1x2 me-1"></i> Back to Dashboard
            </a>
            <button onclick="history.back()" class="btn-d btn-outline">
                <i class="bi bi-arrow-left me-1"></i> Go Back
            </button>
        </div>
    </div>
</div>
