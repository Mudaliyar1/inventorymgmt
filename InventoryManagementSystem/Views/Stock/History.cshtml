@model StockHistoryViewModel
@{
    ViewData["Title"] = "Stock History";
    bool hasActiveFilters = !string.IsNullOrEmpty(Model.SearchTerm) ||
                            !string.IsNullOrEmpty(Model.Type) ||
                            !string.IsNullOrEmpty(Model.CategoryId) ||
                            !string.IsNullOrEmpty(Model.ProductId) ||
                            Model.StartDate.HasValue ||
                            Model.EndDate.HasValue ||
                            !string.IsNullOrEmpty(Model.ExecutedBy);
}

<div class="ph">
    <div>
        <h1 class="ph-title">Stock History</h1>
        <p class="ph-sub">Full audit trail and detailed log of all inventory transactions.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("StockIn","Stock")" class="btn-d btn-outline btn-sm-d">
            <i class="bi bi-arrow-down-circle text-success"></i> Stock In
        </a>
        <a href="@Url.Action("StockOut","Stock")" class="btn-d btn-outline btn-sm-d">
            <i class="bi bi-arrow-up-circle text-danger"></i> Stock Out
        </a>
        <a href="@Url.Action("Adjust","Stock")" class="btn-d btn-outline btn-sm-d">
            <i class="bi bi-sliders text-info"></i> Adjust
        </a>
    </div>
</div>

<!-- Collapsible Detailed Filter Panel (Closed by Default) -->
<div class="card-d mb-4">
    <!-- Filter Toggle Header -->
    <div class="card-p d-flex align-items-center justify-content-between flex-wrap gap-2"
         onclick="toggleFilterPanel()" style="cursor:pointer;user-select:none">
        <div class="d-flex align-items-center gap-2">
            <span class="badge-d badge-blue" style="font-size:14px;padding:6px 10px"><i class="bi bi-funnel-fill"></i></span>
            <div>
                <div style="font-size:14px;font-weight:700;color:var(--text-primary);display:flex;align-items:center;gap:6px">
                    Filter & Search Audit Trail
                    @if (hasActiveFilters)
                    {
                        <span class="badge-d badge-blue">Active Filters</span>
                    }
                </div>
                <div style="font-size:12px;color:var(--text-muted)">
                    @(hasActiveFilters ? "Click to modify active filter criteria" : "Click to expand search, category, product & date/time filters")
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation()">
            @if (hasActiveFilters)
            {
                <a href="@Url.Action("History","Stock")" class="btn-d btn-ghost btn-sm-d">
                    <i class="bi bi-x-circle me-1"></i> Clear Filters
                </a>
            }
            <button type="button" class="btn-d btn-outline btn-sm-d" onclick="toggleFilterPanel()">
                <i class="bi bi-sliders me-1"></i> <span id="filter-toggle-text">@(hasActiveFilters ? "Hide Filters" : "Show Filters")</span>
                <i class="bi bi-chevron-@(hasActiveFilters ? "up" : "down") ms-1" id="filter-toggle-chevron"></i>
            </button>
        </div>
    </div>

    <!-- Collapsible Filter Form Body (Closed by default unless active filters applied) -->
    <div id="filter-panel-body" class="card-p-lg border-top" style="display:@(hasActiveFilters ? "block" : "none");border-color:var(--border)!important">
        <form method="get" asp-action="History" id="history-filter-form">
            <div class="row g-3">
                <!-- General Keyword Search -->
                <div class="col-lg-4 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">Search Anything</label>
                        <div class="fg-icon-wrap">
                            <i class="bi bi-search fg-icon"></i>
                            <input type="search" name="searchTerm" value="@Model.SearchTerm" class="fg-control" style="height:38px"
                                   placeholder="Search reason, SKU, user, product…">
                        </div>
                    </div>
                </div>

                <!-- Transaction Type Filter -->
                <div class="col-lg-2 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">Transaction Type</label>
                        <select name="type" asp-items="Model.TransactionTypes" class="fg-control" style="height:38px">
                        </select>
                    </div>
                </div>

                <!-- Category Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">Product Category</label>
                        <select name="categoryId" asp-items="Model.Categories" class="fg-control" style="height:38px">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                </div>

                <!-- Product Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">Specific Product</label>
                        <select name="productId" asp-items="Model.Products" class="fg-control" style="height:38px">
                            <option value="">All Products</option>
                        </select>
                    </div>
                </div>

                <!-- Start Date & Time Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">From Date & Time (IST)</label>
                        <input type="datetime-local" name="startDate"
                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
                               class="fg-control" style="height:38px">
                    </div>
                </div>

                <!-- End Date & Time Filter -->
                <div class="col-lg-3 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">To Date & Time (IST)</label>
                        <input type="datetime-local" name="endDate"
                               value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
                               class="fg-control" style="height:38px">
                    </div>
                </div>

                <!-- Executed By User -->
                <div class="col-lg-3 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">Executed By (User)</label>
                        <input type="text" name="executedBy" value="@Model.ExecutedBy" class="fg-control" style="height:38px"
                               placeholder="e.g. admin">
                    </div>
                </div>

                <!-- Items Per Page -->
                <div class="col-lg-3 col-md-6">
                    <div class="fg mb-0">
                        <label class="fg-label" style="font-size:12px">Records Per Page</label>
                        <select name="pageSize" class="fg-control" style="height:38px" onchange="this.form.submit()">
                            <option value="15" selected="@(Model.PageSize == 15)">15 per page</option>
                            <option value="25" selected="@(Model.PageSize == 25)">25 per page</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                            <option value="100" selected="@(Model.PageSize == 100)">100 per page</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-end gap-2 mt-3 pt-3 border-top" style="border-color:var(--border)!important">
                <a href="@Url.Action("History","Stock")" class="btn-d btn-ghost btn-sm-d">
                    <i class="bi bi-x-circle me-1"></i> Reset
                </a>
                <button type="submit" class="btn-d btn-primary btn-sm-d">
                    <i class="bi bi-search me-1"></i> Apply Filters
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Transactions Table Wrapper -->
<div class="tbl-wrap">
    <div class="tbl-toolbar">
        <div>
            <span class="tbl-title">Audit Trail Transactions</span>
            <span class="tbl-count">@Model.TotalItems total record@(Model.TotalItems == 1 ? "" : "s")</span>
        </div>
        <div class="ms-auto d-flex align-items-center gap-2">
            <!-- Client instant quick filter on current page -->
            <div class="tbl-search">
                <i class="bi bi-search tbl-search-icon"></i>
                <input type="search" data-tbl-search="history-table" placeholder="Quick filter table…">
            </div>
        </div>
    </div>

    <div class="tbl-scroll">
        <table class="tbl" id="history-table">
            <thead>
                <tr>
                    <th>Date & Time (IST)</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Previous</th>
                    <th>Change</th>
                    <th>Current</th>
                    <th class="d-none d-md-table-cell">Reason / Reference</th>
                    <th class="d-none d-lg-table-cell">Executed By</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions != null && Model.Transactions.Any())
                {
                    @foreach (var tx in Model.Transactions)
                    {
                        var productName = Model.ProductNames.TryGetValue(tx.ProductId, out var name) ? name : "Unknown";
                        var productCode = Model.ProductCodes.TryGetValue(tx.ProductId, out var code) ? code : "N/A";
                        var categoryName = Model.ProductCategories.TryGetValue(tx.ProductId, out var cat) ? cat : "General";
                        var diff = tx.Type == "Stock In" ? tx.Quantity
                                 : tx.Type == "Stock Out" ? -tx.Quantity
                                 : tx.CurrentStock - tx.PreviousStock;

                        <tr>
                            <td style="color:var(--text-muted);font-size:12px;white-space:nowrap">
                                <i class="bi bi-clock me-1"></i>@tx.Timestamp.ToIstString("MMM d, yyyy HH:mm IST")
                            </td>
                            <td>
                                <div class="td-strong">@productName</div>
                                <div class="code-pill">@productCode</div>
                            </td>
                            <td>
                                <span class="badge-d badge-gray">@categoryName</span>
                            </td>
                            <td>
                                @if (tx.Type == "Stock In")
                                {
                                    <span class="badge-d badge-green"><i class="bi bi-arrow-down-circle"></i> Stock In</span>
                                }
                                else if (tx.Type == "Stock Out")
                                {
                                    <span class="badge-d badge-red"><i class="bi bi-arrow-up-circle"></i> Stock Out</span>
                                }
                                else
                                {
                                    <span class="badge-d badge-sky"><i class="bi bi-sliders"></i> Adjustment</span>
                                }
                            </td>
                            <td style="color:var(--text-secondary)">@tx.PreviousStock</td>
                            <td style="font-weight:700">
                                @if (diff >= 0)
                                {
                                    <span style="color:var(--success)">+@diff</span>
                                }
                                else
                                {
                                    <span style="color:var(--danger)">@diff</span>
                                }
                            </td>
                            <td style="font-weight:700;color:var(--text-primary)">@tx.CurrentStock</td>
                            <td class="d-none d-md-table-cell" style="color:var(--text-secondary);font-size:12px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @tx.Reason
                            </td>
                            <td class="d-none d-lg-table-cell" style="color:var(--text-secondary);font-size:12px">
                                <i class="bi bi-person me-1"></i>@tx.ExecutedBy
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9">
                            <div class="empty-s">
                                <i class="bi bi-clock-history empty-s-icon"></i>
                                <div class="empty-s-title">No transactions found</div>
                                <div class="empty-s-desc">
                                    @(hasActiveFilters ? "No transactions match your current search and filter criteria. Try resetting filters." : "Stock movements will appear here after your first transaction.")
                                </div>
                                @if (hasActiveFilters)
                                {
                                    <div class="mt-3">
                                        <a href="@Url.Action("History","Stock")" class="btn-d btn-ghost btn-sm-d">
                                            <i class="bi bi-x-circle me-1"></i> Clear Filters
                                        </a>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-between px-4 py-3 border-top" style="border-color:var(--border)!important">
            <span style="font-size:12px;color:var(--text-muted)">
                Showing Page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> · <strong>@Model.TotalItems</strong> total records
            </span>
            <div class="pagi">
                <a href="@Url.Action("History", "Stock", new {
                    searchTerm = Model.SearchTerm,
                    type = Model.Type,
                    categoryId = Model.CategoryId,
                    productId = Model.ProductId,
                    startDate = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                    endDate = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                    executedBy = Model.ExecutedBy,
                    pageSize = Model.PageSize,
                    page = Model.CurrentPage - 1
                })" class="pg-btn @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <i class="bi bi-chevron-left"></i>
                </a>

                @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                {
                    <a href="@Url.Action("History", "Stock", new {
                        searchTerm = Model.SearchTerm,
                        type = Model.Type,
                        categoryId = Model.CategoryId,
                        productId = Model.ProductId,
                        startDate = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                        endDate = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                        executedBy = Model.ExecutedBy,
                        pageSize = Model.PageSize,
                        page = p
                    })" class="pg-btn @(p == Model.CurrentPage ? "active" : "")">@p</a>
                }

                <a href="@Url.Action("History", "Stock", new {
                    searchTerm = Model.SearchTerm,
                    type = Model.Type,
                    categoryId = Model.CategoryId,
                    productId = Model.ProductId,
                    startDate = Model.StartDate?.ToString("yyyy-MM-ddTHH:mm"),
                    endDate = Model.EndDate?.ToString("yyyy-MM-ddTHH:mm"),
                    executedBy = Model.ExecutedBy,
                    pageSize = Model.PageSize,
                    page = Model.CurrentPage + 1
                })" class="pg-btn @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
function toggleFilterPanel() {
    const panel = document.getElementById('filter-panel-body');
    const text = document.getElementById('filter-toggle-text');
    const chevron = document.getElementById('filter-toggle-chevron');
    if (!panel) return;

    if (panel.style.display === 'none' || getComputedStyle(panel).display === 'none') {
        panel.style.display = 'block';
        if (text) text.textContent = 'Hide Filters';
        if (chevron) { chevron.className = 'bi bi-chevron-up ms-1'; }
    } else {
        panel.style.display = 'none';
        if (text) text.textContent = 'Show Filters';
        if (chevron) { chevron.className = 'bi bi-chevron-down ms-1'; }
    }
}
</script>
}
