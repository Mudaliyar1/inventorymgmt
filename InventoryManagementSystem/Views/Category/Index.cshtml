@model IEnumerable<Category>
@using InventoryManagementSystem.Models
@{
    ViewData["Title"] = "Categories";
}

<div class="ph">
    <div>
        <h1 class="ph-title">Categories</h1>
        <p class="ph-sub">Group and classify your products into categories.</p>
    </div>
    <div class="ph-actions">
        <a href="@Url.Action("Create","Category")" class="btn-d btn-primary">
            <i class="bi bi-plus-lg"></i> Add Category
        </a>
    </div>
</div>

<div class="tbl-wrap">
    <div class="tbl-toolbar">
        <div class="tbl-search">
            <i class="bi bi-search tbl-search-icon"></i>
            <input type="search" data-tbl-search="categories-table" placeholder="Search categories…">
        </div>
        <div class="ms-auto">
            <span class="tbl-count">@(Model?.Count() ?? 0) categories</span>
        </div>
    </div>

    <div class="tbl-scroll">
        <table class="tbl" id="categories-table">
            <thead>
                <tr>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>
                                <div class="td-strong">@cat.Name</div>
                            </td>
                            <td style="color:var(--text-secondary);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @(string.IsNullOrEmpty(cat.Description) ? "—" : cat.Description)
                            </td>
                            <td>
                                @if (cat.Status == "Active")
                                {
                                    <span class="badge-d badge-green">Active</span>
                                }
                                else
                                {
                                    <span class="badge-d badge-gray">Inactive</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);white-space:nowrap;font-size:12px">
                                @cat.CreatedDate.ToIstString("MMM d, yyyy IST")
                            </td>
                            <td class="col-actions">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <a href="@Url.Action("Edit","Category",new{id=cat.Id})"
                                       class="btn-d btn-ghost btn-icon-d"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-action="Delete" asp-route-id="@cat.Id" style="margin:0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn-d btn-ghost btn-icon-d"
                                                style="color:var(--danger)"
                                                title="Delete"
                                                data-confirm="Delete category '@cat.Name'? Products in this category will be affected.">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-s">
                                <i class="bi bi-tag empty-s-icon"></i>
                                <div class="empty-s-title">No categories yet</div>
                                <div class="empty-s-desc">Create your first category to start organizing products.</div>
                                <a href="@Url.Action("Create","Category")" class="btn-d btn-primary btn-sm-d">
                                    <i class="bi bi-plus-lg"></i> Add Category
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
