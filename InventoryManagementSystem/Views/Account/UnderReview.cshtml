@{
    ViewData["Title"] = "Your Account Is Under Review — SIMS";
    Layout = "_Layout";
    var tenant = ViewBag.Tenant as InventoryManagementSystem.Models.Tenant;
    var user = ViewBag.User as InventoryManagementSystem.Models.User;
}

<div class="pz-page-wrap py-5">
    <div class="container" style="max-width: 680px;">
        <div class="pz-card p-4 p-md-5 text-center shadow-lg border border-warning" style="background: #17181B; border-radius: 20px; border-color: rgba(245, 158, 11, 0.4) !important;">
            
            <!-- Animated Review Icon -->
            <div class="mb-4 d-inline-flex align-items-center justify-content-center rounded-circle" 
                 style="width: 80px; height: 80px; background: rgba(245, 158, 11, 0.15); border: 2px solid #f59e0b;">
                <i class="bi bi-hourglass-split fs-1 text-warning"></i>
            </div>

            <!-- Page Title -->
            <h1 class="font-display fw-bold text-light mb-2 fs-2">Your Account Is Under Review</h1>
            <div class="badge bg-warning bg-opacity-25 text-warning px-3 py-2 rounded-pill font-mono fs-8 mb-4">
                <i class="bi bi-shield-check me-1"></i> EMAIL VERIFIED · AWAITING SUPER ADMIN APPROVAL
            </div>

            <!-- Main Message -->
            <div class="alert alert-dark border-secondary text-start mb-4 p-4" style="background: #1e293b; border-radius: 12px;">
                <p class="text-light mb-3 fs-6">
                    Thank you for registering with <strong>SIMS</strong>. Your email has been verified, and your shop registration is awaiting approval.
                </p>
                <ul class="text-secondary fs-7 mb-0 ps-3">
                    <li class="mb-2 text-light">You will receive an email confirmation as soon as your account is approved.</li>
                    <li class="mb-2 text-warning fw-semibold">Your free trial will begin only after Super Admin approval.</li>
                    <li class="text-muted">During review, access to store inventory, sales, and employee accounts remains restricted for security.</li>
                </ul>
            </div>

            @if (tenant != null)
            {
                <div class="p-3 mb-4 rounded text-start" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="row g-2 fs-7">
                        <div class="col-sm-6 text-muted">Shop Name:</div>
                        <div class="col-sm-6 text-light fw-bold">@tenant.ShopName</div>
                        <div class="col-sm-6 text-muted">Contact Person:</div>
                        <div class="col-sm-6 text-light">@tenant.OwnerName</div>
                        <div class="col-sm-6 text-muted">Registered Email:</div>
                        <div class="col-sm-6 text-light font-mono">@tenant.ContactEmail</div>
                        <div class="col-sm-6 text-muted">Shop Reference Code:</div>
                        <div class="col-sm-6 text-info font-mono">@tenant.TenantCode</div>
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
                <a href="@Url.Action("UnderReview", "Account")" class="btn btn-primary px-4 py-2 fw-semibold">
                    <i class="bi bi-arrow-repeat me-1"></i> Refresh Status
                </a>
                <a href="@Url.Action("Contact", "Landing")" class="btn btn-outline-info px-4 py-2">
                    <i class="bi bi-headset me-1"></i> Contact Support
                </a>
                <form method="post" action="@Url.Action("Logout", "Account")" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger px-4 py-2 w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>

            <div class="text-muted fs-8 mt-4">
                Need urgent review for your shop? Contact SaaS Support at <a href="mailto:support@sims.com" class="text-info text-decoration-none">support@sims.com</a>
            </div>
        </div>
    </div>
</div>
