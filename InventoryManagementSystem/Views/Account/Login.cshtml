@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In – SIMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background:#0F172A;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">

<div class="auth-card">
  <!-- Logo -->
  <div class="auth-logo">
    <div class="auth-logo-icon"><i class="bi bi-box-seam-fill"></i></div>
    <span class="auth-logo-name">SIMS</span>
  </div>

  <h1 class="auth-title">Welcome back</h1>
  <p class="auth-subtitle">Sign in to your inventory dashboard.</p>

  @{
    var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
  }
  @if (errors.Any())
  {
    <div class="alert-d alert-danger mb-4">
      <i class="bi bi-exclamation-circle-fill" style="margin-top:2px;flex-shrink:0"></i>
      <div>@errors.First().ErrorMessage</div>
    </div>
  }

  <form asp-action="Login" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <!-- Username -->
    <div class="fg">
      <label class="fg-label" asp-for="UsernameOrEmail">Username or Email</label>
      <div class="fg-icon-wrap">
        <i class="bi bi-person fg-icon"></i>
        <input asp-for="UsernameOrEmail" class="fg-control" placeholder="Enter username or email"
               autocomplete="username" required>
      </div>
      <span asp-validation-for="UsernameOrEmail" class="fg-error"></span>
    </div>

    <!-- Password -->
    <div class="fg">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <label class="fg-label mb-0" asp-for="Password">Password</label>
        <a href="@Url.Action("ForgotPassword","Account")"
           style="font-size:12px;color:var(--primary);text-decoration:none;font-weight:600">
          Forgot password?
        </a>
      </div>
      <div class="fg-icon-wrap" style="position:relative">
        <i class="bi bi-lock fg-icon"></i>
        <input asp-for="Password" id="pwd-in" class="fg-control"
               style="padding-left:38px;padding-right:44px"
               placeholder="Enter your password"
               autocomplete="current-password" required>
        <button type="button" id="pwd-eye" aria-label="Toggle password"
                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:16px;line-height:1;padding:0">
          <i class="bi bi-eye" id="pwd-eye-icon"></i>
        </button>
      </div>
      <span asp-validation-for="Password" class="fg-error"></span>
    </div>

    <!-- Remember me -->
    <div class="d-flex align-items-center gap-2 mb-5">
      <input asp-for="RememberMe" type="checkbox"
             style="width:16px;height:16px;cursor:pointer;accent-color:var(--primary);flex-shrink:0">
      <label asp-for="RememberMe" style="font-size:13px;color:var(--text-muted);cursor:pointer;margin:0">
        Keep me signed in for 20 minutes
      </label>
    </div>

    <button type="submit" class="btn-d btn-primary w-100" style="height:44px;font-size:14px">
      <i class="bi bi-arrow-right-circle"></i> Sign In
    </button>
  </form>

  <p style="font-size:12px;color:var(--text-disabled);text-align:center;margin-top:24px;margin-bottom:0">
    SIMS &copy; @DateTime.Now.Year · Smart Inventory System
  </p>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script>
  document.getElementById('pwd-eye').addEventListener('click',function(){
    var i=document.getElementById('pwd-in'),icon=document.getElementById('pwd-eye-icon');
    i.type=i.type==='password'?'text':'password';
    icon.className='bi '+(i.type==='password'?'bi-eye':'bi-eye-slash');
  });
</script>
</body>
</html>
