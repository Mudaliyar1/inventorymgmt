@model List<InventoryManagementSystem.Models.SaaSPaymentTransaction>
@{
    ViewData["Title"] = "SaaS Payment Transactions";
    var tenants = (Dictionary<string, string>)ViewBag.Tenants;
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <h1 class="h3 font-display fw-bold mb-0">Platform Payment History</h1>
        <p class="text-muted fs-7">Track subscription revenue and transaction records across all tenant shops.</p>
    </div>

    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted font-mono fs-7">
                        <th>Transaction Ref</th>
                        <th>Shop / Tenant</th>
                        <th>Amount</th>
                        <th>Gateway</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var tx in Model)
                        {
                            tenants.TryGetValue(tx.TenantId, out var shopName);
                            <tr>
                                <td class="font-mono text-info fw-bold">@tx.TransactionRef</td>
                                <td>@(string.IsNullOrEmpty(shopName) ? tx.TenantId : shopName)</td>
                                <td class="fw-bold text-success">₹@tx.Amount.ToString("N2")</td>
                                <td><span class="badge bg-secondary">@tx.GatewayProvider</span></td>
                                <td>
                                    <span class="badge @(tx.Status == "Success" ? "bg-success" : "bg-danger")">@tx.Status</span>
                                </td>
                                <td class="fs-7 text-muted">@tx.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No subscription payments recorded yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
