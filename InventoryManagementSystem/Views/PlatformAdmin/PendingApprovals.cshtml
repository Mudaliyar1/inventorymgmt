@model IEnumerable<InventoryManagementSystem.Models.Tenant>
@{
    ViewData["Title"] = "Trial Registration Approvals — SaaS Admin";
    Layout = "_Layout";
    var packageMap = (Dictionary<string, InventoryManagementSystem.Models.SubscriptionPackage>)ViewBag.PackageMap ?? new Dictionary<string, InventoryManagementSystem.Models.SubscriptionPackage>();
    var packages = (List<InventoryManagementSystem.Models.SubscriptionPackage>)ViewBag.Packages ?? new List<InventoryManagementSystem.Models.SubscriptionPackage>();
    var currentSearch = (string)ViewBag.CurrentSearch ?? string.Empty;
    var currentPackageId = (string)ViewBag.CurrentPackageId ?? "All";
    var totalPendingCount = (long)(ViewBag.TotalPendingCount ?? (Model?.Count() ?? 0));
}

<style>
    .appr-card {
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .appr-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.18);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
    }
    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.03em;
    }
    .table-dark-custom {
        --bs-table-bg: transparent;
        --bs-table-hover-bg: rgba(255, 255, 255, 0.03);
        border-color: rgba(255, 255, 255, 0.08);
    }
    .table-dark-custom th {
        background: rgba(15, 23, 42, 0.95) !important;
        color: #94a3b8 !important;
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 14px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .table-dark-custom td {
        padding: 14px 12px;
        color: #e2e8f0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        vertical-align: middle;
    }
    .filter-panel {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 14px;
    }
</style>

<div class="pz-page-wrap py-4">
    <div class="container-fluid px-lg-4">
        <!-- Breadcrumb & Header -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "PlatformAdmin")" class="text-info text-decoration-none"><i class="bi bi-speedometer2 me-1"></i>SaaS Admin</a></li>
                <li class="breadcrumb-item active text-secondary" aria-current="page">Trial Registration Approvals</li>
            </ol>
        </nav>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="stat-pill" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                        <i class="bi bi-clock-history"></i> Onboarding Verification
                    </span>
                    <span class="text-secondary small font-mono">IST (UTC+05:30)</span>
                </div>
                <h2 class="fw-bold mb-1 text-light">Pending Trial Registrations</h2>
                <p class="text-secondary small mb-0">Review new mobile shop trial applications. Approving starts their trial duration at the current moment in Indian Standard Time (IST).</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="@Url.Action("Tenants", "PlatformAdmin")" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 px-3 py-2">
                    <i class="bi bi-shop"></i> All Workspaces
                </a>
                <a href="@Url.Action("Revenue", "PlatformAdmin")" class="btn btn-outline-info btn-sm d-flex align-items-center gap-2 px-3 py-2">
                    <i class="bi bi-cash-stack"></i> Revenue Management
                </a>
            </div>
        </div>

        <!-- Metric Summary Strip -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="appr-card p-3 h-100" style="border-left: 4px solid #f59e0b !important;">
                    <div class="text-secondary small text-uppercase fw-semibold font-mono">Awaiting Approval</div>
                    <h3 class="fw-bold my-1 font-mono text-warning">@(Model?.Count() ?? 0)</h3>
                    <span class="text-secondary small">Free trial review queue</span>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="appr-card p-3 h-100" style="border-left: 4px solid #10b981 !important;">
                    <div class="text-secondary small text-uppercase fw-semibold font-mono">Approval Action</div>
                    <h3 class="fw-bold my-1 font-mono text-success">Instant IST</h3>
                    <span class="text-secondary small">Trial clock starts at approval</span>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="appr-card p-3 h-100" style="border-left: 4px solid #38bdf8 !important;">
                    <div class="text-secondary small text-uppercase fw-semibold font-mono">Notifications</div>
                    <h3 class="fw-bold my-1 font-mono" style="color: #38bdf8;">Automated</h3>
                    <span class="text-secondary small">Email sent on approve / reject</span>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="appr-card p-3 h-100" style="border-left: 4px solid #818cf8 !important;">
                    <div class="text-secondary small text-uppercase fw-semibold font-mono">Security Check</div>
                    <h3 class="fw-bold my-1 font-mono" style="color: #818cf8;">Verified OTP</h3>
                    <span class="text-secondary small">Email verified prior to review</span>
                </div>
            </div>
        </div>

        <!-- Filter & Search Bar -->
        <div class="filter-panel p-4 mb-4 shadow">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom border-secondary border-opacity-25 pb-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-funnel-fill text-warning"></i>
                    <h6 class="mb-0 fw-bold text-light">Filter Pending Applications</h6>
                </div>
                <span class="text-secondary small font-mono">Total Pending: <strong>@totalPendingCount</strong></span>
            </div>

            <form method="get" action="@Url.Action("PendingApprovals", "PlatformAdmin")" class="row g-3">
                <div class="col-lg-6 col-md-6">
                    <label class="form-label small text-secondary fw-semibold mb-1">
                        <i class="bi bi-search me-1 text-warning"></i>Search Applicant / Shop
                    </label>
                    <input type="text" name="search" class="form-control form-control-sm bg-dark border-secondary text-light py-2" placeholder="Search Shop Name, Owner, Email, Phone, Code..." value="@currentSearch" />
                </div>
                <div class="col-lg-3 col-md-3">
                    <label class="form-label small text-secondary fw-semibold mb-1">Requested Plan</label>
                    <select name="packageId" class="form-select form-select-sm bg-dark border-secondary text-light py-2">
                        <option value="All" selected="@(currentPackageId == "All")">All Subscription Plans</option>
                        @foreach (var pkg in packages)
                        {
                            <option value="@pkg.Id" selected="@(currentPackageId == pkg.Id)">@pkg.Name</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-warning btn-sm px-4 py-2 fw-semibold d-flex align-items-center gap-2 shadow flex-grow-1 justify-content-center text-dark">
                        <i class="bi bi-funnel-fill"></i> Filter
                    </button>
                    <a href="@Url.Action("PendingApprovals", "PlatformAdmin")" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </a>
                </div>
            </form>
        </div>

        <!-- Queue Table Card -->
        <div class="appr-card shadow-lg mb-5 overflow-hidden">
            <div class="p-3 px-4 border-bottom border-secondary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: rgba(15, 23, 42, 0.9);">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-inbox-fill text-warning fs-5"></i>
                    <h5 class="mb-0 fw-bold text-light">Applications Awaiting Review (@(Model?.Count() ?? 0))</h5>
                </div>
                <span class="text-secondary small font-mono">
                    <i class="bi bi-clock me-1 text-warning"></i>Indian Standard Time (IST / UTC+05:30)
                </span>
            </div>

            <div class="table-responsive">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-dark-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Shop &amp; Tenant Code</th>
                                <th>Owner &amp; Contacts</th>
                                <th>Selected Plan &amp; Trial</th>
                                <th>Registration Time (IST)</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                packageMap.TryGetValue(item.PackageId ?? "", out var pkg);
                                var appJson = System.Text.Json.JsonSerializer.Serialize(new {
                                    id = item.Id,
                                    code = item.TenantCode,
                                    shop = item.ShopName,
                                    owner = item.OwnerName,
                                    email = item.ContactEmail,
                                    phone = item.Phone ?? string.Empty,
                                    address = item.Address ?? string.Empty,
                                    gstin = item.GSTIN ?? string.Empty,
                                    pkg = pkg?.Name ?? "Standard Trial",
                                    trial = pkg?.HasTrial == true ? pkg.GetTrialDisplay() : "14 Days Trial",
                                    price = pkg?.MonthlyPrice ?? 0,
                                    createdIst = item.CreatedAt.ToPolicyIstDisplayString()
                                });

                                <tr>
                                    <!-- Shop & Code -->
                                    <td class="ps-4">
                                        <div class="fw-bold text-light fs-6">@item.ShopName</div>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <span class="badge font-mono" style="background: rgba(255, 255, 255, 0.08); color: #cbd5e1; border: 1px solid rgba(255, 255, 255, 0.15);">
                                                @item.TenantCode
                                            </span>
                                            @if (!string.IsNullOrEmpty(item.GSTIN))
                                            {
                                                <span class="badge font-mono" style="background: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3);">
                                                    GST: @item.GSTIN
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <!-- Owner & Contacts -->
                                    <td>
                                        <div class="fw-semibold text-light"><i class="bi bi-person-fill text-info me-1"></i>@item.OwnerName</div>
                                        <div class="text-secondary small font-mono"><i class="bi bi-envelope me-1"></i>@item.ContactEmail</div>
                                        @if (!string.IsNullOrEmpty(item.Phone))
                                        {
                                            <div class="text-secondary small font-mono"><i class="bi bi-telephone me-1"></i>@item.Phone</div>
                                        }
                                    </td>
                                    <!-- Plan & Trial -->
                                    <td>
                                        @if (pkg != null)
                                        {
                                            <span class="badge px-2 py-1 font-mono" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                                                @pkg.Name
                                            </span>
                                            <div class="text-success small fw-semibold mt-1">
                                                <i class="bi bi-gift-fill me-1"></i>@(pkg.HasTrial ? pkg.GetTrialDisplay() : "14 Days Free Trial")
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Standard Trial</span>
                                        }
                                    </td>
                                    <!-- Registered Time (IST) -->
                                    <td>
                                        <div class="small fw-semibold font-mono text-light">@item.CreatedAt.ToPolicyIstDisplayString()</div>
                                        <div class="text-secondary small fs-8">Awaiting Verification</div>
                                    </td>
                                    <!-- Actions -->
                                    <td class="text-end pe-4">
                                        <div class="d-flex align-items-center justify-content-end gap-1">
                                            <!-- View Details Modal Button -->
                                            <button type="button" class="btn btn-outline-info btn-sm px-2 py-1" onclick="openAppDetailsModal(@appJson)" title="View Application Details">
                                                <i class="bi bi-eye-fill me-1"></i> Details
                                            </button>
                                            <!-- Approve Modal Trigger -->
                                            <button type="button" class="btn btn-success btn-sm px-2 py-1 fw-semibold d-flex align-items-center gap-1 shadow" data-bs-toggle="modal" data-bs-target="#approveModal-@item.Id">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                            <!-- Reject Modal Trigger -->
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2 py-1 d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </div>

                                        <!-- Approve Modal -->
                                        <div class="modal fade text-start" id="approveModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content bg-dark text-light border border-secondary shadow-lg rounded-4 overflow-hidden">
                                                    <form method="post" action="@Url.Action("ApproveTrialRegistration", "PlatformAdmin")">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="tenantId" value="@item.Id" />
                                                        <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3" style="background: rgba(16, 185, 129, 0.2);">
                                                            <h5 class="modal-title fs-6 fw-bold text-success"><i class="bi bi-patch-check-fill me-2"></i>Approve Trial Registration</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body p-4" style="background: #0b1120;">
                                                            <p class="text-light">You are about to approve <strong>@item.ShopName</strong> (<span class="font-mono text-info">@item.TenantCode</span>).</p>
                                                            <div class="alert alert-info py-2 small mb-3 border-info" style="background: rgba(2, 132, 199, 0.15);">
                                                                <i class="bi bi-info-circle me-1"></i>
                                                                The free trial period will begin <strong>immediately at this exact moment in IST</strong>. The store owner will receive an automated activation email with their login confirmation and trial expiration schedule.
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold text-light">Approval Notes (Optional - included in welcome email)</label>
                                                                <textarea name="notes" class="form-control bg-dark border-secondary text-light" rows="2" placeholder="e.g. Approved. Welcome to SIMS SaaS!"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3" style="background: #131d31;">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success btn-sm fw-bold px-3">
                                                                <i class="bi bi-check2-circle me-1"></i> Confirm &amp; Launch Trial
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Reject Modal -->
                                        <div class="modal fade text-start" id="rejectModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content bg-dark text-light border border-secondary shadow-lg rounded-4 overflow-hidden">
                                                    <form method="post" action="@Url.Action("RejectTrialRegistration", "PlatformAdmin")">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="tenantId" value="@item.Id" />
                                                        <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3" style="background: rgba(239, 68, 68, 0.2);">
                                                            <h5 class="modal-title fs-6 fw-bold text-danger"><i class="bi bi-x-circle-fill me-2"></i>Reject Registration</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body p-4" style="background: #0b1120;">
                                                            <p class="text-light">Rejecting application for <strong>@item.ShopName</strong> (<span class="font-mono text-info">@item.TenantCode</span>).</p>
                                                            <div class="mb-3">
                                                                <label class="form-label small fw-semibold text-light">Reason for Rejection <span class="text-danger">*</span></label>
                                                                <textarea name="reason" class="form-control bg-dark border-secondary text-light" rows="3" required placeholder="Provide clear reason why the registration is rejected (will be emailed to applicant)"></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3" style="background: #131d31;">
                                                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger btn-sm fw-bold px-3">
                                                                <i class="bi bi-x-octagon me-1"></i> Confirm Rejection
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-check2-circle display-4 text-success mb-3 d-block opacity-75"></i>
                        <h4 class="fw-bold text-light">Queue is All Clear!</h4>
                        <p class="text-secondary small">No pending trial registrations require review at this moment.</p>
                        @if (!string.IsNullOrEmpty(currentSearch) || currentPackageId != "All")
                        {
                            <a href="@Url.Action("PendingApprovals", "PlatformAdmin")" class="btn btn-sm btn-outline-warning px-3">Reset Search Filters</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Dashboard", "PlatformAdmin")" class="btn btn-sm btn-outline-primary px-3">Return to Admin Dashboard</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ================= APPLICATION DETAILS MODAL ================= -->
<div class="modal fade" id="appDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-secondary shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3" style="background: #131d31;">
                <div class="d-flex align-items-center gap-2">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-25 text-warning" style="width:36px;height:36px;">
                        <i class="bi bi-file-earmark-person fs-5"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold text-light mb-0" id="appMdlShopName">Application Dossier</h5>
                        <span class="text-secondary font-mono fs-8" id="appMdlCode">Tenant Code</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" style="background: #0b1120;">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded bg-dark border border-secondary border-opacity-25">
                            <span class="text-secondary fs-8 d-block">Store Owner / Applicant</span>
                            <strong class="text-light fs-6" id="appMdlOwner">-</strong>
                            <div class="text-secondary font-mono fs-8 mt-1" id="appMdlEmail">-</div>
                            <div class="text-secondary font-mono fs-8" id="appMdlPhone">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded bg-dark border border-secondary border-opacity-25">
                            <span class="text-secondary fs-8 d-block">Requested Subscription Tier</span>
                            <strong class="text-warning fs-6 font-mono" id="appMdlPkg">-</strong>
                            <div class="text-success font-mono fs-8 mt-1" id="appMdlTrial">-</div>
                            <div class="text-secondary font-mono fs-8" id="appMdlPrice">-</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded bg-dark border border-secondary border-opacity-25">
                            <span class="text-secondary fs-8 d-block">Store Location &amp; Physical Address</span>
                            <span class="text-light fs-7" id="appMdlAddress">Not specified</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded bg-dark border border-secondary border-opacity-25">
                            <span class="text-secondary fs-8 d-block">GSTIN / Tax Identification</span>
                            <span class="text-info font-mono fw-bold fs-7" id="appMdlGSTIN">Not provided</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 rounded bg-dark border border-secondary border-opacity-25">
                            <span class="text-secondary fs-8 d-block">Application Submission Timestamp</span>
                            <span class="text-light font-mono fs-7" id="appMdlCreatedIst">-</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 px-4 py-3" style="background: #131d31;">
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAppDetailsModal(app) {
            if (!app) return;
            document.getElementById('appMdlShopName').innerText = app.shop || 'Shop Application';
            document.getElementById('appMdlCode').innerText = 'Tenant Code: ' + (app.code || 'Pending');
            document.getElementById('appMdlOwner').innerText = app.owner || 'Applicant';
            document.getElementById('appMdlEmail').innerText = 'Email: ' + (app.email || 'N/A');
            document.getElementById('appMdlPhone').innerText = 'Phone: ' + (app.phone || 'N/A');
            document.getElementById('appMdlPkg').innerText = app.pkg || 'Standard Trial';
            document.getElementById('appMdlTrial').innerText = 'Trial: ' + (app.trial || '14 Days');
            document.getElementById('appMdlPrice').innerText = 'Rate: ₹' + (app.price || '0') + '/mo';
            document.getElementById('appMdlAddress').innerText = app.address || 'No physical address provided';
            document.getElementById('appMdlGSTIN').innerText = app.gstin || 'None (Unregistered / Non-GST)';
            document.getElementById('appMdlCreatedIst').innerText = (app.createdIst || 'N/A') + ' (Indian Standard Time)';

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('appDetailsModal'));
            modal.show();
        }
    </script>
}
