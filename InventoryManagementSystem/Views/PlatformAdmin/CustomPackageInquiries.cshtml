@model List<InventoryManagementSystem.Models.CustomPackageInquiry>
@{
    ViewData["Title"] = "Custom Package Inquiries — Super Admin";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-primary px-3 py-2 text-uppercase font-mono fw-bold fs-7 rounded-pill mb-2">Super Admin Platform</span>
            <h1 class="h3 font-display fw-bold mb-1 text-light">Custom Package Calculator Inquiries</h1>
            <p class="text-muted fs-7 mb-0">Review bespoke configuration requests, calculate quotes, and follow up with prospective enterprise clients.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("CustomPricing", "PlatformAdmin")" class="btn btn-outline-warning">
                <i class="bi bi-sliders me-1"></i> Pricing Config
            </a>
            <a href="@Url.Action("Pricing", "Landing")#custom-package-calculator" target="_blank" class="btn btn-outline-light">
                <i class="bi bi-calculator me-1"></i> Public Calculator
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-3 h-100 border-start border-primary border-4">
                <div class="text-muted text-uppercase fs-8 font-mono fw-bold mb-1">Total Inquiries</div>
                <div class="fs-3 font-display fw-bold text-light">@ViewBag.TotalCount</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-3 h-100 border-start border-warning border-4">
                <div class="text-muted text-uppercase fs-8 font-mono fw-bold mb-1">New Inquiries</div>
                <div class="fs-3 font-display fw-bold text-warning">@ViewBag.NewCount</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-3 h-100 border-start border-info border-4">
                <div class="text-muted text-uppercase fs-8 font-mono fw-bold mb-1">In Review</div>
                <div class="fs-3 font-display fw-bold text-info">@ViewBag.InReviewCount</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-3 h-100 border-start border-primary border-4">
                <div class="text-muted text-uppercase fs-8 font-mono fw-bold mb-1">Quote Sent</div>
                <div class="fs-3 font-display fw-bold text-primary">@ViewBag.QuoteSentCount</div>
            </div>
        </div>
        <div class="col-xl col-md-4 col-sm-6">
            <div class="glass-card p-3 h-100 border-start border-success border-4">
                <div class="text-muted text-uppercase fs-8 font-mono fw-bold mb-1">Converted</div>
                <div class="fs-3 font-display fw-bold text-success">@ViewBag.ConvertedCount</div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="glass-card p-3 mb-4">
        <form method="get" action="@Url.Action("CustomPackageInquiries", "PlatformAdmin")" class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-dark text-muted border-secondary border-opacity-50"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control bg-dark text-light border-secondary border-opacity-50" placeholder="Search customer, business, email, phone, reference..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <select name="status" class="form-select form-select-sm bg-dark text-light border-secondary border-opacity-50">
                    <option value="All" selected="@(currentStatus == "All")">All Statuses</option>
                    <option value="New" selected="@(currentStatus == "New")">New</option>
                    <option value="In Review" selected="@(currentStatus == "In Review")">In Review</option>
                    <option value="Contacted" selected="@(currentStatus == "Contacted")">Contacted</option>
                    <option value="Quote Sent" selected="@(currentStatus == "Quote Sent")">Quote Sent</option>
                    <option value="Converted" selected="@(currentStatus == "Converted")">Converted</option>
                    <option value="Closed" selected="@(currentStatus == "Closed")">Closed</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <input type="date" name="fromDate" class="form-control form-control-sm bg-dark text-light border-secondary border-opacity-50" value="@fromDate" placeholder="From Date" title="From Date" />
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <input type="date" name="toDate" class="form-control form-control-sm bg-dark text-light border-secondary border-opacity-50" value="@toDate" placeholder="To Date" title="To Date" />
            </div>
            <div class="col-lg-2 col-md-3 col-6 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">Filter</button>
                <a href="@Url.Action("CustomPackageInquiries", "PlatformAdmin")" class="btn btn-sm btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>

    <!-- Bulk Actions Toolbar -->
    <div id="bulkActionBar" class="d-none alert alert-dark border border-danger border-opacity-50 py-2 px-3 mb-3 d-flex justify-content-between align-items-center rounded-3 bg-opacity-75">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger rounded-pill px-2 py-1 font-mono fs-8" id="selectedBadge">0</span>
            <span class="text-light fs-8 fw-semibold">Custom Inquiries Selected for Deletion</span>
            <span class="text-muted fs-9 d-none d-md-inline">(Only closed or completed inquiries can be deleted)</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary py-1" onclick="clearSelection()">Clear</button>
            <button type="button" class="btn btn-sm btn-danger fw-bold py-1" onclick="openBulkDeleteModal()">
                <i class="bi bi-trash me-1"></i> Delete Selected
            </button>
        </div>
    </div>

    <!-- Inquiries Table -->
    <div class="glass-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle fs-8">
                <thead class="bg-black bg-opacity-25 text-muted text-uppercase font-mono">
                    <tr>
                        <th class="ps-3" style="width: 38px;">
                            <input type="checkbox" id="selectAllCheckbox" class="form-check-input" title="Select all deletable inquiries" onchange="toggleSelectAll(this)" />
                        </th>
                        <th>Reference</th>
                        <th>Business / Contact</th>
                        <th>Quantities Requested</th>
                        <th>Modules</th>
                        <th>Est. Price</th>
                        <th>Status</th>
                        <th>Confirmation Email</th>
                        <th>Date</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var inq in Model)
                        {
                            var badgeClass = inq.Status switch
                            {
                                "New" => "bg-warning text-dark",
                                "In Review" => "bg-info text-dark",
                                "Contacted" => "bg-primary text-light",
                                "Quote Sent" => "bg-purple text-light",
                                "Converted" => "bg-success text-light",
                                "Closed" => "bg-secondary text-light",
                                _ => "bg-secondary text-light"
                            };

                            var emailBadgeClass = inq.ConfirmationEmailStatus switch
                            {
                                "Sent" => "bg-success bg-opacity-25 text-success border border-success border-opacity-50",
                                "Failed" => "bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50",
                                _ => "bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50"
                            };

                            var isDeletable = inq.Status == "Closed" || inq.Status == "Converted" || inq.Status == "Completed";

                            <tr>
                                <td class="ps-3">
                                    @if (isDeletable)
                                    {
                                        <input type="checkbox" class="form-check-input inquiry-cb cursor-pointer" value="@inq.Id" data-ref="@inq.InquiryNumber" data-name="@inq.ContactName" onchange="onCheckboxChange()" />
                                    }
                                    else
                                    {
                                        <input type="checkbox" class="form-check-input" disabled title="Pending inquiry cannot be deleted (Only Closed or Converted)" style="opacity: 0.3; cursor: not-allowed;" />
                                    }
                                </td>
                                <td class="font-mono fw-bold text-info">
                                    @inq.InquiryNumber
                                </td>
                                <td>
                                    <div class="fw-bold text-light">@inq.BusinessName</div>
                                    <div class="text-muted fs-9">@inq.ContactName • <a href="mailto:@inq.Email" class="text-muted text-decoration-none">@inq.Email</a></div>
                                    @if (!string.IsNullOrWhiteSpace(inq.Phone))
                                    {
                                        <div class="text-muted fs-9"><i class="bi bi-telephone me-1"></i>@inq.Phone</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary border-opacity-50 text-light me-1" title="Admins"><i class="bi bi-person-badge me-1"></i>@inq.AdminCount Admins</span>
                                    <span class="badge bg-dark border border-secondary border-opacity-50 text-light me-1" title="Employees"><i class="bi bi-people me-1"></i>@inq.EmployeeCount Staff</span>
                                    <span class="badge bg-dark border border-secondary border-opacity-50 text-light me-1" title="Products"><i class="bi bi-box me-1"></i>@inq.ProductCount.ToString("N0") Prods</span>
                                    <span class="badge bg-dark border border-secondary border-opacity-50 text-light me-1" title="Suppliers"><i class="bi bi-truck me-1"></i>@inq.SupplierCount Sups</span>
                                    @if (inq.DeviceCount > 0)
                                    {
                                        <span class="badge bg-dark border border-secondary border-opacity-50 text-light" title="Tracked Devices"><i class="bi bi-phone me-1"></i>@inq.DeviceCount.ToString("N0") Devices</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-50">@(inq.SelectedFeatureKeys?.Count ?? 0) Modules</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-success font-mono">₹@inq.EstimatedMonthlyPrice.ToString("N0") <span class="fs-9 text-muted font-sans">/mo</span></div>
                                    <div class="text-muted fs-9 font-mono">₹@inq.EstimatedYearlyPrice.ToString("N0") /yr</div>
                                </td>
                                <td>
                                    <span class="badge @badgeClass font-mono">@inq.Status</span>
                                </td>
                                <td>
                                    <span class="badge @emailBadgeClass font-mono" title="@inq.ConfirmationEmailError">
                                        @if (inq.ConfirmationEmailStatus == "Sent")
                                        {
                                            <i class="bi bi-envelope-check me-1"></i><span>Sent</span>
                                        }
                                        else if (inq.ConfirmationEmailStatus == "Failed")
                                        {
                                            <i class="bi bi-envelope-exclamation me-1"></i><span>Failed</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-clock me-1"></i><span>Pending</span>
                                        }
                                    </span>
                                </td>
                                <td class="text-muted fs-9 font-mono">
                                    @inq.CreatedAt.ToIst().ToString("dd MMM yyyy")
                                    <div class="text-muted fs-9">@inq.CreatedAt.ToIst().ToString("hh:mm tt IST")</div>
                                </td>
                                <td class="pe-4 text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-info" onclick="viewInquiryDetails('@inq.Id')">
                                        <i class="bi bi-eye me-1"></i> Review
                                    </button>
                                    @if (isDeletable)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-1" onclick="openSingleDeleteModal('@inq.Id', '@inq.InquiryNumber', '@inq.ContactName')" title="Delete inquiry permanently">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled title="Pending inquiry cannot be deleted (Only Closed / Converted)" style="opacity:0.3; cursor:not-allowed;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No custom package inquiries found matching your filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Review & Details Modal -->
<div class="modal fade" id="inquiryDetailsModal" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary py-3 px-4">
                <div>
                    <span class="badge bg-info-subtle text-info border border-info-subtle font-mono mb-1" id="mRef">INQ-CP-XXXX</span>
                    <h5 class="modal-title font-display fw-bold text-light" id="mBusinessName">Business Name</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                
                <!-- Contact & Specs Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-dark-subtle rounded-3 border border-secondary border-opacity-25 h-100">
                            <h6 class="text-uppercase fs-8 text-muted fw-bold mb-2">Contact Details</h6>
                            <div class="mb-1"><strong>Name:</strong> <span id="mContactName"></span></div>
                            <div class="mb-1"><strong>Email:</strong> <a href="#" id="mEmail" class="text-info text-decoration-none"></a></div>
                            <div class="mb-1"><strong>Phone:</strong> <span id="mPhone" class="text-muted"></span></div>
                            <div><strong>Submitted:</strong> <span id="mCreatedAt" class="text-muted font-mono fs-8"></span></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-dark-subtle rounded-3 border border-secondary border-opacity-25 h-100">
                            <h6 class="text-uppercase fs-8 text-muted fw-bold mb-2">Baseline System Estimate</h6>
                            <div class="fs-4 font-display fw-bold text-success" id="mMonthly">₹0 / mo</div>
                            <div class="fs-7 font-display text-info mb-2" id="mYearly">₹0 / yr</div>
                            <div class="text-muted fs-9">Calculated from Super Admin baseline pricing rules at time of quote generation.</div>
                        </div>
                    </div>
                </div>

                <!-- Customer Confirmation Email Status & Resend -->
                <div class="p-3 bg-dark-subtle rounded-3 border border-secondary border-opacity-25 mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h6 class="text-uppercase fs-8 text-muted fw-bold mb-1">Customer Confirmation Email</h6>
                            <div id="mEmailStatusBadge" class="d-inline-block"></div>
                            <div id="mEmailSentAt" class="fs-9 text-muted mt-1"></div>
                            <div id="mEmailError" class="fs-9 text-danger mt-1 d-none"></div>
                        </div>
                        <form method="post" action="@Url.Action("RetryCustomQuoteConfirmationEmail", "PlatformAdmin")" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" id="mEmailRetryId" value="" />
                            <button type="submit" class="btn btn-sm btn-outline-warning" id="mEmailRetryBtn">
                                <i class="bi bi-arrow-repeat me-1"></i> Resend Confirmation Email
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Quantities Table -->
                <div class="mb-4">
                    <h6 class="text-uppercase fs-8 text-muted fw-bold mb-2">Requested Resource Capacities</h6>
                    <div class="row g-2 text-center fs-8">
                        <div class="col">
                            <div class="p-2 bg-dark rounded border border-secondary border-opacity-25">
                                <div class="text-muted fs-9">Admins</div>
                                <div class="fw-bold fs-6 text-light" id="mAdmins">0</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 bg-dark rounded border border-secondary border-opacity-25">
                                <div class="text-muted fs-9">Employees</div>
                                <div class="fw-bold fs-6 text-light" id="mEmployees">0</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 bg-dark rounded border border-secondary border-opacity-25">
                                <div class="text-muted fs-9">Products</div>
                                <div class="fw-bold fs-6 text-light" id="mProducts">0</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 bg-dark rounded border border-secondary border-opacity-25">
                                <div class="text-muted fs-9">Suppliers</div>
                                <div class="fw-bold fs-6 text-light" id="mSuppliers">0</div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="p-2 bg-dark rounded border border-secondary border-opacity-25">
                                <div class="text-muted fs-9">Devices</div>
                                <div class="fw-bold fs-6 text-light" id="mDevices">0</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Selected Features Badges -->
                <div class="mb-4">
                    <h6 class="text-uppercase fs-8 text-muted fw-bold mb-2">Selected Modular Capabilities</h6>
                    <div id="mFeaturesList" class="d-flex flex-wrap gap-1">
                        <!-- Injected via JS -->
                    </div>
                </div>

                <!-- Message -->
                <div class="mb-4" id="mMessageWrap">
                    <h6 class="text-uppercase fs-8 text-muted fw-bold mb-1">Customer Message / Special Requirements</h6>
                    <div class="p-3 bg-dark rounded border border-secondary border-opacity-25 fs-8 text-light" id="mMessage" style="white-space: pre-wrap;">
                    </div>
                </div>

                <!-- Follow Up History & Notes -->
                <div class="mb-4">
                    <h6 class="text-uppercase fs-8 text-muted fw-bold mb-2">Follow-up History &amp; Admin Notes</h6>
                    <div id="mHistoryList" class="mb-3 fs-8" style="max-height: 160px; overflow-y: auto;">
                        <!-- Injected via JS -->
                    </div>
                </div>

                <!-- Status Update Form -->
                <form method="post" action="@Url.Action("UpdateCustomPackageInquiryStatus", "PlatformAdmin")" class="p-3 bg-dark-subtle rounded-3 border border-secondary border-opacity-50">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="mFormId" value="" />
                    <h6 class="text-uppercase fs-8 text-warning fw-bold mb-2"><i class="bi bi-pencil-square me-1"></i>Update Inquiry Status &amp; Add Note</h6>
                    
                    <div class="row g-2 mb-2">
                        <div class="col-md-5">
                            <label class="form-label text-muted fs-9 mb-1">Inquiry Status</label>
                            <select name="status" id="mFormStatus" class="form-select form-select-sm bg-dark text-light border-secondary">
                                <option value="New">New</option>
                                <option value="In Review">In Review</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Quote Sent">Quote Sent</option>
                                <option value="Converted">Converted</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label text-muted fs-9 mb-1">Converted Shop Tenant ID (Optional)</label>
                            <input type="text" name="convertedTenantId" id="mFormTenantId" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="e.g. 64b8f..." />
                        </div>
                    </div>
                    
                    <div class="mb-2">
                        <label class="form-label text-muted fs-9 mb-1">Reply / Follow-up Note</label>
                        <textarea name="note" id="mFormNote" class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" placeholder="Enter message to client or internal note..."></textarea>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="sendEmailToCustomer" id="mSendEmailToCustomer" value="true" checked />
                        <label class="form-check-label text-light fs-8" for="mSendEmailToCustomer">
                            <i class="bi bi-envelope-check me-1 text-info"></i> Send this response as an email to customer (<span id="mReplyTargetEmail" class="text-info fw-bold font-mono"></span>)
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-sm btn-primary fw-bold px-3">
                            <i class="bi bi-send me-1"></i> Save &amp; Send Reply
                        </button>
                    </div>
                </form>

            </div>
            <div class="modal-footer border-secondary py-2 px-4 justify-content-between">
                <div>
                    <button type="button" id="mDeleteBtn" class="btn btn-sm btn-outline-danger d-none" onclick="openSingleDeleteFromModal()">
                        <i class="bi bi-trash me-1"></i> Delete Inquiry
                    </button>
                    <span id="mDeleteDisabledNotice" class="text-muted fs-9"><i class="bi bi-shield-lock me-1"></i>Pending inquiries cannot be deleted (Only Closed / Converted)</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Single Delete Confirmation Modal -->
<div class="modal fade" id="deleteSingleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger text-light">
            <div class="modal-header border-secondary border-opacity-50">
                <h5 class="modal-title text-danger fs-6 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Inquiry Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="@Url.Action("DeleteCustomPackageInquiry", "PlatformAdmin")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteSingleId" value="" />
                <div class="modal-body fs-8 py-3">
                    <p class="mb-2">Are you sure you want to permanently delete custom quote inquiry <strong class="text-warning font-mono" id="deleteSingleRef"></strong> for <strong id="deleteSingleName" class="text-light"></strong>?</p>
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 py-2 px-3 fs-9 mb-0">
                        <i class="bi bi-shield-exclamation me-1"></i> This record will be permanently purged from the database. This action cannot be undone.
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-50 py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger fw-bold"><i class="bi bi-trash me-1"></i> Permanently Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk Delete Confirmation Modal -->
<div class="modal fade" id="deleteBulkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger text-light">
            <div class="modal-header border-secondary border-opacity-50">
                <h5 class="modal-title text-danger fs-6 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Bulk Inquiry Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="@Url.Action("BulkDeleteCustomPackageInquiries", "PlatformAdmin")" id="bulkDeleteForm">
                @Html.AntiForgeryToken()
                <div id="bulkDeleteHiddenInputs"></div>
                <div class="modal-body fs-8 py-3">
                    <p class="mb-2">You are about to permanently delete <strong class="text-danger fs-6 font-mono" id="bulkDeleteCountText">0</strong> closed / completed inquiry record(s).</p>
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 py-2 px-3 fs-9 mb-0">
                        <i class="bi bi-shield-lock me-1"></i> Active and pending inquiries have been protected and excluded. Selected records will be permanently removed.
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-50 py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger fw-bold"><i class="bi bi-trash me-1"></i> Delete All Selected</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
var activeModalInquiry = null;

function viewInquiryDetails(id) {
    fetch('@Url.Action("CustomPackageInquiryDetails", "PlatformAdmin")?id=' + id)
    .then(function(res) { return res.json(); })
    .then(function(data) {
        activeModalInquiry = data;
        document.getElementById('mFormId').value = data.id;
        document.getElementById('mRef').textContent = data.inquiryNumber;
        document.getElementById('mBusinessName').textContent = data.businessName;
        document.getElementById('mContactName').textContent = data.contactName;
        document.getElementById('mEmail').textContent = data.email;
        document.getElementById('mEmail').href = 'mailto:' + data.email;
        document.getElementById('mPhone').textContent = data.phone || 'N/A';
        document.getElementById('mCreatedAt').textContent = data.createdAt;

        document.getElementById('mMonthly').textContent = '₹' + Math.round(data.monthlyPrice).toLocaleString('en-IN') + ' / mo';
        document.getElementById('mYearly').textContent = '₹' + Math.round(data.yearlyPrice).toLocaleString('en-IN') + ' / yr';

        document.getElementById('mAdmins').textContent = data.adminCount;
        document.getElementById('mEmployees').textContent = data.employeeCount;
        document.getElementById('mProducts').textContent = Number(data.productCount).toLocaleString('en-IN');
        document.getElementById('mSuppliers').textContent = data.supplierCount;
        document.getElementById('mDevices').textContent = Number(data.deviceCount).toLocaleString('en-IN');

        document.getElementById('mFormStatus').value = data.status;
        var replyEmailEl = document.getElementById('mReplyTargetEmail');
        if (replyEmailEl) replyEmailEl.textContent = data.email;
        var formNoteEl = document.getElementById('mFormNote');
        if (formNoteEl) formNoteEl.value = '';

        // Configure delete button visibility inside modal
        var isDeletable = (data.status === 'Closed' || data.status === 'Converted' || data.status === 'Completed');
        var delBtn = document.getElementById('mDeleteBtn');
        var delNotice = document.getElementById('mDeleteDisabledNotice');
        if (isDeletable) {
            delBtn.classList.remove('d-none');
            delNotice.classList.add('d-none');
        } else {
            delBtn.classList.add('d-none');
            delNotice.classList.remove('d-none');
        }

        // Populate Confirmation Email info & retry form
        document.getElementById('mEmailRetryId').value = data.id;
        var emailBadge = document.getElementById('mEmailStatusBadge');
        var emailSentAt = document.getElementById('mEmailSentAt');
        var emailErr = document.getElementById('mEmailError');

        if (data.confirmationEmailStatus === 'Sent') {
            emailBadge.innerHTML = '<span class="badge bg-success text-light"><i class="bi bi-check-circle me-1"></i>Sent to Customer</span>';
            emailSentAt.textContent = data.confirmationEmailSentAt ? 'Sent at: ' + data.confirmationEmailSentAt : '';
            emailErr.classList.add('d-none');
        } else if (data.confirmationEmailStatus === 'Failed') {
            emailBadge.innerHTML = '<span class="badge bg-danger text-light"><i class="bi bi-exclamation-triangle me-1"></i>Delivery Failed</span>';
            emailSentAt.textContent = '';
            emailErr.textContent = 'Error: ' + (data.confirmationEmailError || 'Failed to dispatch via email provider.');
            emailErr.classList.remove('d-none');
        } else {
            emailBadge.innerHTML = '<span class="badge bg-secondary text-light"><i class="bi bi-clock me-1"></i>Pending</span>';
            emailSentAt.textContent = '';
            emailErr.classList.add('d-none');
        }

        // Render features
        var featWrap = document.getElementById('mFeaturesList');
        featWrap.innerHTML = '';
        if (data.selectedFeatures && data.selectedFeatures.length > 0) {
            data.selectedFeatures.forEach(function(f) {
                var span = document.createElement('span');
                span.className = 'badge bg-secondary bg-opacity-50 text-light me-1 mb-1 font-sans';
                span.textContent = f;
                featWrap.appendChild(span);
            });
        } else {
            featWrap.innerHTML = '<span class="text-muted fs-8">Standard core capabilities included</span>';
        }

        // Render message
        var msgWrap = document.getElementById('mMessageWrap');
        if (data.message && data.message.trim().length > 0) {
            document.getElementById('mMessage').textContent = data.message;
            msgWrap.classList.remove('d-none');
        } else {
            msgWrap.classList.add('d-none');
        }

        // Render history
        var histWrap = document.getElementById('mHistoryList');
        histWrap.innerHTML = '';
        if (data.history && data.history.length > 0) {
            data.history.forEach(function(h) {
                var d = document.createElement('div');
                d.className = 'p-2 mb-1 bg-dark rounded border border-secondary border-opacity-25';
                d.innerHTML = '<div class="d-flex justify-content-between text-muted fs-9 font-mono"><span>' + (h.createdBy || 'Admin') + '</span><span>' + (h.timestamp || '') + '</span></div><div class="text-light mt-1">' + (h.note || '') + '</div>';
                histWrap.appendChild(d);
            });
        } else {
            histWrap.innerHTML = '<span class="text-muted fs-9">No previous notes.</span>';
        }

        var modal = new bootstrap.Modal(document.getElementById('inquiryDetailsModal'));
        modal.show();
    })
    .catch(function(err) {
        alert('Failed to load inquiry details: ' + err);
    });
}

function openSingleDeleteModal(id, ref, name) {
    document.getElementById('deleteSingleId').value = id;
    document.getElementById('deleteSingleRef').textContent = ref;
    document.getElementById('deleteSingleName').textContent = name;
    new bootstrap.Modal(document.getElementById('deleteSingleModal')).show();
}

function openSingleDeleteFromModal() {
    if (!activeModalInquiry) return;
    var detailsModalEl = document.getElementById('inquiryDetailsModal');
    var detailsModal = bootstrap.Modal.getInstance(detailsModalEl);
    if (detailsModal) detailsModal.hide();

    openSingleDeleteModal(activeModalInquiry.id, activeModalInquiry.inquiryNumber, activeModalInquiry.contactName);
}

function onCheckboxChange() {
    var cbs = document.querySelectorAll('.inquiry-cb:checked');
    var bar = document.getElementById('bulkActionBar');
    var badge = document.getElementById('selectedBadge');
    var count = cbs.length;

    badge.textContent = count;
    if (count > 0) {
        bar.classList.remove('d-none');
    } else {
        bar.classList.add('d-none');
    }

    // Update selectAllCheckbox status
    var allCbs = document.querySelectorAll('.inquiry-cb');
    var selectAll = document.getElementById('selectAllCheckbox');
    if (selectAll) {
        selectAll.checked = (allCbs.length > 0 && cbs.length === allCbs.length);
    }
}

function toggleSelectAll(masterCb) {
    var allCbs = document.querySelectorAll('.inquiry-cb');
    allCbs.forEach(function(cb) {
        cb.checked = masterCb.checked;
    });
    onCheckboxChange();
}

function clearSelection() {
    var allCbs = document.querySelectorAll('.inquiry-cb');
    allCbs.forEach(function(cb) {
        cb.checked = false;
    });
    var selectAll = document.getElementById('selectAllCheckbox');
    if (selectAll) selectAll.checked = false;
    onCheckboxChange();
}

function openBulkDeleteModal() {
    var cbs = document.querySelectorAll('.inquiry-cb:checked');
    if (cbs.length === 0) return;

    var container = document.getElementById('bulkDeleteHiddenInputs');
    container.innerHTML = '';
    cbs.forEach(function(cb) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'selectedIds';
        input.value = cb.value;
        container.appendChild(input);
    });

    document.getElementById('bulkDeleteCountText').textContent = cbs.length;
    new bootstrap.Modal(document.getElementById('deleteBulkModal')).show();
}
</script>
}
