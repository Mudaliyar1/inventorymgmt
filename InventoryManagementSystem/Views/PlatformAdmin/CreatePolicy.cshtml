@model InventoryManagementSystem.Models.PolicyDocument
@{
    ViewData["Title"] = "Create Policy — Super Admin";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 fs-8 text-uppercase font-mono">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "PlatformAdmin")" class="text-decoration-none text-muted">Super Admin</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Policies", "PlatformAdmin")" class="text-decoration-none text-muted">Policies</a></li>
                    <li class="breadcrumb-item active text-primary" aria-current="page">Create New</li>
                </ol>
            </nav>
            <h1 class="h3 font-display fw-bold mb-1 text-light">Create Policy Document</h1>
            <p class="text-muted fs-7 mb-0">Write policy documents with the README-style markdown editor with live preview and IST audit tracking.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Policies", "PlatformAdmin")" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Policies
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Please correct the errors below before proceeding.
            <div asp-validation-summary="All" class="text-danger fs-8 mt-2"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post" action="@Url.Action("CreatePolicy", "PlatformAdmin")" id="policyForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left / Top: Metadata Configuration -->
            <div class="col-lg-4">
                <div class="glass-card p-4 mb-4">
                    <h5 class="font-display fw-bold text-light mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <i class="bi bi-sliders text-primary me-2"></i>Document Settings
                    </h5>

                    <!-- Starter Template Picker -->
                    <div class="mb-3">
                        <label class="form-label fs-8 text-uppercase font-mono text-muted">Starter Template</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary border-opacity-50" id="templatePicker" onchange="loadStarterTemplate(this.value)">
                            <option value="">-- Select Starter Template --</option>
                            <option value="privacy">Privacy Policy (India DPDP Act 2023)</option>
                            <option value="terms">Terms &amp; Conditions (SaaS Software Only)</option>
                            <option value="refund">Refund &amp; Cancellation Policy</option>
                            <option value="subscription">Subscription &amp; Billing Policy</option>
                            <option value="cookie">Cookie Policy (Essential Only)</option>
                            <option value="copyright">Copyright &amp; IP Complaint Policy (India)</option>
                            <option value="acceptable-use">Acceptable Use Policy</option>
                            <option value="blank">Blank Document</option>
                        </select>
                        <div class="fs-9 text-muted mt-1">Pre-populates professional SaaS structure without draft disclaimers.</div>
                    </div>

                    <!-- Policy Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fs-8 text-uppercase font-mono text-muted">Policy Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-sm bg-dark text-light border-secondary border-opacity-50" id="policyTitle" placeholder="e.g. Terms and Conditions" required oninput="autoGenerateSlug(this.value)" />
                        <span asp-validation-for="Title" class="text-danger fs-8"></span>
                    </div>

                    <!-- Slug -->
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label fs-8 text-uppercase font-mono text-muted">URL Slug <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-dark text-muted border-secondary border-opacity-50 font-mono">/policy/</span>
                            <input asp-for="Slug" class="form-control bg-dark text-light border-secondary border-opacity-50 font-mono" id="policySlug" placeholder="terms-and-conditions" required />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger fs-8"></span>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label fs-8 text-uppercase font-mono text-muted">Category</label>
                        <select asp-for="Category" class="form-select form-select-sm bg-dark text-light border-secondary border-opacity-50">
                            <option value="Terms and Conditions">Terms and Conditions</option>
                            <option value="Privacy">Privacy</option>
                            <option value="Refund and Cancellation">Refund and Cancellation</option>
                            <option value="Subscription and Billing">Subscription and Billing</option>
                            <option value="Cookies">Cookies</option>
                            <option value="Copyright and Intellectual Property">Copyright and Intellectual Property</option>
                            <option value="Acceptable Use">Acceptable Use</option>
                            <option value="General Website Policy">General Website Policy</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- Summary -->
                    <div class="mb-3">
                        <label asp-for="Summary" class="form-label fs-8 text-uppercase font-mono text-muted">Short Summary / Meta Description</label>
                        <textarea asp-for="Summary" rows="2" class="form-control form-control-sm bg-dark text-light border-secondary border-opacity-50" placeholder="Brief summary displayed in public eyebrow and metadata..."></textarea>
                    </div>

                    <!-- Effective Date -->
                    <div class="mb-3">
                        <label asp-for="EffectiveDate" class="form-label fs-8 text-uppercase font-mono text-muted">Effective Date</label>
                        <input asp-for="EffectiveDate" type="date" class="form-control form-control-sm bg-dark text-light border-secondary border-opacity-50" />
                    </div>

                    <!-- Display Order -->
                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label fs-8 text-uppercase font-mono text-muted">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control form-control-sm bg-dark text-light border-secondary border-opacity-50" value="1" />
                    </div>

                    <div class="border-top border-secondary border-opacity-25 pt-3">
                        <!-- Checkboxes -->
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="isPublishedSwitch" checked />
                            <label class="form-check-label text-light fs-8" for="isPublishedSwitch">
                                <strong>Published</strong> (Live on website)
                            </label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                            <label class="form-check-label text-light fs-8" for="isActiveSwitch">
                                <strong>Active</strong> (Accessible at URL)
                            </label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input asp-for="ShowInFooter" class="form-check-input" type="checkbox" id="showInFooterSwitch" checked />
                            <label class="form-check-label text-light fs-8" for="showInFooterSwitch">
                                <strong>Show in Footer</strong> links
                            </label>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-cloud-arrow-up me-1"></i> Save and Publish Policy
                        </button>
                        <button type="button" class="btn btn-outline-warning btn-sm" onclick="saveAsDraft()">
                            <i class="bi bi-file-earmark-lock me-1"></i> Save as Draft
                        </button>
                    </div>
                </div>

                <!-- Guidance Card -->
                <div class="glass-card p-3 border-start border-info border-4">
                    <div class="fs-8 fw-bold text-info text-uppercase font-mono mb-1"><i class="bi bi-shield-check me-1"></i> Compliance Guidance</div>
                    <ul class="fs-8 text-muted ps-3 mb-0">
                        <li>Do not disclose internal architecture or technology stacks.</li>
                        <li>Maintain software-only SaaS positioning (no hardware liability).</li>
                        <li>All update audit dates are recorded in Indian Standard Time (IST).</li>
                        <li>No draft disclaimers should appear in public view.</li>
                    </ul>
                </div>
            </div>

            <!-- Right: README-style Markdown Editor & Live Preview -->
            <div class="col-lg-8">
                <div class="glass-card overflow-hidden d-flex flex-column" style="min-height: 750px;">
                    <!-- Editor Header Toolbar -->
                    <div class="p-2 border-bottom border-secondary border-opacity-25 bg-dark d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <!-- Formatting Controls (README Style) -->
                        <div class="btn-toolbar" role="toolbar">
                            <div class="btn-group btn-group-sm me-2" role="group">
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('# ', '')" title="Heading 1"><i class="bi bi-type-h1"></i></button>
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('## ', '')" title="Heading 2"><i class="bi bi-type-h2"></i></button>
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('### ', '')" title="Heading 3"><i class="bi bi-type-h3"></i></button>
                            </div>
                            <div class="btn-group btn-group-sm me-2" role="group">
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('**', '**')" title="Bold"><i class="bi bi-type-bold"></i></button>
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('*', '*')" title="Italic"><i class="bi bi-type-italic"></i></button>
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('> ', '')" title="Blockquote"><i class="bi bi-quote"></i></button>
                            </div>
                            <div class="btn-group btn-group-sm me-2" role="group">
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('- ', '')" title="Bullet List"><i class="bi bi-list-ul"></i></button>
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('1. ', '')" title="Numbered List"><i class="bi bi-list-ol"></i></button>
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('[Link Text](', 'https://)')" title="Insert Link"><i class="bi bi-link-45deg"></i></button>
                                <button type="button" class="btn btn-outline-secondary text-light" onclick="insertMarkdown('\n---\n', '')" title="Horizontal Divider"><i class="bi bi-hr"></i></button>
                            </div>
                        </div>

                        <!-- Mode Switcher -->
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="editorViewMode" id="modeSplit" autocomplete="off" checked onchange="switchView('split')">
                            <label class="btn btn-outline-info" for="modeSplit"><i class="bi bi-layout-split me-1"></i> Split View</label>

                            <input type="radio" class="btn-check" name="editorViewMode" id="modeWrite" autocomplete="off" onchange="switchView('write')">
                            <label class="btn btn-outline-info" for="modeWrite"><i class="bi bi-pencil me-1"></i> Editor Only</label>

                            <input type="radio" class="btn-check" name="editorViewMode" id="modePreview" autocomplete="off" onchange="switchView('preview')">
                            <label class="btn btn-outline-info" for="modePreview"><i class="bi bi-eye me-1"></i> Live Preview</label>
                        </div>
                    </div>

                    <!-- Split Container -->
                    <div class="row g-0 flex-grow-1" id="editorContainer" style="min-height: 680px;">
                        <!-- Markdown Textarea Panel -->
                        <div class="col-md-6 border-end border-secondary border-opacity-25 d-flex flex-column" id="writePanel">
                            <div class="p-2 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                <span class="fs-9 font-mono text-muted text-uppercase"><i class="bi bi-markdown me-1 text-primary"></i> Markdown Source</span>
                                <span class="fs-9 font-mono text-muted" id="charCount">0 characters</span>
                            </div>
                            <textarea asp-for="ContentMarkdown" id="markdownInput" class="form-control bg-dark text-light border-0 rounded-0 flex-grow-1 font-mono fs-8 p-3" style="resize: none; outline: none; box-shadow: none; line-height: 1.6;" placeholder="# Policy Title&#10;&#10;Write policy terms here using standard Markdown...&#10;&#10;## 1. Introduction&#10;Explain terms in plain, natural English." oninput="handleMarkdownInput()"></textarea>
                        </div>

                        <!-- Rendered Preview Panel -->
                        <div class="col-md-6 bg-dark bg-opacity-25 d-flex flex-column" id="previewPanel">
                            <div class="p-2 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                <span class="fs-9 font-mono text-muted text-uppercase"><i class="bi bi-eye me-1 text-info"></i> Rendered Output</span>
                                <span class="badge bg-success bg-opacity-25 text-success fs-9"><i class="bi bi-shield-check me-1"></i> Safe Render</span>
                            </div>
                            <div class="p-4 flex-grow-1 overflow-auto text-light policy-rendered-preview" id="previewContainer" style="max-height: 680px;">
                                <div class="text-muted text-center py-5">
                                    <i class="bi bi-markdown text-secondary fs-1 d-block mb-2"></i>
                                    Markdown live preview will appear here as you write.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
.policy-rendered-preview h1 { font-size: 1.6rem; font-weight: 700; color: #fff; margin-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem; }
.policy-rendered-preview h2 { font-size: 1.25rem; font-weight: 700; color: #60a5fa; margin-top: 1.5rem; margin-bottom: 0.75rem; }
.policy-rendered-preview h3 { font-size: 1.05rem; font-weight: 600; color: #93c5fd; margin-top: 1.25rem; margin-bottom: 0.5rem; }
.policy-rendered-preview p { color: #cbd5e1; font-size: 0.88rem; line-height: 1.7; margin-bottom: 1rem; }
.policy-rendered-preview ul, .policy-rendered-preview ol { color: #cbd5e1; font-size: 0.88rem; line-height: 1.7; margin-bottom: 1rem; padding-left: 1.5rem; }
.policy-rendered-preview blockquote { border-left: 4px solid #3b82f6; padding-left: 1rem; color: #94a3b8; font-style: italic; margin-bottom: 1rem; }
.policy-rendered-preview hr { border-color: rgba(255,255,255,0.15); margin: 1.5rem 0; }
.policy-rendered-preview table { width: 100%; margin-bottom: 1rem; border-collapse: collapse; }
.policy-rendered-preview th, .policy-rendered-preview td { border: 1px solid rgba(255,255,255,0.15); padding: 0.5rem 0.75rem; font-size: 0.85rem; }
.policy-rendered-preview th { background-color: rgba(255,255,255,0.05); }
</style>

@section Scripts {
<script>
    function autoGenerateSlug(title) {
        var slugInput = document.getElementById('policySlug');
        if (!slugInput.dataset.manualEdited) {
            var slug = title.toLowerCase()
                .trim()
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
            slugInput.value = slug;
        }
    }

    document.getElementById('policySlug').addEventListener('input', function() {
        this.dataset.manualEdited = "true";
    });

    function saveAsDraft() {
        document.getElementById('isPublishedSwitch').checked = false;
        document.getElementById('policyForm').submit();
    }

    function insertMarkdown(prefix, suffix) {
        var textarea = document.getElementById('markdownInput');
        var start = textarea.selectionStart;
        var end = textarea.selectionEnd;
        var text = textarea.value;
        var selected = text.substring(start, end);
        var replacement = prefix + selected + suffix;

        textarea.value = text.substring(0, start) + replacement + text.substring(end);
        textarea.focus();
        textarea.selectionStart = start + prefix.length;
        textarea.selectionEnd = start + prefix.length + selected.length;
        handleMarkdownInput();
    }

    function switchView(mode) {
        var write = document.getElementById('writePanel');
        var preview = document.getElementById('previewPanel');

        if (mode === 'split') {
            write.className = 'col-md-6 border-end border-secondary border-opacity-25 d-flex flex-column';
            preview.className = 'col-md-6 bg-dark bg-opacity-25 d-flex flex-column';
            write.style.display = 'flex';
            preview.style.display = 'flex';
        } else if (mode === 'write') {
            write.className = 'col-12 d-flex flex-column';
            write.style.display = 'flex';
            preview.style.display = 'none';
        } else if (mode === 'preview') {
            preview.className = 'col-12 bg-dark bg-opacity-25 d-flex flex-column';
            write.style.display = 'none';
            preview.style.display = 'flex';
            updatePreview();
        }
    }

    var previewTimeout = null;
    function handleMarkdownInput() {
        var val = document.getElementById('markdownInput').value;
        document.getElementById('charCount').innerText = val.length + ' characters';

        clearTimeout(previewTimeout);
        previewTimeout = setTimeout(updatePreview, 300);
    }

    function updatePreview() {
        var markdown = document.getElementById('markdownInput').value;
        if (!markdown.trim()) {
            document.getElementById('previewContainer').innerHTML = '<div class="text-muted text-center py-5"><i class="bi bi-markdown text-secondary fs-1 d-block mb-2"></i>Markdown preview will appear here.</div>';
            return;
        }

        fetch('@Url.Action("PreviewPolicyMarkdown", "PlatformAdmin")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ markdown: markdown })
        })
        .then(res => res.json())
        .then(data => {
            document.getElementById('previewContainer').innerHTML = data.html;
        })
        .catch(err => {
            console.error('Error rendering preview:', err);
        });
    }

    function loadStarterTemplate(type) {
        if (!type) return;
        var textarea = document.getElementById('markdownInput');
        var titleInput = document.getElementById('policyTitle');
        var slugInput = document.getElementById('policySlug');

        var templates = {
            'terms': {
                title: 'Terms and Conditions',
                slug: 'terms-and-conditions',
                content: '# Terms and Conditions\n\n**Effective Date:** 26 October 2026\n\n## 1. Introduction and Service Scope\nThese Terms and Conditions govern access to and use of the SIMS cloud inventory and business management software platform. SIMS is provided strictly as an online software subscription service (SaaS). SIMS does not sell, supply, repair, or warrant physical hardware or equipment.\n\n## 2. Account Registration and Responsibilities\nSubscribers must provide true and accurate business details upon registration. Subscribers are solely responsible for maintaining credential confidentiality and all activities conducted through their administrative and staff accounts.\n\n## 3. Acceptable Use and Data Integrity\nSubscribers agree not to use SIMS for unlawful activities, to store infringing intellectual property, or to transmit malicious code. Subscribers retain sole ownership and responsibility for the legality, accuracy, and GST compliance of all inventory, sales, customer, and supplier records entered.\n\n## 4. Subscription Fees and Renewals\nSubscriptions are billed on a monthly or annual basis. Access is contingent upon timely payment of agreed plan fees.\n\n## 5. Intellectual Property\nAll proprietary software code, user interface designs, and platform documentation are the exclusive property of SIMS.\n\n## 6. Limitation of Liability\nTo the maximum extent permitted under the Indian Contract Act, 1872, SIMS is provided on an "as is" and "as available" basis without warranties of uninterrupted operation.\n\n## 7. Governing Law and Dispute Resolution\nThese Terms are governed by the laws of India. Any legal dispute shall be subject to the exclusive jurisdiction of the competent courts in India.'
            },
            'privacy': {
                title: 'Privacy Policy',
                slug: 'privacy-policy',
                content: '# Privacy Policy\n\n**Effective Date:** 26 October 2026\n\n## 1. Overview\nThis Privacy Policy explains how SIMS collects, processes, and safeguards business subscriber information in compliance with the Information Technology Act, 2000 and the Digital Personal Data Protection Act, 2023 (DPDP Act).\n\n## 2. Information We Collect\nWe collect business registration details, billing contact information, user login credentials, and transactional records necessary for platform authentication and subscription management.\n\n## 3. Purpose of Processing\nInformation is collected solely to administer software licenses, authenticate authorized users, process subscription billing, and provide technical support.\n\n## 4. Data Protection and Confidentiality\nWe implement standard physical and technical security measures to protect stored information against unauthorized access, disclosure, or alteration.\n\n## 5. Subscriber Rights\nSubscribers may request access, correction, or deletion of their account information by contacting our Grievance Redressal desk.\n\n## 6. Grievance Redressal Officer\nIn accordance with Indian statutory rules, queries or complaints regarding personal data may be submitted to our designated Grievance Officer.'
            },
            'refund': {
                title: 'Refund and Cancellation Policy',
                slug: 'refund-policy',
                content: '# Refund and Cancellation Policy\n\n**Effective Date:** 26 October 2026\n\n## 1. Subscription Cancellations\nSubscribers may cancel their SIMS subscription at any time through their administrative billing panel. Cancellation takes effect at the end of the current paid billing cycle.\n\n## 2. Refund Eligibility\nAs SIMS is an instant-access cloud software service, subscription fees are generally non-refundable once service has been provisioned.\n\n## 3. Duplicate or Erroneous Charges\nIf a billing error or duplicate transaction occurs due to payment gateway processing, subscribers must notify support within 7 business days for prompt reconciliation and reversal.\n\n## 4. How to Request Assistance\nSubmit billing inquiries with transaction references to our support team for prompt review.'
            },
            'subscription': {
                title: 'Subscription and Billing Policy',
                slug: 'subscription-policy',
                content: '# Subscription and Billing Policy\n\n**Effective Date:** 26 October 2026\n\n## 1. Subscription Plans and Quantities\nSIMS offers standard tiered plans and custom packages based on configured administrators, staff users, product SKU capacity, and supplier allocations.\n\n## 2. Estimates vs Final Quotations\nAll figures generated by the custom calculator are preliminary estimates. Binding quotations are issued following verification of requirements.\n\n## 3. Billing Cycles and Invoicing\nSubscriptions are billed monthly or annually in advance. Valid GST tax invoices are generated upon payment confirmation.\n\n## 4. Exceeding Package Allocations\nIf business usage exceeds plan limits, subscribers will be notified to upgrade to a higher tier or custom package.'
            },
            'cookie': {
                title: 'Cookie Policy',
                slug: 'cookie-policy',
                content: '# Cookie Policy\n\n**Effective Date:** 26 October 2026\n\n## 1. Use of Cookies\nSIMS uses only strictly necessary first-party session cookies and security tokens required for user authentication, CSRF protection, and session maintenance.\n\n## 2. Third-Party Tracking\nSIMS does not use invasive third-party cross-site behavioral tracking or behavioral advertising cookies on the platform.\n\n## 3. Managing Cookies\nUsers may configure browser settings to decline cookies; however, authentication sessions require essential cookies to operate.'
            },
            'copyright': {
                title: 'Copyright and Intellectual Property Policy',
                slug: 'copyright-policy',
                content: '# Copyright and Intellectual Property Complaint Policy\n\n**Effective Date:** 26 October 2026\n\n## 1. Subscriber Responsibilities\nSubscribers are prohibited from uploading, cataloging, or displaying trademarked or copyrighted assets without appropriate rights or licenses.\n\n## 2. Reporting Infringement under Indian Law\nIn accordance with the Indian Copyright Act, 1957, copyright owners may submit written infringement notices containing identification of the copyrighted work, URL/location in SIMS, and contact information.\n\n## 3. Notice and Review Procedure\nUpon receipt of a verified complaint, SIMS will review the claim and may restrict access to the contested material pending resolution.\n\n## 4. Counter-Notice\nSubscribers who believe material was removed erroneously may submit a written counter-notice establishing their legal authorization.'
            },
            'acceptable-use': {
                title: 'Acceptable Use Policy',
                slug: 'acceptable-use-policy',
                content: '# Acceptable Use Policy\n\n**Effective Date:** 26 October 2026\n\n## 1. Prohibited Activities\nSubscribers may not use SIMS to store or distribute prohibited goods, transmit spam, compromise platform infrastructure, or attempt reverse-engineering of proprietary software code.\n\n## 2. Enforcement and Account Suspension\nViolations of this Acceptable Use Policy may result in formal warning, service suspension, or termination of access.'
            },
            'blank': {
                title: '',
                slug: '',
                content: '# Policy Title\n\n**Effective Date:** 26 October 2026\n\n## 1. Section Title\nPolicy content goes here...'
            }
        };

        var tmpl = templates[type];
        if (tmpl) {
            if (tmpl.title && !titleInput.value) {
                titleInput.value = tmpl.title;
                autoGenerateSlug(tmpl.title);
            }
            textarea.value = tmpl.content;
            handleMarkdownInput();
        }
    }
</script>
}
